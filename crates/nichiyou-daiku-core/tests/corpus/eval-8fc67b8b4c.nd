// Display Shelf
// Overall: 450mm (W) x 140mm (D) x 600mm (H)
// Material: 1x6 only
// Joints: 8x30 dowels
//
// Three shelves (top, middle, bottom) equally spaced between two
// full-height side panels. A short back brace between the bottom and
// middle shelves sets the width along X and stiffens the back.

WIDTH = 450
DEPTH = 140
HEIGHT = 600
BOARD_THICKNESS = 19
SIDE_THICKNESS = BOARD_THICKNESS
SHELF_THICKNESS = BOARD_THICKNESS

SHELF_LENGTH = WIDTH - 2 * SIDE_THICKNESS
SIDE_LENGTH = HEIGHT
SHELF_PITCH = (HEIGHT - SHELF_THICKNESS) / 2
GAP = (HEIGHT - 3 * SHELF_THICKNESS) / 2

// ============================================
// Back brace (first piece: sets X = width)
// Fits between the bottom and middle shelves at the back.
// ============================================
(back_brace:1x6 =GAP)

// ============================================
// Shelves: three 1x6 boards, equal clear spacing
// ============================================
(shelf_bottom:1x6 =SHELF_LENGTH)
(shelf_middle:1x6 =SHELF_LENGTH)
(shelf_top:1x6 =SHELF_LENGTH)

// ============================================
// Side panels: full height, depth = 1x6 width
// ============================================
(side_left:1x6 =SIDE_LENGTH)
(side_right:1x6 =SIDE_LENGTH)

// ============================================
// Back brace to the bottom and middle shelves
// Brace sits at the back edge, centered across the width.
// ============================================
back_brace -[DB<0 FR>((SHELF_LENGTH - DEPTH) / 2) D(:8x30)]- shelf_bottom
back_brace -[TB<0 BR>((SHELF_LENGTH - DEPTH) / 2) D(:8x30)]- shelf_middle

// ============================================
// Shelves to side panels
// Side offset is the shelf underside height above the side bottom:
// bottom 0, middle SHELF_PITCH, top SHELF_PITCH * 2
// ============================================
shelf_bottom -[TL<0 FL<0 D(:8x30)]- side_left
shelf_bottom -[DL<0 BL<0 D(:8x30)]- side_right

shelf_middle -[TL<0 FL<SHELF_PITCH D(:8x30)]- side_left
shelf_middle -[DL<0 BL<SHELF_PITCH D(:8x30)]- side_right

shelf_top -[TL<0 FL<(SHELF_PITCH * 2) D(:8x30)]- side_left
shelf_top -[DL<0 BL<(SHELF_PITCH * 2) D(:8x30)]- side_right

steps {
  "Back brace and bottom shelf": back_brace, shelf_bottom
  "Middle shelf":                shelf_middle
  "Left side":                   side_left
  "Right side":                  side_right
  "Top shelf":                   shelf_top
}
