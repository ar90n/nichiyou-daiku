// Workbench
// Dimensions: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 frame and top; lower shelf 150mm above the floor
// Joints: frame dowelled (8x30), top screwed down (Slim:3.8x65)

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
LEG_W = 89                 // 2x4 width
LEG_T = 38                 // 2x4 thickness
TOP_T = 38                 // 2x4 top board thickness
SHELF_HEIGHT = 150         // lower shelf underside above the floor

LEG_LEN = HEIGHT - TOP_T
APRON_FB = WIDTH - 2 * LEG_W
APRON_LR = DEPTH - 2 * LEG_T
APRON_SIDE_OFFSET = LEG_LEN - LEG_W               // upper side apron, flush with leg tops
APRON_LOWER_FB_OFFSET = LEG_LEN - SHELF_HEIGHT - LEG_W

// ============================================
// Legs (4x): leg_1 front-left, leg_2 front-right
// leg_3 back-left, leg_4 back-right
// ============================================
(leg_1:2x4 =LEG_LEN)
(leg_2:2x4 =LEG_LEN)
(leg_3:2x4 =LEG_LEN)
(leg_4:2x4 =LEG_LEN)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back: WIDTH - 2x89; Left/right: DEPTH - 2x38
// ============================================
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)

// ============================================
// Lower aprons (shelf frame, underside 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, depth direction)
// 13 boards x 89mm = 1157mm, 12 gaps of (1200 - 1157) / 12 = 3.583mm
// ============================================
TOP_N = 13
TOP_GAP = (WIDTH - TOP_N * LEG_W) / (TOP_N - 1)
TOP_OFF_2 = 1 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_3 = 2 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_4 = 3 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_5 = 4 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_6 = 5 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_7 = 6 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_8 = 7 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_9 = 8 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_10 = 9 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_11 = 10 * (LEG_W + TOP_GAP) - LEG_W
TOP_OFF_12 = 11 * (LEG_W + TOP_GAP) - LEG_W

(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Shelf boards (2x4, depth direction), resting on the lower front
// apron between the legs: 11 boards x 89mm = 979mm inside 1022mm,
// 12 gaps of (1022 - 979) / 12 = 3.583mm
// ============================================
SHELF_N = 11
SHELF_GAP = (APRON_FB - SHELF_N * LEG_W) / (SHELF_N + 1)
SHELF_OFF_1 = SHELF_GAP + 0 * (LEG_W + SHELF_GAP)
SHELF_OFF_2 = SHELF_GAP + 1 * (LEG_W + SHELF_GAP)
SHELF_OFF_3 = SHELF_GAP + 2 * (LEG_W + SHELF_GAP)
SHELF_OFF_4 = SHELF_GAP + 3 * (LEG_W + SHELF_GAP)
SHELF_OFF_5 = SHELF_GAP + 4 * (LEG_W + SHELF_GAP)
SHELF_OFF_6 = SHELF_GAP + 5 * (LEG_W + SHELF_GAP)
SHELF_OFF_7 = SHELF_GAP + 6 * (LEG_W + SHELF_GAP)
SHELF_OFF_8 = SHELF_GAP + 7 * (LEG_W + SHELF_GAP)
SHELF_OFF_9 = SHELF_GAP + 8 * (LEG_W + SHELF_GAP)
SHELF_OFF_10 = SHELF_GAP + 9 * (LEG_W + SHELF_GAP)
SHELF_OFF_11 = SHELF_GAP + 10 * (LEG_W + SHELF_GAP)

(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with top, dowelled)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_1 -[BR<APRON_SIDE_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<APRON_SIDE_OFFSET TB<0 D(:8x30)]- apron_upper_left
leg_2 -[BL<APRON_SIDE_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<APRON_SIDE_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (shelf frame, 150mm above the floor, dowelled)
// ============================================
leg_1 -[LB>APRON_LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>APRON_LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_3 -[LB>APRON_LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>APRON_LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<SHELF_HEIGHT DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<SHELF_HEIGHT TB<0 D(:8x30)]- apron_lower_left
leg_2 -[BL<SHELF_HEIGHT DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<SHELF_HEIGHT TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top board connections (screwed down through the board)
// End boards sit on the front legs; middle boards sit on apron_upper_front
// ============================================
leg_1 -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<TOP_OFF_2 BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<TOP_OFF_3 BT<0 S(Slim:3.8x65)]- top_3
apron_upper_front -[RF<TOP_OFF_4 BT<0 S(Slim:3.8x65)]- top_4
apron_upper_front -[RF<TOP_OFF_5 BT<0 S(Slim:3.8x65)]- top_5
apron_upper_front -[RF<TOP_OFF_6 BT<0 S(Slim:3.8x65)]- top_6
apron_upper_front -[RF<TOP_OFF_7 BT<0 S(Slim:3.8x65)]- top_7
apron_upper_front -[RF<TOP_OFF_8 BT<0 S(Slim:3.8x65)]- top_8
apron_upper_front -[RF<TOP_OFF_9 BT<0 S(Slim:3.8x65)]- top_9
apron_upper_front -[RF<TOP_OFF_10 BT<0 S(Slim:3.8x65)]- top_10
apron_upper_front -[RF<TOP_OFF_11 BT<0 S(Slim:3.8x65)]- top_11
apron_upper_front -[RF<TOP_OFF_12 BT<0 S(Slim:3.8x65)]- top_12
leg_2 -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Shelf board connections (dowelled to the lower front apron)
// ============================================
apron_lower_front -[RF<SHELF_OFF_1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFF_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFF_3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFF_4 BT<0 D(:8x30)]- shelf_4
apron_lower_front -[RF<SHELF_OFF_5 BT<0 D(:8x30)]- shelf_5
apron_lower_front -[RF<SHELF_OFF_6 BT<0 D(:8x30)]- shelf_6
apron_lower_front -[RF<SHELF_OFF_7 BT<0 D(:8x30)]- shelf_7
apron_lower_front -[RF<SHELF_OFF_8 BT<0 D(:8x30)]- shelf_8
apron_lower_front -[RF<SHELF_OFF_9 BT<0 D(:8x30)]- shelf_9
apron_lower_front -[RF<SHELF_OFF_10 BT<0 D(:8x30)]- shelf_10
apron_lower_front -[RF<SHELF_OFF_11 BT<0 D(:8x30)]- shelf_11

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
