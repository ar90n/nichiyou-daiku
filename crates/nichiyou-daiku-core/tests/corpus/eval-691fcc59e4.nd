// Two-Tier Shelf
// Dimensions: 600mm (W) x 300mm (D) x 800mm (H)
// Material: 2x4 (frame and lower shelf), 1x4 (top surface)
// Joints: 8x30 dowels
//
// Structure:
// - 4 legs at the corners
// - Upper aprons flush with the leg tops
// - Lower aprons with their bottom edge 150mm above the floor
// - Top surface: 1x4 boards running front to back, over the legs and upper aprons
// - Lower shelf: 2x4 boards running front to back, resting on the lower aprons

// ============================================
// Overall dimensions and derived sizes
// ============================================
WIDTH = 600
DEPTH = 300
HEIGHT = 800
WIDE = 89                 // width of 1x/2x lumber
THICK_2X = 38             // thickness of 2x lumber
TOP_T = 19                // thickness of the 1x4 top boards
LEG_LENGTH = HEIGHT - TOP_T
APRON_FB = WIDTH - 2 * WIDE
APRON_LR = DEPTH - 2 * THICK_2X
LOWER_H = 150             // lower apron bottom above the floor
LOWER_FB_OFFSET = LEG_LENGTH - LOWER_H - WIDE
UPPER_LR_OFFSET = LEG_LENGTH - WIDE

// Top boards: 6 x 89 = 534, gap (600 - 534) / 5 = 13.2
TOP_COUNT = 6
TOP_GAP = (WIDTH - TOP_COUNT * WIDE) / (TOP_COUNT - 1)
TOP_STEP = WIDE + TOP_GAP

// Lower shelf boards: 4 x 89 = 356, 3 gaps of (422 - 356) / 3 = 22
SHELF_COUNT = 4
SHELF_GAP = (APRON_FB - SHELF_COUNT * WIDE) / (SHELF_COUNT - 1)
SHELF_STEP = WIDE + SHELF_GAP

// ============================================
// Legs (4x) - 800mm height minus the 19mm top boards
// leg_1: front-left, leg_2: front-right
// leg_3: back-left, leg_4: back-right
// ============================================
(leg_1:2x4 =LEG_LENGTH)
(leg_2:2x4 =LEG_LENGTH)
(leg_3:2x4 =LEG_LENGTH)
(leg_4:2x4 =LEG_LENGTH)

// ============================================
// Upper Aprons (flush with the top)
// Front/back run between the legs' 89mm sides: 600 - 2*89 = 422mm
// Left/right run between the legs' 38mm sides: 300 - 2*38 = 224mm
// ============================================
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)

// ============================================
// Lower Aprons (bottom edge 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top Surface (1x4, running in the depth direction)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Lower Shelf (2x4, running in the depth direction, on the lower aprons)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with the top)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front

leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_1 -[BR<UPPER_LR_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<UPPER_LR_OFFSET TB<0 D(:8x30)]- apron_upper_left

leg_2 -[BL<UPPER_LR_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<UPPER_LR_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower Apron Connections (bottom edge 150mm above the floor)
// Front/back measured from the leg top: 781 - 150 - 89 = 542mm
// Left/right measured from the leg bottom: 150mm
// ============================================
leg_1 -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front

leg_3 -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<LOWER_H DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_H TB<0 D(:8x30)]- apron_lower_left

leg_2 -[BL<LOWER_H DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_H TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top Surface Connections
// Outer boards sit on the front legs; inner boards on the upper front apron,
// one gap plus one board apart: 13.2, 115.4, 217.6, 319.8
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<(TOP_GAP + TOP_STEP) BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<(TOP_GAP + 2 * TOP_STEP) BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<(TOP_GAP + 3 * TOP_STEP) BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Lower Shelf Connections
// Boards rest on the lower front apron, with three 22mm gaps:
// offsets 0, 111, 222, 333
// ============================================
apron_lower_front -[RF<0 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_STEP BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<(2 * SHELF_STEP) BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<(3 * SHELF_STEP) BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
