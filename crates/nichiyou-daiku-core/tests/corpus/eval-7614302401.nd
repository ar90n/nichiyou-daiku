// Console Table
// Dimensions: 1000mm (W) x 300mm (D) x 800mm (H)
// Material: 2x4 legs and frame, 2x6 top, 2x4 lower shelf
// Joints: Dowel 8x30
//
// Structure:
// - 4 legs at the corners, wide faces forward
// - Upper aprons flush with the leg tops
// - Lower aprons with their bottom edges 150mm above the floor
// - 2x6 top boards running front to back, laid across the width
// - 2x4 shelf boards running front to back, resting on the lower aprons

// ============================================
// Overall dimensions and derived values
// ============================================
WIDTH = 1000
DEPTH = 300
HEIGHT = 800

FRAME_WIDTH = 89
FRAME_THICKNESS = 38
TOP_WIDTH = 140
TOP_THICKNESS = 38

LEG_LENGTH = HEIGHT - TOP_THICKNESS
APRON_FRONT_LENGTH = WIDTH - 2 * FRAME_WIDTH
APRON_SIDE_LENGTH = DEPTH - 2 * FRAME_THICKNESS
APRON_TOP_OFFSET = LEG_LENGTH - FRAME_WIDTH

LOWER_APRON_BOTTOM = 150
LOWER_APRON_OFFSET = LEG_LENGTH - LOWER_APRON_BOTTOM - FRAME_WIDTH

TOP_BOARDS = 7
TOP_GAP = (WIDTH - TOP_BOARDS * TOP_WIDTH) / (TOP_BOARDS - 1)
TOP_STEP = TOP_WIDTH + TOP_GAP
TOP_OFFSET_2 = TOP_STEP - FRAME_WIDTH
TOP_OFFSET_3 = 2 * TOP_STEP - FRAME_WIDTH
TOP_OFFSET_4 = 3 * TOP_STEP - FRAME_WIDTH
TOP_OFFSET_5 = 4 * TOP_STEP - FRAME_WIDTH
TOP_OFFSET_6 = 5 * TOP_STEP - FRAME_WIDTH

SHELF_BOARDS = 9
SHELF_AREA = WIDTH - 2 * FRAME_WIDTH
SHELF_GAP = (SHELF_AREA - SHELF_BOARDS * FRAME_WIDTH) / (SHELF_BOARDS + 1)
SHELF_STEP = FRAME_WIDTH + SHELF_GAP
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = SHELF_GAP + SHELF_STEP
SHELF_OFFSET_3 = SHELF_GAP + 2 * SHELF_STEP
SHELF_OFFSET_4 = SHELF_GAP + 3 * SHELF_STEP
SHELF_OFFSET_5 = SHELF_GAP + 4 * SHELF_STEP
SHELF_OFFSET_6 = SHELF_GAP + 5 * SHELF_STEP
SHELF_OFFSET_7 = SHELF_GAP + 6 * SHELF_STEP
SHELF_OFFSET_8 = SHELF_GAP + 7 * SHELF_STEP
SHELF_OFFSET_9 = SHELF_GAP + 8 * SHELF_STEP

// ============================================
// Legs (4x) - 800mm height minus the 38mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper Aprons (flush with the leg tops)
// Front/back run between the legs' 89mm faces: 1000 - 2*89 = 822mm
// Left/right run between the legs' 38mm faces: 300 - 2*38 = 224mm
// ============================================
(apron_front:2x4 =APRON_FRONT_LENGTH)
(apron_back:2x4 =APRON_FRONT_LENGTH)
(apron_left:2x4 =APRON_SIDE_LENGTH)
(apron_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Lower Aprons (bottom edge 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FRONT_LENGTH)
(apron_lower_back:2x4 =APRON_FRONT_LENGTH)
(apron_lower_left:2x4 =APRON_SIDE_LENGTH)
(apron_lower_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Top Surface (2x6, depth direction)
// 7 boards: 7*140 = 980mm, leaving 6 gaps of (1000 - 980) / 6 = 3.33mm
// ============================================
(top_1:2x6 =DEPTH)
(top_2:2x6 =DEPTH)
(top_3:2x6 =DEPTH)
(top_4:2x6 =DEPTH)
(top_5:2x6 =DEPTH)
(top_6:2x6 =DEPTH)
(top_7:2x6 =DEPTH)

// ============================================
// Shelf boards (2x4, depth direction, on the lower aprons)
// They fit between the legs: 1000 - 2*89 = 822mm
// 9 boards: 9*89 = 801mm, leaving 10 gaps of (822 - 801) / 10 = 2.1mm
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with the top)
// ============================================

// Front upper apron
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// Back upper apron
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Left upper apron (offset 762 - 89 = 673mm up the leg)
leg_fl -[BR<APRON_TOP_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_TOP_OFFSET TB<0 D(:8x30)]- apron_left

// Right upper apron
leg_fr -[BL<APRON_TOP_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_TOP_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Lower Apron Connections (bottom edge 150mm above the floor)
// Front/back measure from the leg top: 762 - 150 - 89 = 523mm
// Left/right measure from the leg bottom: 150mm
// ============================================

// Front lower apron
leg_fl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_front

// Back lower apron
leg_bl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_back

// Left lower apron
leg_fl -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left

// Right lower apron
leg_fr -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top Surface Connections
// Outer boards sit on the front legs
// Middle boards sit on the front upper apron
// ============================================
top_1 -[BD>0 TF>0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_OFFSET_2 BT<0 D(:8x30)]- top_2
apron_front -[RF<TOP_OFFSET_3 BT<0 D(:8x30)]- top_3
apron_front -[RF<TOP_OFFSET_4 BT<0 D(:8x30)]- top_4
apron_front -[RF<TOP_OFFSET_5 BT<0 D(:8x30)]- top_5
apron_front -[RF<TOP_OFFSET_6 BT<0 D(:8x30)]- top_6
top_7 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Shelf Connections
// Boards sit on the front lower apron, between the legs
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFFSET_4 BT<0 D(:8x30)]- shelf_4
apron_lower_front -[RF<SHELF_OFFSET_5 BT<0 D(:8x30)]- shelf_5
apron_lower_front -[RF<SHELF_OFFSET_6 BT<0 D(:8x30)]- shelf_6
apron_lower_front -[RF<SHELF_OFFSET_7 BT<0 D(:8x30)]- shelf_7
apron_lower_front -[RF<SHELF_OFFSET_8 BT<0 D(:8x30)]- shelf_8
apron_lower_front -[RF<SHELF_OFFSET_9 BT<0 D(:8x30)]- shelf_9

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_right, apron_lower_right
  "Join":        apron_front, apron_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7
}
