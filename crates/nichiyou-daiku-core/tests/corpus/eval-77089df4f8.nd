// Two-Tier Shelf
// Dimensions: 600mm (W) x 300mm (D) x 800mm (H)
// Material: 2x4 (structure, lower shelf board), 1x4 (top surface)
// Joints: Dowel 8x30
//
// Structure:
// - 4 legs at corners
// - Upper aprons flush with top of the legs
// - Lower aprons 150mm from bottom
// - Top surface boards (1x4, depth direction) on the legs and upper front apron
// - Lower shelf boards (2x4, depth direction) on the lower front apron, between the legs

WIDTH = 600
DEPTH = 300
HEIGHT = 800
TOP_THICKNESS = 19         // 1x4 top boards
LOWER_APRON_HEIGHT = 150   // underside of lower apron above the floor

// ============================================
// Legs (4x) - height minus the 1x4 top thickness
// leg_1: front-left, leg_2: front-right
// leg_3: back-left, leg_4: back-right
// ============================================
LEG_LENGTH = HEIGHT - TOP_THICKNESS
(leg_1:2x4 =LEG_LENGTH)
(leg_2:2x4 =LEG_LENGTH)
(leg_3:2x4 =LEG_LENGTH)
(leg_4:2x4 =LEG_LENGTH)

// ============================================
// Upper Aprons (flush with top)
// Front/back run between the legs' 89mm sides: WIDTH - 2*89
// Left/right run between the legs' 38mm sides: DEPTH - 2*38
// ============================================
APRON_FB_LENGTH = WIDTH - 2 * 89
APRON_LR_LENGTH = DEPTH - 2 * 38
(apron_upper_front:2x4 =APRON_FB_LENGTH)
(apron_upper_back:2x4 =APRON_FB_LENGTH)
(apron_upper_left:2x4 =APRON_LR_LENGTH)
(apron_upper_right:2x4 =APRON_LR_LENGTH)

// ============================================
// Lower Aprons (150mm from bottom)
// ============================================
(apron_lower_front:2x4 =APRON_FB_LENGTH)
(apron_lower_back:2x4 =APRON_FB_LENGTH)
(apron_lower_left:2x4 =APRON_LR_LENGTH)
(apron_lower_right:2x4 =APRON_LR_LENGTH)

// ============================================
// Top Surface (1x4, depth direction)
// 6 boards: 6*89 = 534mm, leaving 5 gaps of (600 - 534) / 5 = 13.2mm
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Lower shelf boards (2x4, depth direction, on the lower aprons)
// They fit between the legs: APRON_FB_LENGTH inside
// 4 boards: 4*89 = 356mm, leaving 3 gaps of (422 - 356) / 3 = 22mm
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with top, offset >0)
// ============================================

// Front upper apron
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front

// Back upper apron
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Left upper apron (LEG_LENGTH - 89 up the leg)
leg_1 -[BR<(LEG_LENGTH - 89) DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<(LEG_LENGTH - 89) TB<0 D(:8x30)]- apron_upper_left

// Right upper apron
leg_2 -[BL<(LEG_LENGTH - 89) DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<(LEG_LENGTH - 89) TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower Apron Connections (underside 150mm from the floor)
// Front/back measure from the top of the leg: LEG_LENGTH - 150 - 89
// Left/right measure from the bottom: 150mm
// ============================================
LOWER_APRON_TOP_OFFSET = LEG_LENGTH - LOWER_APRON_HEIGHT - 89

// Front lower apron
leg_1 -[LB>LOWER_APRON_TOP_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_APRON_TOP_OFFSET TF>0 D(:8x30)]- apron_lower_front

// Back lower apron
leg_3 -[LB>LOWER_APRON_TOP_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_APRON_TOP_OFFSET TF>0 D(:8x30)]- apron_lower_back

// Left lower apron
leg_1 -[BR<LOWER_APRON_HEIGHT DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_APRON_HEIGHT TB<0 D(:8x30)]- apron_lower_left

// Right lower apron
leg_2 -[BL<LOWER_APRON_HEIGHT DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_APRON_HEIGHT TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top Surface Connections
// End boards sit on the front legs
// Middle boards sit on the upper front apron, one gap + one board apart:
// offsets 13.2, 115.4, 217.6, 319.8 (13.2 + 89 + 13.2 = 115.4, ...)
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<13.2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<115.4 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<217.6 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<319.8 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Lower Shelf Board Connections
// All boards sit on the lower front apron, one gap + one board apart:
// offsets 0, 111, 222, 333 (the last board ends flush at 422mm)
// ============================================
apron_lower_front -[RF<0 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<111 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<222 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<333 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
