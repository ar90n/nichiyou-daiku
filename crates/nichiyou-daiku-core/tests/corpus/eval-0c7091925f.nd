// Kids' Step Stool
// Dimensions: 500mm (W) x 300mm (D) x 300mm (H)
// Material: 2x4 throughout
// Joints: 8x30 dowels for the frame and the boards
//
// Structure:
// - 4 corner legs, 2x4 top platform (5 boards)
// - Upper aprons flush with the leg tops
// - Lower aprons with a lower step (3 boards) on top

WIDTH = 500
DEPTH = 300
HEIGHT = 300
TOP_THICK = 38
LEG_LENGTH = HEIGHT - TOP_THICK

APRON_FRONT_LENGTH = WIDTH - 2 * 89
APRON_SIDE_LENGTH = DEPTH - 2 * 38

// Lower step: board top 160mm above the floor.
// Board underside = apron top = 160 - 38 = 122; apron bottom = 122 - 89 = 33.
LOWER_APRON_BOTTOM = 33
LOWER_APRON_FROM_TOP = LEG_LENGTH - LOWER_APRON_BOTTOM - 89

// Top: 5 boards x 89 = 445, gaps (500 - 445) / 4 = 13.75
TOP_GAP = (WIDTH - 5 * 89) / 4
TOP_OFFSET_2 = TOP_GAP
TOP_OFFSET_3 = TOP_GAP + (89 + TOP_GAP)
TOP_OFFSET_4 = TOP_GAP + 2 * (89 + TOP_GAP)

// Lower step: 3 boards between the legs, 3 x 89 = 267,
// gaps (322 - 267) / 4 = 13.75
SHELF_GAP = (APRON_FRONT_LENGTH - 3 * 89) / 4
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = SHELF_GAP + (89 + SHELF_GAP)
SHELF_OFFSET_3 = SHELF_GAP + 2 * (89 + SHELF_GAP)

// ============================================
// Legs (4x) - 300mm height minus the 38mm top boards
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back between the legs' 89mm faces: 500 - 2*89 = 322
// Left/right between the legs' 38mm faces: 300 - 2*38 = 224
// ============================================
(apron_upper_front:2x4 =APRON_FRONT_LENGTH)
(apron_upper_back:2x4 =APRON_FRONT_LENGTH)
(apron_upper_left:2x4 =APRON_SIDE_LENGTH)
(apron_upper_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Lower aprons (bottom edge 33mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FRONT_LENGTH)
(apron_lower_back:2x4 =APRON_FRONT_LENGTH)
(apron_lower_left:2x4 =APRON_SIDE_LENGTH)
(apron_lower_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Top platform (2x4, depth direction)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Lower step boards (2x4, depth direction, resting on the lower aprons)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_fl -[BR<(LEG_LENGTH - 89) DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<(LEG_LENGTH - 89) TB<0 D(:8x30)]- apron_upper_left
leg_fr -[BL<(LEG_LENGTH - 89) DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<(LEG_LENGTH - 89) TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (bottom edge 33mm above the floor)
// ============================================
leg_fl -[LB>LOWER_APRON_FROM_TOP DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_APRON_FROM_TOP TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_APRON_FROM_TOP DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_APRON_FROM_TOP TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top platform connections
// End boards sit on the front legs; middle boards on the upper front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_OFFSET_4 BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Lower step connections
// Boards rest on the lower front apron, one gap + one board apart
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 D(:8x30)]- shelf_3

// ============================================
// Assembly: side frames, aprons joining them, lower step, top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Lower step":  shelf_1, shelf_2, shelf_3
  "Top":         top_1, top_2, top_3, top_4, top_5
}
