// Two-Tier Shelf
// Overall: 600mm (W) x 300mm (D) x 800mm (H)
// Frame: 2x4, top surface: 1x4 boards running in the depth direction
// Lower shelf: 2x4 boards resting on the lower aprons
// Joints: 8x30 dowels throughout

WIDTH = 600
DEPTH = 300
HEIGHT = 800

BOARD_WIDTH = 89
BOARD_THICKNESS = 38
TOP_THICKNESS = 19
APRON_HEIGHT = 89
LEG_WIDTH = 89
LEG_THICKNESS = 38

// Legs stop under the 19mm top boards
LEG_LENGTH = HEIGHT - TOP_THICKNESS
// Front/back aprons fit between the legs' 89mm faces
UPPER_APRON_LENGTH = WIDTH - 2 * LEG_WIDTH
// Side aprons fit between the legs' 38mm faces
SIDE_APRON_LENGTH = DEPTH - 2 * LEG_THICKNESS

// Lower apron bottom edge 150mm above the floor
LOWER_APRON_BOTTOM = 150
// Front/back lower aprons are positioned from the leg top
LOWER_APRON_OFFSET = LEG_LENGTH - LOWER_APRON_BOTTOM - APRON_HEIGHT
// Upper side aprons are positioned from the leg bottom
UPPER_SIDE_APRON_OFFSET = LEG_LENGTH - APRON_HEIGHT

// Top: 6 x 1x4 boards across the width
TOP_COUNT = 6
TOP_GAP = (WIDTH - TOP_COUNT * BOARD_WIDTH) / (TOP_COUNT - 1)
TOP_OFFSET_2 = TOP_GAP
TOP_OFFSET_3 = TOP_GAP + (BOARD_WIDTH + TOP_GAP)
TOP_OFFSET_4 = TOP_GAP + 2 * (BOARD_WIDTH + TOP_GAP)
TOP_OFFSET_5 = TOP_GAP + 3 * (BOARD_WIDTH + TOP_GAP)

// Lower shelf: 4 x 2x4 boards, flush with the inner faces of both legs
SHELF_COUNT = 4
SHELF_GAP = (UPPER_APRON_LENGTH - SHELF_COUNT * BOARD_WIDTH) / (SHELF_COUNT - 1)
SHELF_OFFSET_2 = BOARD_WIDTH + SHELF_GAP
SHELF_OFFSET_3 = 2 * (BOARD_WIDTH + SHELF_GAP)
SHELF_OFFSET_4 = 3 * (BOARD_WIDTH + SHELF_GAP)

// ============================================
// Legs (4x) - height minus the 19mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper Aprons (flush with the leg tops)
// Front/back: WIDTH - 2*89, left/right: DEPTH - 2*38
// ============================================
(apron_upper_front:2x4 =UPPER_APRON_LENGTH)
(apron_upper_back:2x4 =UPPER_APRON_LENGTH)
(apron_upper_left:2x4 =SIDE_APRON_LENGTH)
(apron_upper_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Lower Aprons (bottom edge 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =UPPER_APRON_LENGTH)
(apron_lower_back:2x4 =UPPER_APRON_LENGTH)
(apron_lower_left:2x4 =SIDE_APRON_LENGTH)
(apron_lower_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Top Surface (1x4, depth direction)
// 6 boards: 6*89 = 534, gaps (600 - 534) / 5 = 13.2
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Lower Shelf Boards (2x4, depth direction)
// 4 boards between the legs: 4*89 = 356
// 3 gaps of (422 - 356) / 3 = 22mm
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with the top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front

leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_fl -[BR<UPPER_SIDE_APRON_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE_APRON_OFFSET TB<0 D(:8x30)]- apron_upper_left

leg_fr -[BL<UPPER_SIDE_APRON_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE_APRON_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower Apron Connections (bottom edge 150mm above the floor)
// Front/back measured from the leg top: LEG_LENGTH - 150 - 89
// Side aprons measured from the leg bottom: 150
// ============================================
leg_fl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_front

leg_bl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left

leg_fr -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top Surface Connections
// End boards sit on the front legs; middle boards on the upper front
// apron, one gap + one board apart.
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_OFFSET_4 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<TOP_OFFSET_5 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Lower Shelf Connections
// Boards rest on the lower front apron, flush at both inner leg faces.
// ============================================
apron_lower_front -[RF<0 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFFSET_4 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: side frames, aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
