// Plant Stand (花台)
// Dimensions: 400mm (W) x 300mm (D) x 700mm (H)
// Material: 2x2 (legs, aprons), 1x4 (top and shelf boards)
// Joints: 8x30 dowels

// ============================================
// Overall sizes
// ============================================
WIDTH = 400
DEPTH = 300
HEIGHT = 700
LEG = 38            // 2x2 width
APRON = 38          // 2x2 apron height
TOP_THICK = 19      // 1x4 thickness
BOARD_WIDTH = 89    // 1x4 width
SHELF_TOP = 200     // shelf surface height above the floor

LEG_LEN = HEIGHT - TOP_THICK        // 681
APRON_FB = WIDTH - 2 * LEG          // 324 (front/back aprons)
APRON_LR = DEPTH - 2 * LEG          // 224 (side aprons)

// Lower (shelf) aprons: the 1x4 shelf rests on them, surface at SHELF_TOP
SHELF_APRON_TOP = SHELF_TOP - TOP_THICK     // 181
LOWER_FB = LEG_LEN - SHELF_APRON_TOP        // 500 (offset down from the leg top)

// The side aprons drop SIDE_DROP below the front/back ones so their dowels
// clear the front/back apron dowels in the 38x38 legs.
SIDE_DROP = 19
UPPER_SIDE = LEG_LEN - APRON - SIDE_DROP        // 624 (side apron bottom)
LOWER_LR = SHELF_APRON_TOP - APRON - SIDE_DROP  // 124 (side apron bottom)

// Top boards: 4 boards over the width, flush with the outer legs
TOP_COUNT = 4
TOP_GAP = (WIDTH - TOP_COUNT * BOARD_WIDTH) / (TOP_COUNT - 1)   // 14.67
TOP_OFF_1 = BOARD_WIDTH + TOP_GAP - LEG     // 65.67 (board nearest leg_fl)
TOP_OFF_2 = TOP_OFF_1 + BOARD_WIDTH + TOP_GAP  // 169.33

// Shelf boards: 3 boards between the legs, a gap at each end
SHELF_COUNT = 3
SHELF_GAP = (APRON_FB - SHELF_COUNT * BOARD_WIDTH) / (SHELF_COUNT + 1)  // 14.25
SHELF_OFF_1 = SHELF_GAP
SHELF_OFF_2 = SHELF_GAP + BOARD_WIDTH + SHELF_GAP
SHELF_OFF_3 = SHELF_OFF_2 + BOARD_WIDTH + SHELF_GAP

// ============================================
// Legs (4x) - 700mm height minus the 19mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x2 =LEG_LEN)
(leg_fr:2x2 =LEG_LEN)
(leg_bl:2x2 =LEG_LEN)
(leg_br:2x2 =LEG_LEN)

// ============================================
// Upper aprons (flush with the leg tops)
// ============================================
(apron_upper_front:2x2 =APRON_FB)
(apron_upper_back:2x2 =APRON_FB)
(apron_upper_left:2x2 =APRON_LR)
(apron_upper_right:2x2 =APRON_LR)

// ============================================
// Lower aprons (shelf level, surface at 200mm)
// ============================================
(apron_lower_front:2x2 =APRON_FB)
(apron_lower_back:2x2 =APRON_FB)
(apron_lower_left:2x2 =APRON_LR)
(apron_lower_right:2x2 =APRON_LR)

// ============================================
// Top surface (1x4, depth direction)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)

// ============================================
// Shelf boards (1x4, depth direction, on the lower aprons)
// ============================================
(shelf_1:1x4 =DEPTH)
(shelf_2:1x4 =DEPTH)
(shelf_3:1x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_fl -[BR<UPPER_SIDE DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE TB<0 D(:8x30)]- apron_upper_left
leg_fr -[BL<UPPER_SIDE DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (shelf level)
// ============================================
leg_fl -[LB>LOWER_FB DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FB TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FB DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FB TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_LR DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_LR TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<LOWER_LR DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_LR TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface connections
// The two outer boards sit on the legs, flush with the outer faces;
// the inner boards sit on the upper front apron.
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fr
apron_upper_front -[RF<TOP_OFF_1 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_OFF_2 BT<0 D(:8x30)]- top_2
top_4 -[BD>0 TF>0 D(:8x30)]- leg_fl

// ============================================
// Shelf connections (boards between the legs on the lower front apron)
// ============================================
apron_lower_front -[RF<SHELF_OFF_1 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFF_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFF_3 BT<0 D(:8x30)]- shelf_1

// ============================================
// Assembly: side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3
  "Top":         top_1, top_2, top_3, top_4
}
