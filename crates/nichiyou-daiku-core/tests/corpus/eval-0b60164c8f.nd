// 1x6 Display Shelf
// Overall: 450mm (W) x 140mm (D) x 600mm (H)
// Material: 1x6 only
// Joints: shelves screwed to the side panels (Slim 3.3x30)

WIDTH = 450
DEPTH = 140
HEIGHT = 600
THICKNESS = 19
SHELF_LENGTH = WIDTH - 2 * THICKNESS
GAP = (HEIGHT - 3 * THICKNESS) / 2
MIDDLE_UNDERSIDE = THICKNESS + GAP

// Side panels (2x): full height, 140mm deep
(side_l:1x6 =HEIGHT)
(side_r:1x6 =HEIGHT)

// Three shelf boards (top, middle, bottom), 450 - 2x19 = 412mm long
(shelf_bottom:1x6 =SHELF_LENGTH)
(shelf_middle:1x6 =SHELF_LENGTH)
(shelf_top:1x6 =SHELF_LENGTH)

// Bottom shelf: underside flush with the floor
shelf_bottom -[DL<0 BL<0 S(Slim:3.3x30)]- side_l
shelf_bottom -[TL<0 FL<0 S(Slim:3.3x30)]- side_r

// Middle shelf: equal clear gaps above and below
shelf_middle -[DL<0 BL<MIDDLE_UNDERSIDE S(Slim:3.3x30)]- side_l
shelf_middle -[TL<0 FL<MIDDLE_UNDERSIDE S(Slim:3.3x30)]- side_r

// Top shelf: top flush with the side panel tops
shelf_top -[DL<0 BL>THICKNESS S(Slim:3.3x30)]- side_l
shelf_top -[TL<0 FL>THICKNESS S(Slim:3.3x30)]- side_r

steps {
  "Left side and shelves": side_l, shelf_bottom, shelf_middle, shelf_top
  "Right side": side_r
}
