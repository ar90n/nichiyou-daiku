// Side Table
// Overall: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4
// Joints: 8x30 dowels throughout

WIDTH = 500
DEPTH = 400
HEIGHT = 600

LEG_LEN = HEIGHT - 38          // legs carry the 38mm 2x4 top
TOP_BOARDS = 5                 // largest n with n * 89 <= WIDTH
TOP_GAP = (WIDTH - TOP_BOARDS * 89) / (TOP_BOARDS - 1)
APRON_UP = LEG_LEN - 89        // side-apron anchor, flush with the leg top

// ============================================
// Legs (4x): 600 - 38 = 562mm
// Wide front faces toward the front, 89mm to the front,
// 38mm to the sides
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Aprons, flush with the leg tops
// Front/back between the legs' 89mm faces: 500 - 2*89 = 322mm
// Left/right between the legs' 38mm faces: 400 - 2*38 = 324mm
// ============================================
(apron_front:2x4 =WIDTH - 2 * 89)
(apron_back:2x4 =WIDTH - 2 * 89)
(apron_left:2x4 =DEPTH - 2 * 38)
(apron_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Top boards (5x), running in the depth direction
// 5 * 89 = 445mm, gap = (500 - 445) / 4 = 13.75mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons into the legs' narrow faces,
// flush with the legs' front faces and tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons into the legs' wide faces,
// tops flush with the legs' tops (562 - 89 = 473 up the leg)
// ============================================
leg_fl -[BR<APRON_UP DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_UP TB<0 D(:8x30)]- apron_left
leg_fr -[BL<APRON_UP DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_UP TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards doweled down onto the frame
// Outer boards sit on the front/back legs,
// inner boards on the front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP * 2 + 89) BT<0 D(:8x30)]- top_3
apron_front -[RF<(TOP_GAP * 3 + 89 * 2) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: side frames, aprons joining them, top last
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
