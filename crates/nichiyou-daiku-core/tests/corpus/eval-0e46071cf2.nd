// Kids Step Stool
// Dimensions: 400mm (W) x 300mm (D) x 300mm (H)
// Material: 2x4
// Joint: Dowel 8x30
// Sturdy four-legged frame with upper and lower aprons

WIDTH = 400
DEPTH = 300
HEIGHT = 300
TOP_THICKNESS = 38
LEG_LENGTH = HEIGHT - TOP_THICKNESS            // 262
APRON_FB = WIDTH - 2 * 89                      // 222
APRON_LR = DEPTH - 2 * 38                      // 224
LOWER_FROM_TOP = LEG_LENGTH - 40 - 89          // 133 (lower apron bottom edge 40mm above floor)
UPPER_SIDE_FROM_BOTTOM = LEG_LENGTH - 89       // 173 (upper side apron flush with leg top)
LOWER_SIDE_FROM_BOTTOM = 40                    // 40 (lower side apron down end, bottom edge at floor+40)
GAP = (WIDTH - 4 * 89) / 3                     // 14.667 (gap between the 4 top boards)

// ============================================
// Legs (4x): 300mm height minus the 38mm top boards
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back run between the legs' 89mm faces: 400 - 2*89 = 222mm
// Left/right run between the legs' 38mm faces: 300 - 2*38 = 224mm
// ============================================
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Lower aprons (bracing, bottom edge 40mm above the floor)
// ============================================
(lower_front:2x4 =APRON_FB)
(lower_back:2x4 =APRON_FB)
(lower_left:2x4 =APRON_LR)
(lower_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, 300mm front to back)
// 4 boards: 4*89 = 356mm, 3 gaps of (400 - 356) / 3 = 14.667mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)

// ============================================
// Upper front/back aprons to the legs (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Upper side aprons to the legs (flush with the leg tops)
// ============================================
leg_fl -[BR<UPPER_SIDE_FROM_BOTTOM DB<0 D(:8x30)]- apron_left
leg_bl -[FR<UPPER_SIDE_FROM_BOTTOM TB<0 D(:8x30)]- apron_left
leg_fr -[BL<UPPER_SIDE_FROM_BOTTOM DF<0 D(:8x30)]- apron_right
leg_br -[FL<UPPER_SIDE_FROM_BOTTOM TF<0 D(:8x30)]- apron_right

// ============================================
// Lower front/back aprons to the legs
// ============================================
leg_fl -[LB>LOWER_FROM_TOP DB>0 D(:8x30)]- lower_front
leg_fr -[RF>LOWER_FROM_TOP TF>0 D(:8x30)]- lower_front
leg_bl -[LB>LOWER_FROM_TOP DB>0 D(:8x30)]- lower_back
leg_br -[RF>LOWER_FROM_TOP TF>0 D(:8x30)]- lower_back

// ============================================
// Lower side aprons to the legs
// ============================================
leg_fl -[BR<LOWER_SIDE_FROM_BOTTOM DB<0 D(:8x30)]- lower_left
leg_bl -[FR<LOWER_SIDE_FROM_BOTTOM TB<0 D(:8x30)]- lower_left
leg_fr -[BL<LOWER_SIDE_FROM_BOTTOM DF<0 D(:8x30)]- lower_right
leg_br -[FL<LOWER_SIDE_FROM_BOTTOM TF<0 D(:8x30)]- lower_right

// ============================================
// Top boards: outer boards on the legs, inner boards on apron_front
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(GAP + 89 + GAP) BT<0 D(:8x30)]- top_3
top_4 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back, lower_front, lower_back, lower_left, lower_right
  "Top":         top_1, top_2, top_3, top_4
}
