// Child's Step Stool
// Width: 300mm, Depth: 250mm, Height: 300mm
// 2x4 frame with 8x30 dowels, 2x4 top boards screwed down with Slim 3.8x65

WIDTH = 300
DEPTH = 250
HEIGHT = 300

TOP_THICKNESS = 38               // 2x4 top board, lying flat
LEG_LENGTH = HEIGHT - TOP_THICKNESS

APRON_FB = WIDTH - 2 * 89        // front/back apron length, between the legs' narrow faces
APRON_LR = DEPTH - 2 * 38        // side apron length, between the legs' wide faces

TOP_GAP = (WIDTH - 3 * 89) / 2   // gap between the 3 top boards (89mm wide each)

// Legs
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// Aprons: frame just below the top surface
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// Top boards (2x4, standing surface)
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)

// Front/back aprons: end into the legs' narrow faces, flush with the legs' front faces
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Side aprons: end into the legs' wide faces, flush with the legs' outer sides
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// Top boards (screwed down through the board): outer boards on the legs, middle board on apron_front
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_front -[RF<TOP_GAP BT<0 S(Slim:3.8x65)]- top_2
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_3

steps {
  "Front legs and apron": leg_fl, leg_fr, apron_front
  "Back legs and apron": leg_bl, leg_br, apron_back
  "Side aprons": apron_left, apron_right
  "Top boards": top_1, top_2, top_3
}
