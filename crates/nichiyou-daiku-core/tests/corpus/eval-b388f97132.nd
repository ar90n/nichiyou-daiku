// Plant Stand (花台)
// Dimensions: 400mm (W) x 300mm (D) x 700mm (H)
// Material: 2x2 (frame), 1x4 (top, shelf)
// Joints: Dowel 8x30
//
// Structure:
// - 4 legs (2x2) at the corners
// - Upper aprons (2x2) flush with the top of the legs
// - Lower aprons (2x2) supporting a shelf 200mm above the floor
// - Top surface (1x4 x4) on the legs and upper front apron
// - Shelf (1x4 x3) on the lower front apron, between the legs

WIDTH = 400
DEPTH = 300
HEIGHT = 700
TOP_THICKNESS = 19     // 1x4 thickness
LEG_SIZE = 38           // 2x2 width/thickness
SHELF_HEIGHT = 200      // shelf height above the floor

LEG_LENGTH = HEIGHT - TOP_THICKNESS

// Aprons: front/back run between the legs' width, left/right between the legs' depth
UPPER_FB_LEN = WIDTH - 2 * LEG_SIZE
UPPER_LR_LEN = DEPTH - 2 * LEG_SIZE
LOWER_FB_LEN = UPPER_FB_LEN
LOWER_LR_LEN = UPPER_LR_LEN

// Upper aprons: flush with the leg tops
UPPER_LR_OFFSET = LEG_LENGTH - LEG_SIZE

// Lower aprons: bottom edge at SHELF_HEIGHT above the floor
LOWER_FB_OFFSET = LEG_LENGTH - SHELF_HEIGHT - LEG_SIZE
LOWER_LR_OFFSET = SHELF_HEIGHT

// Top boards (1x4, depth direction): 4 boards (4*89=356mm), 3 gaps of (400-356)/3
// top_1/top_4 sit on the legs; top_2/top_3 sit on apron_upper_front, whose own
// offset is measured from its end next to leg_fl (the model's far/right edge),
// so the apron-local offset counts down from there, not up from leg_fr's side.
TOP_GAP = (WIDTH - 4 * 89) / 3
TOP_OFFSET_2 = LEG_SIZE + UPPER_FB_LEN - (89 + TOP_GAP) - 89
TOP_OFFSET_3 = LEG_SIZE + UPPER_FB_LEN - 2 * (89 + TOP_GAP) - 89

// Shelf boards (1x4, depth direction): fit inside the lower front apron (324mm)
// 3 boards (3*89=267mm), 4 gaps of (324-267)/4
SHELF_GAP = (LOWER_FB_LEN - 3 * 89) / 4
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = 2 * SHELF_GAP + 89
SHELF_OFFSET_3 = 3 * SHELF_GAP + 178

// ============================================
// Legs (4x) - leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x2 =LEG_LENGTH)
(leg_fr:2x2 =LEG_LENGTH)
(leg_bl:2x2 =LEG_LENGTH)
(leg_br:2x2 =LEG_LENGTH)

// ============================================
// Upper Aprons (flush with top)
// ============================================
(apron_upper_front:2x2 =UPPER_FB_LEN)
(apron_upper_back:2x2 =UPPER_FB_LEN)
(apron_upper_left:2x2 =UPPER_LR_LEN)
(apron_upper_right:2x2 =UPPER_LR_LEN)

// ============================================
// Lower Aprons (shelf support, 200mm from floor)
// ============================================
(apron_lower_front:2x2 =LOWER_FB_LEN)
(apron_lower_back:2x2 =LOWER_FB_LEN)
(apron_lower_left:2x2 =LOWER_LR_LEN)
(apron_lower_right:2x2 =LOWER_LR_LEN)

// ============================================
// Top Surface (1x4, depth direction)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)

// ============================================
// Shelf boards (1x4, depth direction)
// ============================================
(shelf_1:1x4 =DEPTH)
(shelf_2:1x4 =DEPTH)
(shelf_3:1x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Left/right aprons meet the same corner as the front/back aprons on a 2x2 leg,
// too little room for two dowels at the same height: butt joint (glue + the
// top/shelf fastening above hold them in place).
leg_fl -[BR<UPPER_LR_OFFSET DB<0]- apron_upper_left
leg_bl -[FR<UPPER_LR_OFFSET TB<0]- apron_upper_left
leg_fr -[BL<UPPER_LR_OFFSET DF<0]- apron_upper_right
leg_br -[FL<UPPER_LR_OFFSET TF<0]- apron_upper_right

// ============================================
// Lower Apron Connections (shelf support)
// ============================================
leg_fl -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_LR_OFFSET DB<0]- apron_lower_left
leg_bl -[FR<LOWER_LR_OFFSET TB<0]- apron_lower_left
leg_fr -[BL<LOWER_LR_OFFSET DF<0]- apron_lower_right
leg_br -[FL<LOWER_LR_OFFSET TF<0]- apron_lower_right

// ============================================
// Top Surface Connections
// Outer boards sit on the front legs, inner boards on the upper front apron
// ============================================
top_1 -[BD>0 TF>0 D(:8x30)]- leg_fl
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 D(:8x30)]- top_3
top_4 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Shelf Connections
// All boards sit on the lower front apron, between the legs
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 D(:8x30)]- shelf_3

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3
  "Top":         top_1, top_2, top_3, top_4
}
