// Side Table
// Overall size: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4 throughout, frame joined with 8x30 dowels
// Legs: 4, corner inset. Aprons: flush with the leg tops.
// Top: 2x4 boards running in the depth direction.

WIDTH = 500
DEPTH = 400
HEIGHT = 600

// Legs: height minus the top boards' 38mm thickness
LEG_LENGTH = HEIGHT - 38

// Front/back aprons run between the legs' 89mm (front) sides
APRON_FB_LEN = WIDTH - 2 * 89
// Left/right aprons run between the legs' 38mm (side) sides
APRON_SIDE_LEN = DEPTH - 2 * 38

// Top boards: largest n with n*89 <= WIDTH, then even gaps
TOP_COUNT = 5
TOP_GAP = (WIDTH - TOP_COUNT * 89) / (TOP_COUNT - 1)

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons, flush with the leg tops
// ============================================
(apron_front:2x4 =APRON_FB_LEN)
(apron_back:2x4 =APRON_FB_LEN)
(apron_left:2x4 =APRON_SIDE_LEN)
(apron_right:2x4 =APRON_SIDE_LEN)

// ============================================
// Top boards (2x4), running front to back (depth direction)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons to legs, flush with the leg tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left/right aprons to legs, flush with the leg tops
// (point is 89mm below the leg top, so the apron's 89mm height ends at the top)
// ============================================
APRON_SIDE_OFFSET = LEG_LENGTH - 89

leg_fl -[BR<APRON_SIDE_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_SIDE_OFFSET TB<0 D(:8x30)]- apron_left
leg_fr -[BL<APRON_SIDE_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_SIDE_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// End boards sit on the front/back legs, middle boards on apron_front
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP + 89 + TOP_GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(2 * (TOP_GAP + 89) + TOP_GAP) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
