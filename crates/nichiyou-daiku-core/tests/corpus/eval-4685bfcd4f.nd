// Low Table (Coffee Table)
// Overall: 900mm (W) x 450mm (D) x 400mm (H)
// Frame: 2x4 legs and aprons with 8x30 dowels
// Top: 6 x 1x6 boards screwed down with Slim 3.3x45
// Lower shelf: 5 x 1x6 boards at 100mm above the floor, screwed to the lower aprons

// ============================================
// Overall dimensions and derived values
// ============================================
WIDTH = 900
DEPTH = 450
HEIGHT = 400
TOP_THICKNESS = 19
BOARD_WIDTH = 140
LEG_LENGTH = HEIGHT - TOP_THICKNESS

APRON_FRONT_LENGTH = WIDTH - 2 * 89
APRON_SIDE_LENGTH = DEPTH - 2 * 38

// Top boards: 6 x 140 = 840, 7 equal gaps of (900 - 840) / 7 = 8.57
TOP_COUNT = 6
TOP_GAP = (WIDTH - TOP_COUNT * BOARD_WIDTH) / (TOP_COUNT + 1)
TOP_OFFSET_2 = TOP_GAP + (BOARD_WIDTH + TOP_GAP) - 89
TOP_OFFSET_3 = TOP_GAP + 2 * (BOARD_WIDTH + TOP_GAP) - 89
TOP_OFFSET_4 = TOP_GAP + 3 * (BOARD_WIDTH + TOP_GAP) - 89
TOP_OFFSET_5 = TOP_GAP + 4 * (BOARD_WIDTH + TOP_GAP) - 89

// Lower shelf: underside 100mm above the floor, so the lower aprons end there
SHELF_UNDERSIDE = 100
LOWER_APRON_OFFSET = LEG_LENGTH - SHELF_UNDERSIDE

// Shelf boards fit between the legs: 722 - 5 x 140 = 22, 6 equal gaps of 3.67
SHELF_COUNT = 5
SHELF_GAP = (APRON_FRONT_LENGTH - SHELF_COUNT * BOARD_WIDTH) / (SHELF_COUNT + 1)
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = SHELF_GAP + (BOARD_WIDTH + SHELF_GAP)
SHELF_OFFSET_3 = SHELF_GAP + 2 * (BOARD_WIDTH + SHELF_GAP)
SHELF_OFFSET_4 = SHELF_GAP + 3 * (BOARD_WIDTH + SHELF_GAP)
SHELF_OFFSET_5 = SHELF_GAP + 4 * (BOARD_WIDTH + SHELF_GAP)

// ============================================
// Legs (4x) - 400mm height minus the 19mm top boards
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back: 900 - 2 x 89 = 722
// Left/right: 450 - 2 x 38 = 374
// ============================================
(apron_upper_front:2x4 =APRON_FRONT_LENGTH)
(apron_upper_back:2x4 =APRON_FRONT_LENGTH)
(apron_upper_left:2x4 =APRON_SIDE_LENGTH)
(apron_upper_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Lower aprons (top edge at the 100mm shelf underside)
// ============================================
(apron_lower_front:2x4 =APRON_FRONT_LENGTH)
(apron_lower_back:2x4 =APRON_FRONT_LENGTH)
(apron_lower_left:2x4 =APRON_SIDE_LENGTH)
(apron_lower_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Top boards (1x6, running front to back)
// ============================================
(top_1:1x6 =DEPTH)
(top_2:1x6 =DEPTH)
(top_3:1x6 =DEPTH)
(top_4:1x6 =DEPTH)
(top_5:1x6 =DEPTH)
(top_6:1x6 =DEPTH)

// ============================================
// Shelf boards (1x6, running front to back)
// ============================================
(shelf_1:1x6 =DEPTH)
(shelf_2:1x6 =DEPTH)
(shelf_3:1x6 =DEPTH)
(shelf_4:1x6 =DEPTH)
(shelf_5:1x6 =DEPTH)

// ============================================
// Upper front/back aprons into the legs
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// ============================================
// Upper side aprons into the legs
// ============================================
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_upper_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_upper_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_upper_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_upper_right

// ============================================
// Lower front/back aprons (top edge 100mm above the floor)
// ============================================
leg_fl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_back

// ============================================
// Lower side aprons (top edge 100mm above the floor)
// ============================================
leg_fl -[BR>LOWER_APRON_OFFSET DB>0 D(:8x30)]- apron_lower_left
leg_bl -[FR>LOWER_APRON_OFFSET TB>0 D(:8x30)]- apron_lower_left
leg_fr -[BL>LOWER_APRON_OFFSET DF>0 D(:8x30)]- apron_lower_right
leg_br -[FL>LOWER_APRON_OFFSET TF>0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards, screwed down through the board
// Outer boards sit on the front legs, the inner boards on the front apron
// ============================================
leg_fl -[TF<(89 - TOP_GAP) BD>0 S(Slim:3.3x45)]- top_1
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 S(Slim:3.3x45)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 S(Slim:3.3x45)]- top_3
apron_upper_front -[RF<TOP_OFFSET_4 BT<0 S(Slim:3.3x45)]- top_4
apron_upper_front -[RF<TOP_OFFSET_5 BT<0 S(Slim:3.3x45)]- top_5
leg_fr -[TF<TOP_GAP BD<0 S(Slim:3.3x45)]- top_6

// ============================================
// Shelf boards, screwed to the lower front apron
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf_3
apron_lower_front -[RF<SHELF_OFFSET_4 BT<0 S(Slim:3.3x45)]- shelf_4
apron_lower_front -[RF<SHELF_OFFSET_5 BT<0 S(Slim:3.3x45)]- shelf_5

// ============================================
// Assembly: side frames, apron frames, shelf, top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
