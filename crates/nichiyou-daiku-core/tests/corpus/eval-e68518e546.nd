// Workbench
// Dimensions: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 throughout
// Joints: frame and shelf joined with 8x30 dowels; top fixed with Slim 3.8x65 screws

// ============================================
// Overall sizes
// ============================================
WIDTH = 1200
DEPTH = 600
HEIGHT = 850
TOP_T = 38                 // 2x4 top board thickness
LEG_H = HEIGHT - TOP_T     // 812
SHELF_H = 150              // lower apron bottom edge above the floor
APRON = 89                 // 2x4 width, the apron height
N_TOP = 13                 // top boards across the width
N_SHELF = 11               // shelf boards across the inside width
INNER_W = WIDTH - 2 * 89   // clear width between the legs

// Top board gaps: 13 * 89 = 1157, so 12 gaps
GAP_TOP = (WIDTH - N_TOP * 89) / (N_TOP - 1)
// Shelf board gaps, one more gap than boards
GAP_SHELF = (INNER_W - N_SHELF * 89) / (N_SHELF + 1)

// ============================================
// Legs (4x) - full height minus the 2x4 top boards
// leg_1: front-left, leg_2: front-right
// leg_3: back-left,  leg_4: back-right
// ============================================
(leg_1:2x4 =LEG_H)
(leg_2:2x4 =LEG_H)
(leg_3:2x4 =LEG_H)
(leg_4:2x4 =LEG_H)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back run between the legs' 89mm sides: WIDTH - 2*89
// Left/right run between the legs' 38mm sides: DEPTH - 2*38
// ============================================
(apron_upper_front:2x4 =WIDTH - 2 * 89)
(apron_upper_back:2x4 =WIDTH - 2 * 89)
(apron_upper_left:2x4 =DEPTH - 2 * 38)
(apron_upper_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Lower aprons (carry the shelf, bottom edge SHELF_H above the floor)
// ============================================
(apron_lower_front:2x4 =WIDTH - 2 * 89)
(apron_lower_back:2x4 =WIDTH - 2 * 89)
(apron_lower_left:2x4 =DEPTH - 2 * 38)
(apron_lower_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Top boards (2x4, running front to back, DEPTH long)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Shelf boards (2x4, running front to back, DEPTH long)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper apron connections (dowels, flush with the leg tops)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Side aprons measure from the leg bottom: LEG_H - 89
leg_1 -[BR<(LEG_H - 89) DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<(LEG_H - 89) TB<0 D(:8x30)]- apron_upper_left
leg_2 -[BL<(LEG_H - 89) DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<(LEG_H - 89) TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (dowels)
// Front/back measure from the leg top: LEG_H - SHELF_H - 89
// Side aprons measure from the leg bottom: SHELF_H
// ============================================
leg_1 -[LB>(LEG_H - SHELF_H - 89) DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>(LEG_H - SHELF_H - 89) TF>0 D(:8x30)]- apron_lower_front
leg_3 -[LB>(LEG_H - SHELF_H - 89) DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>(LEG_H - SHELF_H - 89) TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<SHELF_H DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<SHELF_H TB<0 D(:8x30)]- apron_lower_left
leg_2 -[BL<SHELF_H DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<SHELF_H TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards (screwed down to the front frame)
// End boards sit on the front legs; the inner boards on the upper front apron,
// one gap plus one board apart: o_k = (k - 1) * (89 + GAP_TOP) - 89
// ============================================
leg_1 -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<(1 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<(2 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_3
apron_upper_front -[RF<(3 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_4
apron_upper_front -[RF<(4 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_5
apron_upper_front -[RF<(5 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_6
apron_upper_front -[RF<(6 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_7
apron_upper_front -[RF<(7 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_8
apron_upper_front -[RF<(8 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_9
apron_upper_front -[RF<(9 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_10
apron_upper_front -[RF<(10 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_11
apron_upper_front -[RF<(11 * (89 + GAP_TOP) - 89) BT<0 S(Slim:3.8x65)]- top_12
leg_2 -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Shelf boards (dowelled to the lower front apron)
// One gap before the first board, gaps and boards alternating:
// o_k = GAP_SHELF + (k - 1) * (89 + GAP_SHELF)
// ============================================
apron_lower_front -[RF<(GAP_SHELF + 0 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<(GAP_SHELF + 1 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<(GAP_SHELF + 2 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<(GAP_SHELF + 3 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_4
apron_lower_front -[RF<(GAP_SHELF + 4 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_5
apron_lower_front -[RF<(GAP_SHELF + 5 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_6
apron_lower_front -[RF<(GAP_SHELF + 6 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_7
apron_lower_front -[RF<(GAP_SHELF + 7 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_8
apron_lower_front -[RF<(GAP_SHELF + 8 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_9
apron_lower_front -[RF<(GAP_SHELF + 9 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_10
apron_lower_front -[RF<(GAP_SHELF + 10 * (89 + GAP_SHELF)) BT<0 D(:8x30)]- shelf_11

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
