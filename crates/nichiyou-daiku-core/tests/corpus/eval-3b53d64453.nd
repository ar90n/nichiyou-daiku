// Side Table
// Dimensions: WIDTH x DEPTH x HEIGHT = 500 x 400 x 600 mm
// Material: all 2x4
// Joints: dowels 8x30 (holes phi8 x 15 deep in each piece)

// ============================================
// Variables (overall size drives everything else)
// LEG_W: the leg's wide side (89) faces the front and back
// LEG_T: the leg's narrow side (38) faces left and right
// ============================================
WIDTH = 500
DEPTH = 400
HEIGHT = 600
LEG_W = 89
LEG_T = 38
TOP_T = 38

// Top boards across the width: n = largest n with n * 89 <= WIDTH
TOP_N = 5
GAP = (WIDTH - TOP_N * LEG_W) / (TOP_N - 1)     // (500 - 445) / 4 = 13.75

// ============================================
// Legs (4x) - HEIGHT minus the 38mm 2x4 top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =HEIGHT - TOP_T)
(leg_fr:2x4 =HEIGHT - TOP_T)
(leg_bl:2x4 =HEIGHT - TOP_T)
(leg_br:2x4 =HEIGHT - TOP_T)

// ============================================
// Aprons - flush with the leg tops, standing 89mm tall between the legs
// Front/back run between the legs' wide faces: WIDTH - 2 * LEG_W = 322mm
// Left/right run between the legs' narrow faces: DEPTH - 2 * LEG_T = 324mm
// ============================================
(apron_front:2x4 =WIDTH - 2 * LEG_W)
(apron_back:2x4 =WIDTH - 2 * LEG_W)
(apron_left:2x4 =DEPTH - 2 * LEG_T)
(apron_right:2x4 =DEPTH - 2 * LEG_T)

// ============================================
// Top boards - 2x4 laid along the depth direction
// 5 boards of 89mm: 445mm, 4 gaps of (500 - 445) / 4 = 13.75mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs, flush with the leg tops
// legs use different anchors at the two ends of the apron
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons to legs, flush with the leg tops:
// anchor point =HEIGHT - TOP_T - LEG_W = 473mm up the leg
// ============================================
leg_fl -[BR<(HEIGHT - TOP_T - LEG_W) DB<0 D(:8x30)]- apron_left
leg_bl -[FR<(HEIGHT - TOP_T - LEG_W) TB<0 D(:8x30)]- apron_left
leg_fr -[BL<(HEIGHT - TOP_T - LEG_W) DF<0 D(:8x30)]- apron_right
leg_br -[FL<(HEIGHT - TOP_T - LEG_W) TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame (dowels through the board bottoms)
// Outer boards sit on the leg tops; middle boards sit on the front apron:
// offsets 13.75, 89 + 2*13.75 = 116.5, 178 + 3*13.75 = 219.25
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(LEG_W + 2 * GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(2 * LEG_W + 3 * GAP) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
