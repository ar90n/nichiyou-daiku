// TV Stand
// Dimensions: 1200mm (W) x 350mm (D) x 400mm (H)
// Material: 2x4 (legs, aprons), 2x6 (top, middle shelf)
// Joints: Dowel 8x30 (frame), Screw Slim:3.3x45 (boards)
//
// Structure:
// - 6 legs (2x4): left, center, right pairs (front/back), for support over the 1200mm span
// - Upper aprons flush with the leg tops, split at the center leg (left-center / center-right)
// - Lower aprons supporting the middle shelf, 150mm (shelf underside) from the floor
// - Top surface (2x6 boards) on the legs and upper front aprons
// - Middle shelf (2x6 boards) between the legs, on the lower front aprons

// ============================================
// Overall dimensions and derived values
// ============================================
WIDTH = 1200
DEPTH = 350
HEIGHT = 400
TOP_THICK = 38                              // 2x6 thickness

LEG_LEN = HEIGHT - TOP_THICK                 // 400 - 38 = 362

// Front/back apron segments: width minus 3 legs' worth (89 each), split into 2 gaps
FRONT_APRON_LEN = (WIDTH - 3 * 89) / 2        // (1200 - 267) / 2 = 466.5
// Side/center apron (depth direction): depth minus 2 legs' thickness
SIDE_APRON_LEN = DEPTH - 2 * 38               // 350 - 76 = 274

// Middle shelf underside height above the floor (shelf rests on top of the lower apron)
SHELF_BOTTOM = 150
// Lower apron's own bottom height above the floor
LOWER_APRON_BOTTOM = SHELF_BOTTOM - 89        // 150 - 89 = 61
// Front/back lower-apron offset (measured from the leg top)
LOWER_FB_OFFSET = LEG_LEN - SHELF_BOTTOM      // 362 - 150 = 212

// Center/right leg world x positions (left/right edges), for placing top boards
LEG_FC_LEFT = WIDTH / 2 - 44.5                // 555.5
LEG_FC_RIGHT = WIDTH / 2 + 44.5               // 644.5
LEG_FR_LEFT = WIDTH - 89                      // 1111

// Top boards: 8 x 2x6 (140mm wide) across the width, flush at both ends
TOP_UNIT = (WIDTH - 140) / 7                  // left-edge spacing, 151.43

// Shelf boards: 3 per side, fit between legs on each front_apron segment
SHELF_GAP = (FRONT_APRON_LEN - 3 * 140) / 4   // 11.625

// ============================================
// Legs (6x) - leg length = height minus top board thickness
// fl/fc/fr: front-left, front-center, front-right
// bl/bc/br: back-left, back-center, back-right
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fc:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_bc:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Upper aprons (flush with leg tops)
// Front/back split into left-center and center-right segments
// ============================================
(apron_front_lc:2x4 =FRONT_APRON_LEN)
(apron_front_cr:2x4 =FRONT_APRON_LEN)
(apron_back_lc:2x4 =FRONT_APRON_LEN)
(apron_back_cr:2x4 =FRONT_APRON_LEN)
(apron_left:2x4 =SIDE_APRON_LEN)
(apron_center:2x4 =SIDE_APRON_LEN)
(apron_right:2x4 =SIDE_APRON_LEN)

// ============================================
// Lower aprons (shelf underside 150mm above the floor)
// ============================================
(apron_lower_front_lc:2x4 =FRONT_APRON_LEN)
(apron_lower_front_cr:2x4 =FRONT_APRON_LEN)
(apron_lower_back_lc:2x4 =FRONT_APRON_LEN)
(apron_lower_back_cr:2x4 =FRONT_APRON_LEN)
(apron_lower_left:2x4 =SIDE_APRON_LEN)
(apron_lower_center:2x4 =SIDE_APRON_LEN)
(apron_lower_right:2x4 =SIDE_APRON_LEN)

// ============================================
// Top surface (2x6, depth direction, 8 boards across the width)
// ============================================
(top_1:2x6 =DEPTH)
(top_2:2x6 =DEPTH)
(top_3:2x6 =DEPTH)
(top_4:2x6 =DEPTH)
(top_5:2x6 =DEPTH)
(top_6:2x6 =DEPTH)
(top_7:2x6 =DEPTH)
(top_8:2x6 =DEPTH)

// ============================================
// Middle shelf (2x6, depth direction, 3 boards per side between the legs)
// ============================================
(shelf_1:2x6 =DEPTH)
(shelf_2:2x6 =DEPTH)
(shelf_3:2x6 =DEPTH)
(shelf_4:2x6 =DEPTH)
(shelf_5:2x6 =DEPTH)
(shelf_6:2x6 =DEPTH)

// ============================================
// Upper apron connections (flush with top, offset >0)
// ============================================

// Front upper apron (left-center / center-right)
leg_fl -[RF>0 TF>0 D(:8x30)]- apron_front_lc
leg_fc -[LB>0 DB>0 D(:8x30)]- apron_front_lc
leg_fc -[RF>0 TF>0 D(:8x30)]- apron_front_cr
leg_fr -[LB>0 DB>0 D(:8x30)]- apron_front_cr

// Back upper apron (left-center / center-right)
leg_bl -[RF>0 TF>0 D(:8x30)]- apron_back_lc
leg_bc -[LB>0 DB>0 D(:8x30)]- apron_back_lc
leg_bc -[RF>0 TF>0 D(:8x30)]- apron_back_cr
leg_br -[LB>0 DB>0 D(:8x30)]- apron_back_cr

// Side/center upper aprons
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fc -[BR>0 DB>0 D(:8x30)]- apron_center
leg_bc -[FR>0 TB>0 D(:8x30)]- apron_center
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Lower apron connections (shelf underside 150mm above the floor)
// ============================================

// Front lower apron
leg_fl -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front_lc
leg_fc -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front_lc
leg_fc -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front_cr
leg_fr -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front_cr

// Back lower apron
leg_bl -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back_lc
leg_bc -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back_lc
leg_bc -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back_cr
leg_br -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back_cr

// Side/center lower aprons
leg_fl -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left
leg_fc -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_center
leg_bc -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_center
leg_fr -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface connections
// top_1 flush on leg_fl, top_4/top_5 flush on the two sides of leg_fc,
// top_8 flush on leg_fr; the rest attach to the upper front aprons they lie over
// (apron_front_lc/cr measure their offset from their high-x end)
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.3x45)]- top_1
apron_front_lc -[RF<(LEG_FC_LEFT - 140 - TOP_UNIT) BT<0 S(Slim:3.3x45)]- top_2
apron_front_lc -[RF<(LEG_FC_LEFT - 140 - 2 * TOP_UNIT) BT<0 S(Slim:3.3x45)]- top_3
leg_fc -[TF>(LEG_FC_RIGHT - 140 - 3 * TOP_UNIT) BD>0 S(Slim:3.3x45)]- top_4
leg_fc -[TF<(4 * TOP_UNIT - LEG_FC_LEFT) BD<0 S(Slim:3.3x45)]- top_5
apron_front_cr -[RF<(LEG_FR_LEFT - 140 - 5 * TOP_UNIT) BT<0 S(Slim:3.3x45)]- top_6
apron_front_cr -[RF<(LEG_FR_LEFT - 140 - 6 * TOP_UNIT) BT<0 S(Slim:3.3x45)]- top_7
leg_fr -[TF>0 BD>0 S(Slim:3.3x45)]- top_8

// ============================================
// Middle shelf connections
// 3 boards per side, resting on the lower front aprons, between the legs
// ============================================
apron_lower_front_lc -[RF<SHELF_GAP BT<0 S(Slim:3.3x45)]- shelf_1
apron_lower_front_lc -[RF<(2 * SHELF_GAP + 140) BT<0 S(Slim:3.3x45)]- shelf_2
apron_lower_front_lc -[RF<(3 * SHELF_GAP + 280) BT<0 S(Slim:3.3x45)]- shelf_3
apron_lower_front_cr -[RF<SHELF_GAP BT<0 S(Slim:3.3x45)]- shelf_4
apron_lower_front_cr -[RF<(2 * SHELF_GAP + 140) BT<0 S(Slim:3.3x45)]- shelf_5
apron_lower_front_cr -[RF<(3 * SHELF_GAP + 280) BT<0 S(Slim:3.3x45)]- shelf_6

// ============================================
// Assembly: three leg-pair frames, joined front/back, then shelf and top
// ============================================
steps {
  "Left frame":   leg_fl, leg_bl, apron_left, apron_lower_left
  "Center frame": leg_fc, leg_bc, apron_center, apron_lower_center
  "Right frame":  leg_fr, leg_br, apron_right, apron_lower_right
  "Join":         apron_front_lc, apron_front_cr, apron_back_lc, apron_back_cr, apron_lower_front_lc, apron_lower_front_cr, apron_lower_back_lc, apron_lower_back_cr
  "Shelf":        shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6
  "Top":          top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8
}
