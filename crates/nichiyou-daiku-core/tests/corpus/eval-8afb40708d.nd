// 3-Tier Shoe Rack
// Width: 600mm, Depth: 300mm, Height: 500mm
// 2x2 frame (legs + front/back rails per tier) joined with 8x30 dowels,
// 1x4 shelf boards resting on the rails, screwed with Slim 3.3x45, equally spaced tiers

WIDTH = 600
DEPTH = 300
HEIGHT = 500
LEG_W = 38      // 2x2 width/thickness
BOARD_T = 19    // 1x4 thickness
BOARD_W = 89    // 1x4 width

// Legs run floor to just under the top shelf boards (top boards add BOARD_T to reach HEIGHT)
LEG_LEN = HEIGHT - BOARD_T
// Front/back rails span between the legs' inner faces
RAIL_LEN = WIDTH - 2 * LEG_W
// Left/right rails close the frame ring at each tier, tying front to back
SIDE_RAIL_LEN = DEPTH - 2 * LEG_W

// Rail "bottom edge height above floor" for each tier, equally spaced: 0, mid, flush-with-leg-top
H_TOP = LEG_LEN - LEG_W
H_BOTTOM = 0
H_MID = H_TOP / 2

// Leg-anchor offsets (leg_length - h - LEG_W), per tier
OFFSET_BOTTOM = LEG_LEN - H_BOTTOM - LEG_W
OFFSET_MID = LEG_LEN - H_MID - LEG_W
OFFSET_TOP = LEG_LEN - H_TOP - LEG_W

// Side rails are staggered 15mm from the front/back rails at each tier so their
// corner dowel holes (drilled into the same leg from adjacent faces) do not collide
STAGGER = 15
SIDE_OFFSET_BOTTOM = OFFSET_BOTTOM - STAGGER
SIDE_OFFSET_MID = OFFSET_MID - STAGGER
SIDE_OFFSET_TOP = OFFSET_TOP + STAGGER

// Shelf boards sit between the legs (not over them) on every tier: 5 boards of 89mm
// across RAIL_LEN, gaps on both ends and between boards
GAP = (RAIL_LEN - 5 * BOARD_W) / 6
BOARD_OFFSET_1 = GAP
BOARD_OFFSET_2 = BOARD_OFFSET_1 + (BOARD_W + GAP)
BOARD_OFFSET_3 = BOARD_OFFSET_2 + (BOARD_W + GAP)
BOARD_OFFSET_4 = BOARD_OFFSET_3 + (BOARD_W + GAP)
BOARD_OFFSET_5 = BOARD_OFFSET_4 + (BOARD_W + GAP)

// Legs
(leg_fl:2x2 =LEG_LEN)
(leg_fr:2x2 =LEG_LEN)
(leg_bl:2x2 =LEG_LEN)
(leg_br:2x2 =LEG_LEN)

// Rails: bottom tier
(apron_front_1:2x2 =RAIL_LEN)
(apron_back_1:2x2 =RAIL_LEN)
(apron_left_1:2x2 =SIDE_RAIL_LEN)
(apron_right_1:2x2 =SIDE_RAIL_LEN)
// Rails: middle tier
(apron_front_2:2x2 =RAIL_LEN)
(apron_back_2:2x2 =RAIL_LEN)
(apron_left_2:2x2 =SIDE_RAIL_LEN)
(apron_right_2:2x2 =SIDE_RAIL_LEN)
// Rails: top tier
(apron_front_3:2x2 =RAIL_LEN)
(apron_back_3:2x2 =RAIL_LEN)
(apron_left_3:2x2 =SIDE_RAIL_LEN)
(apron_right_3:2x2 =SIDE_RAIL_LEN)

// Shelf boards: bottom tier
(shelf1_1:1x4 =DEPTH)
(shelf1_2:1x4 =DEPTH)
(shelf1_3:1x4 =DEPTH)
(shelf1_4:1x4 =DEPTH)
(shelf1_5:1x4 =DEPTH)
// Shelf boards: middle tier
(shelf2_1:1x4 =DEPTH)
(shelf2_2:1x4 =DEPTH)
(shelf2_3:1x4 =DEPTH)
(shelf2_4:1x4 =DEPTH)
(shelf2_5:1x4 =DEPTH)
// Shelf boards: top tier
(shelf3_1:1x4 =DEPTH)
(shelf3_2:1x4 =DEPTH)
(shelf3_3:1x4 =DEPTH)
(shelf3_4:1x4 =DEPTH)
(shelf3_5:1x4 =DEPTH)

// Legs to bottom rails (front/back + sides, closing the ring)
leg_fl -[LB>OFFSET_BOTTOM DB>0 D(:8x30)]- apron_front_1
leg_fr -[RF>OFFSET_BOTTOM TF>0 D(:8x30)]- apron_front_1
leg_bl -[LB>OFFSET_BOTTOM DB>0 D(:8x30)]- apron_back_1
leg_br -[RF>OFFSET_BOTTOM TF>0 D(:8x30)]- apron_back_1
leg_fl -[BR>SIDE_OFFSET_BOTTOM DB>0 D(:8x30)]- apron_left_1
leg_bl -[FR>SIDE_OFFSET_BOTTOM TB>0 D(:8x30)]- apron_left_1
leg_fr -[BL>SIDE_OFFSET_BOTTOM DF>0 D(:8x30)]- apron_right_1
leg_br -[FL>SIDE_OFFSET_BOTTOM TF>0 D(:8x30)]- apron_right_1

// Legs to middle rails (front/back + sides, closing the ring)
leg_fl -[LB>OFFSET_MID DB>0 D(:8x30)]- apron_front_2
leg_fr -[RF>OFFSET_MID TF>0 D(:8x30)]- apron_front_2
leg_bl -[LB>OFFSET_MID DB>0 D(:8x30)]- apron_back_2
leg_br -[RF>OFFSET_MID TF>0 D(:8x30)]- apron_back_2
leg_fl -[BR>SIDE_OFFSET_MID DB>0 D(:8x30)]- apron_left_2
leg_bl -[FR>SIDE_OFFSET_MID TB>0 D(:8x30)]- apron_left_2
leg_fr -[BL>SIDE_OFFSET_MID DF>0 D(:8x30)]- apron_right_2
leg_br -[FL>SIDE_OFFSET_MID TF>0 D(:8x30)]- apron_right_2

// Legs to top rails (front/back + sides, closing the ring)
leg_fl -[LB>OFFSET_TOP DB>0 D(:8x30)]- apron_front_3
leg_fr -[RF>OFFSET_TOP TF>0 D(:8x30)]- apron_front_3
leg_bl -[LB>OFFSET_TOP DB>0 D(:8x30)]- apron_back_3
leg_br -[RF>OFFSET_TOP TF>0 D(:8x30)]- apron_back_3
leg_fl -[BR>SIDE_OFFSET_TOP DB>0 D(:8x30)]- apron_left_3
leg_bl -[FR>SIDE_OFFSET_TOP TB>0 D(:8x30)]- apron_left_3
leg_fr -[BL>SIDE_OFFSET_TOP DF>0 D(:8x30)]- apron_right_3
leg_br -[FL>SIDE_OFFSET_TOP TF>0 D(:8x30)]- apron_right_3

// Bottom tier shelf boards, resting on apron_front_1
apron_front_1 -[RF<BOARD_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf1_1
apron_front_1 -[RF<BOARD_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf1_2
apron_front_1 -[RF<BOARD_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf1_3
apron_front_1 -[RF<BOARD_OFFSET_4 BT<0 S(Slim:3.3x45)]- shelf1_4
apron_front_1 -[RF<BOARD_OFFSET_5 BT<0 S(Slim:3.3x45)]- shelf1_5

// Middle tier shelf boards, resting on apron_front_2
apron_front_2 -[RF<BOARD_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf2_1
apron_front_2 -[RF<BOARD_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf2_2
apron_front_2 -[RF<BOARD_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf2_3
apron_front_2 -[RF<BOARD_OFFSET_4 BT<0 S(Slim:3.3x45)]- shelf2_4
apron_front_2 -[RF<BOARD_OFFSET_5 BT<0 S(Slim:3.3x45)]- shelf2_5

// Top tier shelf boards, resting on apron_front_3
apron_front_3 -[RF<BOARD_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf3_1
apron_front_3 -[RF<BOARD_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf3_2
apron_front_3 -[RF<BOARD_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf3_3
apron_front_3 -[RF<BOARD_OFFSET_4 BT<0 S(Slim:3.3x45)]- shelf3_4
apron_front_3 -[RF<BOARD_OFFSET_5 BT<0 S(Slim:3.3x45)]- shelf3_5

steps {
  "Legs and bottom rails": leg_fl, leg_fr, leg_bl, leg_br, apron_front_1, apron_back_1, apron_left_1, apron_right_1
  "Bottom shelf boards": shelf1_1, shelf1_2, shelf1_3, shelf1_4, shelf1_5
  "Middle rails": apron_front_2, apron_back_2, apron_left_2, apron_right_2
  "Middle shelf boards": shelf2_1, shelf2_2, shelf2_3, shelf2_4, shelf2_5
  "Top rails": apron_front_3, apron_back_3, apron_left_3, apron_right_3
  "Top shelf boards": shelf3_1, shelf3_2, shelf3_3, shelf3_4, shelf3_5
}
