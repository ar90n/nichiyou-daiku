// Side Table
// Dimensions: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4
// Joint: Dowel 8x30

WIDTH = 500
DEPTH = 400
HEIGHT = 600
LEG_W = 89   // 2x4 wide face
LEG_T = 38   // 2x4 narrow face

// ============================================
// Legs (4x) - height minus the 38mm top boards (top boards run depth-wise, flush with top)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =HEIGHT - LEG_T)
(leg_fr:2x4 =HEIGHT - LEG_T)
(leg_bl:2x4 =HEIGHT - LEG_T)
(leg_br:2x4 =HEIGHT - LEG_T)

// ============================================
// Aprons, flush with the leg tops
// Front/back run between the legs' 89mm sides: 500 - 2*89 = 322mm
// Left/right run between the legs' 38mm sides: 400 - 2*38 = 324mm
// ============================================
(apron_front:2x4 =WIDTH - 2 * LEG_W)
(apron_back:2x4 =WIDTH - 2 * LEG_W)
(apron_left:2x4 =DEPTH - 2 * LEG_T)
(apron_right:2x4 =DEPTH - 2 * LEG_T)

// ============================================
// Top boards - 2x4, laid in the depth direction, 400mm each
// 5 boards: 5*89 = 445mm, leaving 4 gaps of (500 - 445) / 4 = 13.75mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left apron to legs (flush with top: 562 - 89 = 473mm up the leg)
// Side aprons connect to leg's front/back faces
// ============================================
LEG_LEN = HEIGHT - LEG_T
SIDE_APRON_TOP = LEG_LEN - LEG_W
leg_fl -[BR<SIDE_APRON_TOP DB<0 D(:8x30)]- apron_left
leg_bl -[FR<SIDE_APRON_TOP TB<0 D(:8x30)]- apron_left

// ============================================
// Right apron to legs
// ============================================
leg_fr -[BL<SIDE_APRON_TOP DF<0 D(:8x30)]- apron_right
leg_br -[FL<SIDE_APRON_TOP TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// End boards sit on the front/back legs
// Middle boards sit on the front apron, one gap + one board apart:
// gap = (WIDTH - 5*89) / 4 = 13.75; offsets 13.75, 116.5, 219.25
// ============================================
GAP = (WIDTH - 5 * LEG_W) / 4
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(GAP + LEG_W + GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(2 * (GAP + LEG_W) + GAP) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
