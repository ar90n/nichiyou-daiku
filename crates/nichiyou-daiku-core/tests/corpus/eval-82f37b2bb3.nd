// Two-Tier Shelf
// Dimensions: 600mm (W) x 300mm (D) x 800mm (H)
// Material: 2x4 (frame, shelf board), 1x4 (top surface, depth direction)
// Joints: Dowel 8x30
//
// Structure:
// - 4 legs at corners
// - Upper aprons flush with the top of the legs
// - Lower aprons with their bottom edge 150mm above the floor
// - Top surface boards (1x4) on the legs and the upper front apron
// - Lower shelf board (2x4) on the lower front apron, between the legs

WIDTH = 600
DEPTH = 300
HEIGHT = 800
LOWER_APRON_BOTTOM = 150   // height of the lower apron's bottom edge above the floor

LEG_LEN = HEIGHT - 19           // minus the 1x4 top thickness
APRON_FB = WIDTH - 2 * 89       // front/back apron length, between the legs' 89mm sides
APRON_LR = DEPTH - 2 * 38       // left/right apron length, between the legs' 38mm sides

// ============================================
// Legs (4x)
// leg_1: front-left, leg_2: front-right
// leg_3: back-left, leg_4: back-right
// ============================================
(leg_1:2x4 =LEG_LEN)
(leg_2:2x4 =LEG_LEN)
(leg_3:2x4 =LEG_LEN)
(leg_4:2x4 =LEG_LEN)

// ============================================
// Upper Aprons (flush with the leg tops)
// ============================================
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)

// ============================================
// Lower Aprons (bottom edge 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top Surface (1x4, depth direction)
// 6 boards: 6*89 = 534mm, leaving 5 gaps of (600 - 534) / 5 = 13.2mm
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Lower Shelf boards (2x4, depth direction), on the lower front apron
// Fit between the legs over APRON_FB = 422mm
// 4 boards: 4*89 = 356mm, edge to edge with 3 gaps of (422 - 356) / 3 = 22mm
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper Apron Connections (flush with the leg tops)
// ============================================

// Front upper apron
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front

// Back upper apron
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Left upper apron (LEG_LEN - 89 = 692mm up the leg)
leg_1 -[BR<(LEG_LEN - 89) DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<(LEG_LEN - 89) TB<0 D(:8x30)]- apron_upper_left

// Right upper apron
leg_2 -[BL<(LEG_LEN - 89) DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<(LEG_LEN - 89) TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower Apron Connections (bottom edge 150mm above the floor)
// Front/back measured from the top of the leg: LEG_LEN - 150 - 89 = 542mm
// Left/right measured from the bottom: 150mm
// ============================================

// Front lower apron
leg_1 -[LB>(LEG_LEN - LOWER_APRON_BOTTOM - 89) DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>(LEG_LEN - LOWER_APRON_BOTTOM - 89) TF>0 D(:8x30)]- apron_lower_front

// Back lower apron
leg_3 -[LB>(LEG_LEN - LOWER_APRON_BOTTOM - 89) DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>(LEG_LEN - LOWER_APRON_BOTTOM - 89) TF>0 D(:8x30)]- apron_lower_back

// Left lower apron
leg_1 -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left

// Right lower apron
leg_2 -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top Surface Connections
// End boards sit on the front legs.
// Middle boards sit on the upper front apron, one gap + one board apart:
// offsets 13.2, 115.4, 217.6, 319.8
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<13.2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<115.4 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<217.6 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<319.8 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Lower Shelf Connections
// All boards sit on the lower front apron, edge to edge with one gap apart:
// offsets 0, 111, 222, 333 (the last board ends flush at 422mm)
// ============================================
apron_lower_front -[RF<0 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<111 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<222 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<333 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
