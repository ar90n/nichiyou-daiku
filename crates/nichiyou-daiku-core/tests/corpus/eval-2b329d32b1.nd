// Side Table
// Overall: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4
// Joint: 8x30 dowels

WIDTH = 500
DEPTH = 400
HEIGHT = 600
TOP_T = 38
LEG_W = 89
LEG_T = 38

LEG_LEN = HEIGHT - TOP_T
APRON_FB_LEN = WIDTH - 2 * LEG_W
APRON_SIDE_LEN = DEPTH - 2 * LEG_T
APRON_DROP = LEG_LEN - LEG_W
TOP_N = 5
TOP_GAP = (WIDTH - TOP_N * LEG_W) / (TOP_N - 1)

// ============================================
// Legs: 4x, height minus the 2x4 top boards
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Aprons: flush with the leg tops
// ============================================
(apron_front:2x4 =APRON_FB_LEN)
(apron_back:2x4 =APRON_FB_LEN)
(apron_left:2x4 =APRON_SIDE_LEN)
(apron_right:2x4 =APRON_SIDE_LEN)

// ============================================
// Top boards: 2x4 running front-to-back (depth)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// Front apron to legs
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// Back apron to legs
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Left apron to legs
leg_fl -[BR<APRON_DROP DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_DROP TB<0 D(:8x30)]- apron_left

// Right apron to legs
leg_fr -[BL<APRON_DROP DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_DROP TF<0 D(:8x30)]- apron_right

// Top boards: outer boards over the legs, inner boards on the front apron
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP + LEG_W + TOP_GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(TOP_GAP + 2 * (LEG_W + TOP_GAP)) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
