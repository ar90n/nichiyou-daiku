// Side Table
// Overall: 500 (W) x 400 (D) x 600 (H)
// Material: 2x4
// Joint: dowel 8x30
// Legs show 89mm to the front and 38mm to the sides; aprons flush with the leg tops.

WIDTH = 500
DEPTH = 400
HEIGHT = 600

TOP_THICKNESS = 38              // 2x4
LEG_LENGTH = HEIGHT - TOP_THICKNESS
APRON_WIDTH = WIDTH - 2 * 89    // front/back aprons, between the legs' 89mm faces
APRON_DEPTH = DEPTH - 2 * 38    // side aprons, between the legs' 38mm faces

N_BOARDS = 5
BOARD_WIDTH = 89
GAP = (WIDTH - N_BOARDS * BOARD_WIDTH) / (N_BOARDS - 1)   // 13.75

// ============================================
// Legs (4x) - height minus the 38mm top boards
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons - flush with the leg tops
// ============================================
(apron_front:2x4 =APRON_WIDTH)
(apron_back:2x4 =APRON_WIDTH)
(apron_left:2x4 =APRON_DEPTH)
(apron_right:2x4 =APRON_DEPTH)

// ============================================
// Top boards - 2x4 running front to back
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons into the legs' narrow faces, flush with the tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons into the legs' wide faces, 89mm below the tops
// ============================================
leg_fl -[BR<(LEG_LENGTH - 89) DB<0 D(:8x30)]- apron_left
leg_bl -[FR<(LEG_LENGTH - 89) TB<0 D(:8x30)]- apron_left
leg_fr -[BL<(LEG_LENGTH - 89) DF<0 D(:8x30)]- apron_right
leg_br -[FL<(LEG_LENGTH - 89) TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to the frame
// Outer boards sit on the legs, inner boards on apron_front
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(2 * GAP + BOARD_WIDTH) BT<0 D(:8x30)]- top_3
apron_front -[RF<(3 * GAP + 2 * BOARD_WIDTH) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
