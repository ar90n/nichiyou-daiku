// Display Shelf
// Width: 450mm, Depth: 140mm, Height: 600mm
// Material: 1x6 only
// Joints: 8x30 dowels
//
// Two 1x6 side panels, with three 1x6 shelves between them.
// The top and bottom shelves are flush with the side panel ends, and the
// middle shelf is centred so the two clear openings are the same height.

WIDTH = 450
DEPTH = 140
HEIGHT = 600
BOARD = 19
SHELF_LENGTH = WIDTH - 2 * BOARD
MIDDLE_UNDERSIDE = (HEIGHT - BOARD) / 2

// ============================================
// Side panels (1x6, full height)
// The 140mm width runs front to back and the 19mm thickness is the depth
// of the panel across the shelf width.
// ============================================
(side_left:1x6 =HEIGHT)
(side_right:1x6 =HEIGHT)

// ============================================
// Shelves (1x6, between the side panels)
// ============================================
(shelf_bottom:1x6 =SHELF_LENGTH)
(shelf_middle:1x6 =SHELF_LENGTH)
(shelf_top:1x6 =SHELF_LENGTH)

// ============================================
// Shelf Connections
// Bottom shelf underside at the floor
// ============================================
shelf_bottom -[DL<0 BL<0 D(:8x30)]- side_left
shelf_bottom -[TL<0 FL<0 D(:8x30)]- side_right

// Middle shelf underside at half the clear height
shelf_middle -[DL<0 BL<MIDDLE_UNDERSIDE D(:8x30)]- side_left
shelf_middle -[TL<0 FL<MIDDLE_UNDERSIDE D(:8x30)]- side_right

// Top shelf underside one board thickness below the side panel tops
shelf_top -[DL<0 BL>BOARD D(:8x30)]- side_left
shelf_top -[TL<0 FL>BOARD D(:8x30)]- side_right

// ============================================
// Assembly
// ============================================
steps {
  "Left side":   side_left
  "Right side":  side_right
  "Bottom shelf": shelf_bottom
  "Middle shelf": shelf_middle
  "Top shelf":    shelf_top
}
