// 1x8 本棚
// 幅 600 x 奥行 184 x 高さ 900 mm
// 材: 1x8 のみ（厚さ19、幅184）
// 接合: 棚板と側板は Coarse 3.8x40 ビス、背支持は 8x30 ダボ
//
// 構成:
// - 左右の側板は 1x8 を縦使い（幅184 = 奥行）
// - 棚板4枚（天板・地板を含む）は側板の間に横使い
// - 棚板下面の高さは 0, H2, H3, H4 で等間隔
// - 背支持は地板と2段目の棚板の間に入れ、背面を補強する

WIDTH = 600
DEPTH = 184
HEIGHT = 900
THICK = 19

// 4枚の棚板を等間隔にする（下面の間隔）
SPACING = (HEIGHT - THICK) / 3

// 側板の間に収まる棚板の長さ
SHELF_LEN = WIDTH - 2 * THICK

// 地板上面から2段目の棚板下面までの背支持の長さ
SUPPORT_LEN = SPACING - THICK

H2 = SPACING
H3 = 2 * SPACING
H4 = 3 * SPACING

// ============================================
// 部材
// ============================================

// 背支持（地板と2段目の棚板の間）
(back_support:1x8 =SUPPORT_LEN)

// 棚板4枚（地板・2段目・3段目・天板）
(shelf_1:1x8 =SHELF_LEN)
(shelf_2:1x8 =SHELF_LEN)
(shelf_3:1x8 =SHELF_LEN)
(shelf_4:1x8 =SHELF_LEN)

// 左右の側板
(side_l:1x8 =HEIGHT)
(side_r:1x8 =HEIGHT)

// ============================================
// 背支持: 地板の上面にダボ留め
// ============================================
shelf_1 -[FT<0 DR<0 D(:8x30)]- back_support

// ============================================
// 棚板と左右の側板（側板から棚板端へビス）
// 側板の下から棚板下面の高さで位置を決める
// ============================================
shelf_1 -[DL<0 FL>0 S(Coarse:3.8x40)]- side_l
shelf_1 -[TL<0 BL>0 S(Coarse:3.8x40)]- side_r

shelf_2 -[DL<0 FL>H2 S(Coarse:3.8x40)]- side_l
shelf_2 -[TL<0 BL>H2 S(Coarse:3.8x40)]- side_r

shelf_3 -[DL<0 FL>H3 S(Coarse:3.8x40)]- side_l
shelf_3 -[TL<0 BL>H3 S(Coarse:3.8x40)]- side_r

shelf_4 -[DL<0 FL>H4 S(Coarse:3.8x40)]- side_l
shelf_4 -[TL<0 BL>H4 S(Coarse:3.8x40)]- side_r

// ============================================
// 組立手順
// ============================================
steps {
  "地板と背支持": shelf_1, back_support
  "左側板":       side_l
  "右側板":       side_r
  "2段目の棚板":  shelf_2
  "3段目の棚板":  shelf_3
  "天板":         shelf_4
}
