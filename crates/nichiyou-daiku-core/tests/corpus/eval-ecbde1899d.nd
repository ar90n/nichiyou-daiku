// Workbench
// Width: 1200mm, Depth: 600mm, Height: 850mm
// Lower shelf: bottom edge 150mm above the floor
// 2x4 frame joined with 8x30 dowels; top and shelf boards (2x4) fixed with Slim:3.8x65 screws

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
SHELF_BOTTOM = 150            // lower shelf's bottom edge above the floor

TOP_THICKNESS = 38            // 2x4 top boards

// Legs: height minus the top boards' thickness
LEG_LENGTH = HEIGHT - TOP_THICKNESS

// Front/back aprons: width minus the two legs' width
APRON_FB = WIDTH - 2 * 89
// Left/right aprons: depth minus the two legs' thickness
APRON_LR = DEPTH - 2 * 38

// Lower apron leg offset: leg_length - shelf bottom height - apron width (89)
LOWER_OFFSET = LEG_LENGTH - SHELF_BOTTOM - 89

// Top boards: 12 x 2x4 (89mm) across the width, even gaps
TOP_GAP = (WIDTH - 12 * 89) / 11
TOP_STEP = 89 + TOP_GAP

// Shelf boards: 10 x 2x4 (89mm) across the lower front/back aprons, even gaps
SHELF_GAP = (APRON_FB - 10 * 89) / 11
SHELF_STEP = 89 + SHELF_GAP

// Legs
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// Upper aprons (flush with the leg tops)
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// Lower aprons (support the shelf)
(lower_front:2x4 =APRON_FB)
(lower_back:2x4 =APRON_FB)
(lower_left:2x4 =APRON_LR)
(lower_right:2x4 =APRON_LR)

// Top boards (2x4, length = depth)
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)

// Shelf boards (2x4, length = depth)
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)

// Upper frame: front/back aprons end into the legs' narrow faces, flush with the leg tops
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Upper frame: side aprons end into the legs' wide faces, flush with the leg tops
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// Lower frame: same joints, leg anchor offset by LOWER_OFFSET from the down end
leg_fl -[LB>LOWER_OFFSET DB>0 D(:8x30)]- lower_front
leg_fr -[RF>LOWER_OFFSET TF>0 D(:8x30)]- lower_front
leg_bl -[LB>LOWER_OFFSET DB>0 D(:8x30)]- lower_back
leg_br -[RF>LOWER_OFFSET TF>0 D(:8x30)]- lower_back

leg_fl -[BR>LOWER_OFFSET DB>0 D(:8x30)]- lower_left
leg_bl -[FR>LOWER_OFFSET TB>0 D(:8x30)]- lower_left
leg_fr -[BL>LOWER_OFFSET DF>0 D(:8x30)]- lower_right
leg_br -[FL>LOWER_OFFSET TF>0 D(:8x30)]- lower_right

// Shelf boards: screwed down onto lower_front, resting on lower_back
lower_front -[RF<(SHELF_GAP) BT<0 S(Slim:3.8x65)]- shelf_1
lower_front -[RF<(SHELF_GAP + SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_2
lower_front -[RF<(SHELF_GAP + 2 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_3
lower_front -[RF<(SHELF_GAP + 3 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_4
lower_front -[RF<(SHELF_GAP + 4 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_5
lower_front -[RF<(SHELF_GAP + 5 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_6
lower_front -[RF<(SHELF_GAP + 6 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_7
lower_front -[RF<(SHELF_GAP + 7 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_8
lower_front -[RF<(SHELF_GAP + 8 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_9
lower_front -[RF<(SHELF_GAP + 9 * SHELF_STEP) BT<0 S(Slim:3.8x65)]- shelf_10

// Top boards: outer boards screwed onto the legs, inner boards onto apron_front
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_front -[RF<(TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_2
apron_front -[RF<(2 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_3
apron_front -[RF<(3 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_4
apron_front -[RF<(4 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_5
apron_front -[RF<(5 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_6
apron_front -[RF<(6 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_7
apron_front -[RF<(7 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_8
apron_front -[RF<(8 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_9
apron_front -[RF<(9 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_10
apron_front -[RF<(10 * TOP_STEP - 89) BT<0 S(Slim:3.8x65)]- top_11
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_12

steps {
  "Upper frame": leg_fl, leg_fr, leg_bl, leg_br, apron_front, apron_back, apron_left, apron_right
  "Lower frame": lower_front, lower_back, lower_left, lower_right
  "Shelf boards": shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10
  "Top boards": top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12
}
