// Workbench
// Overall: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 throughout
// Frame: 8x30 dowels, top and shelf boards: screws (Slim 3.8x65)
// Lower shelf top surface 150mm above the floor

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
BOARD = 89
THICKNESS = 38

// Legs: height minus the 38mm top boards
LEG_LENGTH = HEIGHT - THICKNESS

// Front/back aprons run between the legs' 89mm faces
APRON_FRONT_LENGTH = WIDTH - 2 * BOARD
// Side aprons run between the legs' 38mm faces
APRON_SIDE_LENGTH = DEPTH - 2 * THICKNESS

// Upper front/back apron flush with the leg top
UPPER_SIDE_OFFSET = LEG_LENGTH - 89

// Lower shelf: top surface 150mm above the floor, 2x4 boards on the lower aprons
SHELF_TOP = 150
LOWER_APRON_BOTTOM = SHELF_TOP - THICKNESS - 89
LOWER_SIDE_OFFSET = LOWER_APRON_BOTTOM
LOWER_FRONT_OFFSET = LEG_LENGTH - LOWER_APRON_BOTTOM - 89

// Top boards: 13 x 89 = 1157, gaps (1200 - 1157) / 12
TOP_GAP = (WIDTH - 13 * 89) / 12

// Shelf boards fit between the legs: 11 x 89 = 979, gaps (1022 - 979) / 12
SHELF_GAP = (APRON_FRONT_LENGTH - 11 * 89) / 12

// ============================================
// Legs (4x): 850 - 38 = 812mm tall
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons, flush with the leg tops
// ============================================
(apron_upper_front:2x4 =APRON_FRONT_LENGTH)
(apron_upper_back:2x4 =APRON_FRONT_LENGTH)
(apron_upper_left:2x4 =APRON_SIDE_LENGTH)
(apron_upper_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Lower aprons, supporting the shelf
// Bottom edge at 150 - 38 - 89 = 23mm above the floor
// ============================================
(apron_lower_front:2x4 =APRON_FRONT_LENGTH)
(apron_lower_back:2x4 =APRON_FRONT_LENGTH)
(apron_lower_left:2x4 =APRON_SIDE_LENGTH)
(apron_lower_right:2x4 =APRON_SIDE_LENGTH)

// ============================================
// Top boards (2x4, running front to back)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Lower shelf boards (2x4, running front to back)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper apron connections (dowels 8x30)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front

leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_fl -[BR<UPPER_SIDE_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE_OFFSET TB<0 D(:8x30)]- apron_upper_left

leg_fr -[BL<UPPER_SIDE_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (dowels 8x30)
// ============================================
leg_fl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front

leg_bl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_SIDE_OFFSET DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_SIDE_OFFSET TB<0 D(:8x30)]- apron_lower_left

leg_fr -[BL<LOWER_SIDE_OFFSET DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_SIDE_OFFSET TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards: outer boards on the legs, inner boards on the upper front apron
// Offsets: (k - 1) * (89 + TOP_GAP) - 89 for board k
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<TOP_GAP BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<(89 + 2 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_3
apron_upper_front -[RF<(2 * 89 + 3 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_4
apron_upper_front -[RF<(3 * 89 + 4 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_5
apron_upper_front -[RF<(4 * 89 + 5 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_6
apron_upper_front -[RF<(5 * 89 + 6 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_7
apron_upper_front -[RF<(6 * 89 + 7 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_8
apron_upper_front -[RF<(7 * 89 + 8 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_9
apron_upper_front -[RF<(8 * 89 + 9 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_10
apron_upper_front -[RF<(9 * 89 + 10 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_11
apron_upper_front -[RF<(10 * 89 + 11 * TOP_GAP) BT<0 S(Slim:3.8x65)]- top_12
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Shelf boards on the lower front apron
// Offsets: SHELF_GAP + (k - 1) * (89 + SHELF_GAP)
// ============================================
apron_lower_front -[RF<SHELF_GAP BT<0 S(Slim:3.8x65)]- shelf_1
apron_lower_front -[RF<(SHELF_GAP + 89 + SHELF_GAP) BT<0 S(Slim:3.8x65)]- shelf_2
apron_lower_front -[RF<(SHELF_GAP + 2 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_3
apron_lower_front -[RF<(SHELF_GAP + 3 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_4
apron_lower_front -[RF<(SHELF_GAP + 4 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_5
apron_lower_front -[RF<(SHELF_GAP + 5 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_6
apron_lower_front -[RF<(SHELF_GAP + 6 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_7
apron_lower_front -[RF<(SHELF_GAP + 7 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_8
apron_lower_front -[RF<(SHELF_GAP + 8 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_9
apron_lower_front -[RF<(SHELF_GAP + 9 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_10
apron_lower_front -[RF<(SHELF_GAP + 10 * (89 + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_11

// ============================================
// Assembly: side frames, join with front/back aprons, shelf, top
// ============================================
steps {
  "Left frame":   leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame":  leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join frames":  apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Lower shelf":  shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":          top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
