// Desk
// Dimensions: 1000mm (W) x 500mm (D) x 700mm (H)
// Material: 2x4 legs and aprons, 1x6 top boards
// Joints: 8x30 dowels in the frame, Slim 3.3x45 screws for the top

WIDTH = 1000
DEPTH = 500
HEIGHT = 700
TOP_T = 19
LEG = HEIGHT - TOP_T
APRON_FB = WIDTH - 2 * 89
APRON_LR = DEPTH - 2 * 38

BOARD_W = 140
BOARD_GAP = (WIDTH - 7 * BOARD_W) / 6

// ============================================
// Legs (4x) - 700mm height minus the 19mm top boards
// ============================================
(leg_fl:2x4 =LEG)
(leg_fr:2x4 =LEG)
(leg_bl:2x4 =LEG)
(leg_br:2x4 =LEG)

// ============================================
// Aprons: front/back between the legs' 89mm sides,
// side aprons between the legs' 38mm sides, flush with the leg tops
// ============================================
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Top boards: 1x6 (140mm) run front to back (length DEPTH)
// 7 boards: 7 x 140 = 980, gaps (1000 - 980) / 6 = 3.33mm
// ============================================
(top_1:1x6 =DEPTH)
(top_2:1x6 =DEPTH)
(top_3:1x6 =DEPTH)
(top_4:1x6 =DEPTH)
(top_5:1x6 =DEPTH)
(top_6:1x6 =DEPTH)
(top_7:1x6 =DEPTH)

// ============================================
// Frame joints (dowels)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Top boards (screwed down): outer boards on the legs,
// inner boards on apron_front
// ============================================
leg_fl -[TF>0 BD>0 S(Slim:3.3x45)]- top_1
apron_front -[RF<(1 * (BOARD_W + BOARD_GAP) - 89) BT<0 S(Slim:3.3x45)]- top_2
apron_front -[RF<(2 * (BOARD_W + BOARD_GAP) - 89) BT<0 S(Slim:3.3x45)]- top_3
apron_front -[RF<(3 * (BOARD_W + BOARD_GAP) - 89) BT<0 S(Slim:3.3x45)]- top_4
apron_front -[RF<(4 * (BOARD_W + BOARD_GAP) - 89) BT<0 S(Slim:3.3x45)]- top_5
apron_front -[RF<(5 * (BOARD_W + BOARD_GAP) - 89) BT<0 S(Slim:3.3x45)]- top_6
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_7

steps {
  "Front frame": leg_fl, leg_fr, apron_front
  "Back frame":  leg_bl, leg_br, apron_back
  "Join side aprons": apron_left, apron_right
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7
}
