// Two-Tier Shelf
// Dimensions: 600mm (W) x 300mm (D) x 800mm (H)
// Material: 2x4 (frame, lower shelf boards), 1x4 (top surface, depth direction)
// Joints: Dowel 8x30
//
// Structure:
// - 4 legs at the corners
// - Upper aprons flush with the leg tops
// - Lower aprons with their bottom edge 150mm above the floor
// - Top surface boards (1x4) rest on the legs and the upper front apron
// - Lower shelf boards (2x4) rest on the lower front apron, between the legs

WIDTH = 600
DEPTH = 300
HEIGHT = 800
LOWER_HEIGHT = 150          // lower apron's bottom edge above the floor
TOP_THICKNESS = 19          // 1x4 top boards

// ============================================
// Legs (4x) - leg_1: front-left, leg_2: front-right
// leg_3: back-left, leg_4: back-right
// ============================================
LEG_LENGTH = HEIGHT - TOP_THICKNESS
(leg_1:2x4 =LEG_LENGTH)
(leg_2:2x4 =LEG_LENGTH)
(leg_3:2x4 =LEG_LENGTH)
(leg_4:2x4 =LEG_LENGTH)

// ============================================
// Aprons: front/back run between the legs' 89mm sides,
// left/right run between the legs' 38mm sides
// ============================================
APRON_FB = WIDTH - 2 * 89
APRON_LR = DEPTH - 2 * 38
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top surface (1x4, depth direction)
// n boards of 89mm fit under WIDTH, leaving (n-1) equal gaps
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)
TOP_GAP = (WIDTH - 6 * 89) / 5
TOP_OFFSET_2 = TOP_GAP
TOP_OFFSET_3 = 89 + 2 * TOP_GAP
TOP_OFFSET_4 = 178 + 3 * TOP_GAP
TOP_OFFSET_5 = 267 + 4 * TOP_GAP

// ============================================
// Lower shelf boards (2x4, depth direction), resting on
// apron_lower_front, between the legs, flush at both ends
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
SHELF_GAP = (APRON_FB - 4 * 89) / 3
SHELF_OFFSET_2 = 89 + SHELF_GAP
SHELF_OFFSET_3 = 2 * (89 + SHELF_GAP)
SHELF_OFFSET_4 = 3 * (89 + SHELF_GAP)

// ============================================
// Upper apron connections (flush with the leg tops)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

UPPER_LR_OFFSET = LEG_LENGTH - 89
leg_1 -[BR<UPPER_LR_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<UPPER_LR_OFFSET TB<0 D(:8x30)]- apron_upper_left
leg_2 -[BL<UPPER_LR_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<UPPER_LR_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (bottom edge LOWER_HEIGHT above the floor)
// ============================================
LOWER_FB_OFFSET = LEG_LENGTH - LOWER_HEIGHT - 89
leg_1 -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_3 -[LB>LOWER_FB_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_FB_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<LOWER_HEIGHT DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_HEIGHT TB<0 D(:8x30)]- apron_lower_left
leg_2 -[BL<LOWER_HEIGHT DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_HEIGHT TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface connections: outer boards sit on the legs,
// inner boards sit on the upper front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_OFFSET_4 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<TOP_OFFSET_5 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Lower shelf connections: all boards sit on the lower front apron
// ============================================
apron_lower_front -[RF<0 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFFSET_4 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
