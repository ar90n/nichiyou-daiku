// Side Table
// Dimensions: WIDTH x DEPTH x HEIGHT = 500mm x 400mm x 600mm
// Material: 2x4 (legs, aprons, top boards)
// Joints: Dowel 8x30

WIDTH = 500                            // overall width
DEPTH = 400                            // overall depth
HEIGHT = 600                           // overall height
LEG_LEN = HEIGHT - 38                  // legs lose the 38mm top boards under them
APRON_FB = WIDTH - 2 * 89              // front/back aprons run between the legs' 89mm sides
APRON_LR = DEPTH - 2 * 38              // side aprons run between the legs' 38mm sides
TOP_GAP = (WIDTH - 5 * 89) / 4         // 5 top boards of 89mm across the width

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Aprons, flush with the leg tops
// ============================================
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Top boards: 2x4 laid across the depth direction,
// 5 boards leave 4 gaps of 13.75mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons: end into the legs' narrow faces, flush with the leg tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons: end into the legs' front/back faces, flush with the leg tops
// ============================================
leg_fl -[BR<(LEG_LEN - 89) DB<0 D(:8x30)]- apron_left
leg_bl -[FR<(LEG_LEN - 89) TB<0 D(:8x30)]- apron_left
leg_fr -[BL<(LEG_LEN - 89) DF<0 D(:8x30)]- apron_right
leg_br -[FL<(LEG_LEN - 89) TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards: outer boards sit on the legs, inner boards
// on the front apron, one gap + one board apart
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP * 2 + 89) BT<0 D(:8x30)]- top_3
apron_front -[RF<(TOP_GAP * 3 + 178) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
