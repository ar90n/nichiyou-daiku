// Workbench
// Overall: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 lumber
// Frame: 8x30 dowels; top and lower shelf boards: screws
// Lower shelf: top surface 150mm above the floor

WIDTH = 1200
DEPTH = 600
HEIGHT = 850

BOARD_THICK = 38
LEG_WIDTH = 89
LEG_THICK = 38
APRON_WIDTH = 89

// Legs: overall height minus the 2x4 top boards
LEG = HEIGHT - BOARD_THICK

// Front/back aprons run between the legs' 89mm sides
FRONT_APRON = WIDTH - 2 * LEG_WIDTH
// Side aprons run between the legs' 38mm sides
SIDE_APRON = DEPTH - 2 * LEG_THICK

// Upper aprons are flush with the leg tops
UPPER_SIDE_OFFSET = LEG - APRON_WIDTH

// Lower shelf: boards are 38mm thick and sit on the lower aprons,
// so the apron tops are 38mm below the 150mm shelf surface.
SHELF_TOP = 150
LOWER_APRON_TOP = SHELF_TOP - BOARD_THICK
LOWER_APRON_BOTTOM = LOWER_APRON_TOP - APRON_WIDTH

// Front/back lower aprons: offset from the leg top
LOWER_FRONT_OFFSET = LEG - LOWER_APRON_BOTTOM - APRON_WIDTH
// Side lower aprons: offset from the floor
LOWER_SIDE_OFFSET = LOWER_APRON_BOTTOM

// Board layout across the width: largest count with n x 89 <= span
TOP_COUNT = 13
TOP_GAP = (WIDTH - TOP_COUNT * LEG_WIDTH) / (TOP_COUNT - 1)
SHELF_COUNT = 11
SHELF_GAP = (FRONT_APRON - SHELF_COUNT * LEG_WIDTH) / (SHELF_COUNT + 1)

// Offsets of the inner top boards from the apron end at leg_fl
TOP_O2 = TOP_GAP
TOP_O3 = TOP_GAP + (LEG_WIDTH + TOP_GAP)
TOP_O4 = TOP_GAP + 2 * (LEG_WIDTH + TOP_GAP)
TOP_O5 = TOP_GAP + 3 * (LEG_WIDTH + TOP_GAP)
TOP_O6 = TOP_GAP + 4 * (LEG_WIDTH + TOP_GAP)
TOP_O7 = TOP_GAP + 5 * (LEG_WIDTH + TOP_GAP)
TOP_O8 = TOP_GAP + 6 * (LEG_WIDTH + TOP_GAP)
TOP_O9 = TOP_GAP + 7 * (LEG_WIDTH + TOP_GAP)
TOP_O10 = TOP_GAP + 8 * (LEG_WIDTH + TOP_GAP)
TOP_O11 = TOP_GAP + 9 * (LEG_WIDTH + TOP_GAP)
TOP_O12 = TOP_GAP + 10 * (LEG_WIDTH + TOP_GAP)

// Offsets of the shelf boards from the apron end at leg_fl
SHELF_O1 = SHELF_GAP
SHELF_O2 = SHELF_GAP + (LEG_WIDTH + SHELF_GAP)
SHELF_O3 = SHELF_GAP + 2 * (LEG_WIDTH + SHELF_GAP)
SHELF_O4 = SHELF_GAP + 3 * (LEG_WIDTH + SHELF_GAP)
SHELF_O5 = SHELF_GAP + 4 * (LEG_WIDTH + SHELF_GAP)
SHELF_O6 = SHELF_GAP + 5 * (LEG_WIDTH + SHELF_GAP)
SHELF_O7 = SHELF_GAP + 6 * (LEG_WIDTH + SHELF_GAP)
SHELF_O8 = SHELF_GAP + 7 * (LEG_WIDTH + SHELF_GAP)
SHELF_O9 = SHELF_GAP + 8 * (LEG_WIDTH + SHELF_GAP)
SHELF_O10 = SHELF_GAP + 9 * (LEG_WIDTH + SHELF_GAP)
SHELF_O11 = SHELF_GAP + 10 * (LEG_WIDTH + SHELF_GAP)

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left,  leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG)
(leg_fr:2x4 =LEG)
(leg_bl:2x4 =LEG)
(leg_br:2x4 =LEG)

// ============================================
// Upper aprons, flush with the leg tops
// ============================================
(apron_upper_front:2x4 =FRONT_APRON)
(apron_upper_back:2x4 =FRONT_APRON)
(apron_upper_left:2x4 =SIDE_APRON)
(apron_upper_right:2x4 =SIDE_APRON)

// ============================================
// Lower aprons, carrying the lower shelf
// ============================================
(apron_lower_front:2x4 =FRONT_APRON)
(apron_lower_back:2x4 =FRONT_APRON)
(apron_lower_left:2x4 =SIDE_APRON)
(apron_lower_right:2x4 =SIDE_APRON)

// ============================================
// Top boards (2x4, running front to back)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Lower shelf boards (2x4, running front to back)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper front/back aprons into the legs' narrow faces
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// ============================================
// Upper side aprons into the legs' wide faces
// ============================================
leg_fl -[BR<UPPER_SIDE_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE_OFFSET TB<0 D(:8x30)]- apron_upper_left
leg_fr -[BL<UPPER_SIDE_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower front/back aprons
// ============================================
leg_fl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

// ============================================
// Lower side aprons
// ============================================
leg_fl -[BR<LOWER_SIDE_OFFSET DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_SIDE_OFFSET TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<LOWER_SIDE_OFFSET DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_SIDE_OFFSET TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards: outer boards screwed to the front legs,
// inner boards screwed to the upper front apron
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.3x45)]- top_1
apron_upper_front -[RF<TOP_O2 BT<0 S(Slim:3.3x45)]- top_2
apron_upper_front -[RF<TOP_O3 BT<0 S(Slim:3.3x45)]- top_3
apron_upper_front -[RF<TOP_O4 BT<0 S(Slim:3.3x45)]- top_4
apron_upper_front -[RF<TOP_O5 BT<0 S(Slim:3.3x45)]- top_5
apron_upper_front -[RF<TOP_O6 BT<0 S(Slim:3.3x45)]- top_6
apron_upper_front -[RF<TOP_O7 BT<0 S(Slim:3.3x45)]- top_7
apron_upper_front -[RF<TOP_O8 BT<0 S(Slim:3.3x45)]- top_8
apron_upper_front -[RF<TOP_O9 BT<0 S(Slim:3.3x45)]- top_9
apron_upper_front -[RF<TOP_O10 BT<0 S(Slim:3.3x45)]- top_10
apron_upper_front -[RF<TOP_O11 BT<0 S(Slim:3.3x45)]- top_11
apron_upper_front -[RF<TOP_O12 BT<0 S(Slim:3.3x45)]- top_12
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_13

// ============================================
// Lower shelf boards screwed to the lower front apron
// ============================================
apron_lower_front -[RF<SHELF_O1 BT<0 S(Slim:3.3x45)]- shelf_1
apron_lower_front -[RF<SHELF_O2 BT<0 S(Slim:3.3x45)]- shelf_2
apron_lower_front -[RF<SHELF_O3 BT<0 S(Slim:3.3x45)]- shelf_3
apron_lower_front -[RF<SHELF_O4 BT<0 S(Slim:3.3x45)]- shelf_4
apron_lower_front -[RF<SHELF_O5 BT<0 S(Slim:3.3x45)]- shelf_5
apron_lower_front -[RF<SHELF_O6 BT<0 S(Slim:3.3x45)]- shelf_6
apron_lower_front -[RF<SHELF_O7 BT<0 S(Slim:3.3x45)]- shelf_7
apron_lower_front -[RF<SHELF_O8 BT<0 S(Slim:3.3x45)]- shelf_8
apron_lower_front -[RF<SHELF_O9 BT<0 S(Slim:3.3x45)]- shelf_9
apron_lower_front -[RF<SHELF_O10 BT<0 S(Slim:3.3x45)]- shelf_10
apron_lower_front -[RF<SHELF_O11 BT<0 S(Slim:3.3x45)]- shelf_11

// ============================================
// Assembly: side frames, the aprons joining them,
// the lower shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Lower shelf": shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
