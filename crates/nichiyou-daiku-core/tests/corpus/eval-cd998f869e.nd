// Step Stool (子ども用踏み台)
// Dimensions: 300mm (W) x 250mm (D) x 300mm (H)
// Material: 2x4 (all parts)
// Joint: Dowel 8x30

WIDTH = 300
DEPTH = 250
HEIGHT = 300

// Legs: height minus the 38mm-thick top boards
LEG_LENGTH = HEIGHT - 38

// Front/back aprons run between the legs' 89mm sides
APRON_FB = WIDTH - 2 * 89
// Left/right aprons run between the legs' 38mm sides
APRON_LR = DEPTH - 2 * 38

// Side aprons flush with the leg tops: point this far up the leg
SIDE_OFFSET = LEG_LENGTH - 89

// Top boards (3x, 89mm each): 3*89 = 267, gap = (300-267)/2 = 16.5
GAP = (WIDTH - 3 * 89) / 2

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons (flush with the top)
// ============================================
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, depth direction) - 3 boards
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left apron to legs
// ============================================
leg_fl -[BR<SIDE_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<SIDE_OFFSET TB<0 D(:8x30)]- apron_left

// ============================================
// Right apron to legs
// ============================================
leg_fr -[BL<SIDE_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<SIDE_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// End boards sit on the front legs, middle board on the front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<GAP BT<0 D(:8x30)]- top_2
top_3 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Assembly: the side frames, the aprons joining them, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3
}
