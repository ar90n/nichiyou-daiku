// Side Table
// Overall size: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4 frame and 2x4 top boards
// Joints: 8x30 dowels

WIDTH = 500
DEPTH = 400
HEIGHT = 600
TOP_THICKNESS = 38
LEG_LENGTH = HEIGHT - TOP_THICKNESS
APRON_HEIGHT = 89

// Number of top boards: 5 x 89 = 445, gap = (500 - 445) / 4 = 13.75
TOP_GAP = (WIDTH - 5 * 89) / 4
TOP_PITCH = 89 + TOP_GAP

// ============================================
// Legs (4x) - height minus the 2x4 top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons - tops flush with the leg tops
// Front/back between the legs' 89mm faces: 500 - 2x89 = 322
// Left/right between the legs' 38mm faces: 400 - 2x38 = 324
// ============================================
(apron_front:2x4 =WIDTH - 2 * 89)
(apron_back:2x4 =WIDTH - 2 * 89)
(apron_left:2x4 =DEPTH - 2 * 38)
(apron_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Top boards - 2x4 laid in the depth direction
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons: ends into the legs' narrow faces,
// flush with the leg tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons: ends into the legs' wide faces,
// flush with the leg tops (LEG_LENGTH - 89 up the leg)
// ============================================
leg_fl -[BR<(LEG_LENGTH - APRON_HEIGHT) DB<0 D(:8x30)]- apron_left
leg_bl -[FR<(LEG_LENGTH - APRON_HEIGHT) TB<0 D(:8x30)]- apron_left
leg_fr -[BL<(LEG_LENGTH - APRON_HEIGHT) DF<0 D(:8x30)]- apron_right
leg_br -[FL<(LEG_LENGTH - APRON_HEIGHT) TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to the frame
// Outer boards sit on the front legs; inner boards on apron_front,
// one gap plus one board apart
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP + TOP_PITCH) BT<0 D(:8x30)]- top_3
apron_front -[RF<(TOP_GAP + 2 * TOP_PITCH) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: side frames first, then the long aprons, then the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
