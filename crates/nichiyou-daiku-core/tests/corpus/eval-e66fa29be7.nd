// Child's Step Stool
// Dimensions: 300mm (W) x 250mm (D) x 300mm (H)
// Material: 2x4 throughout, for strength
// Joint: Dowel 8x30 for the frame, Slim:3.3x45 screws for the top boards

WIDTH = 300
DEPTH = 250
HEIGHT = 300

// ============================================
// Legs (4x) - height minus the 38mm-thick top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
LEG_LENGTH = HEIGHT - 38
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons
// Front/back run between the legs' 89mm sides: 300 - 2*89 = 122mm
// Left/right run between the legs' 38mm sides: 250 - 2*38 = 174mm
// ============================================
APRON_FB = WIDTH - 2 * 89
APRON_LR = DEPTH - 2 * 38
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, running front to back) - 250mm in the depth direction
// 3 boards: 3*89 = 267mm, leaving 2 gaps of (300 - 267) / 2 = 16.5mm
// ============================================
TOP_GAP = (WIDTH - 3 * 89) / 2
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left apron to legs (flush with top)
// ============================================
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left

// ============================================
// Right apron to legs
// ============================================
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// Outer boards sit on the front/back... actually front legs, flush with their tops
// Middle board sits on the front apron, one gap in from leg_fl
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.3x45)]- top_1
apron_front -[RF<TOP_GAP BT<0 S(Slim:3.3x45)]- top_2
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_3

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3
}
