// Plant Stand
// Dimensions: 400mm (W) x 300mm (D) x 700mm (H)
// Material: 2x2 (structure), 1x4 (top and shelf)
// Joints: 8x30 dowels for the frame, Slim 3.3x45 screws for the boards
//
// Structure:
// - 4 corner legs, 2x2, with their faces flush with the outside
// - Upper front/back aprons flush with the leg tops, side aprons 10mm lower
// - Lower front/back aprons support the shelf at 200mm, side aprons 10mm lower
// - 1x4 top boards running front to back, 4 boards across the width
// - 1x4 shelf boards running front to back, 3 boards between the legs

// ============================================
// Overall dimensions and derived sizes
// ============================================
WIDTH = 400
DEPTH = 300
HEIGHT = 700

TOP_THICKNESS = 19
LEG = HEIGHT - TOP_THICKNESS

// 2x2 is 38mm square, so every apron loses one leg thickness at each end
APRON_FRONT_BACK = WIDTH - 2 * 38
APRON_SIDE = DEPTH - 2 * 38

// Shelf top at 200mm: the 19mm board sits on the lower front/back aprons
SHELF_TOP = 200
SHELF_UNDER = SHELF_TOP - TOP_THICKNESS

// Distance from the top of a leg down to the top of the lower front apron
LOWER_FRONT_OFFSET = LEG - SHELF_UNDER
// The side aprons sit 10mm low so their 8mm dowels clear the front/back
// apron dowels in the 2x2 legs (a small reveal under the top and shelf).
SIDE_DROP = 10
// Side aprons measure from the bottom of the leg to their top edge
LOWER_SIDE_OFFSET = SHELF_UNDER - SIDE_DROP
UPPER_SIDE_OFFSET = LEG - SIDE_DROP

// Top: 4 boards of 89mm across 400mm, 3 gaps
TOP_GAP = (WIDTH - 4 * 89) / 3
// Inner boards: board k starts (k-1)*(89+gap) from the outer edge.
// The 1x4 overlaps the 38mm leg by 89-38mm, which the apron offset absorbs.
TOP_OFFSET_2 = APRON_FRONT_BACK - (89 + TOP_GAP) - (89 - 38)
TOP_OFFSET_3 = APRON_FRONT_BACK - 2 * (89 + TOP_GAP) - (89 - 38)

// Shelf: 3 boards of 89mm between the legs (324mm), 4 gaps
SHELF_GAP = (APRON_FRONT_BACK - 3 * 89) / 4
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = SHELF_GAP + 89 + SHELF_GAP
SHELF_OFFSET_3 = SHELF_GAP + 2 * (89 + SHELF_GAP)

// ============================================
// Legs (4x): height minus the 19mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x2 =LEG)
(leg_fr:2x2 =LEG)
(leg_bl:2x2 =LEG)
(leg_br:2x2 =LEG)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back run between the legs: 400 - 2*38 = 324mm
// Sides run between the legs: 300 - 2*38 = 224mm
// ============================================
(apron_upper_front:2x2 =APRON_FRONT_BACK)
(apron_upper_back:2x2 =APRON_FRONT_BACK)
(apron_upper_left:2x2 =APRON_SIDE)
(apron_upper_right:2x2 =APRON_SIDE)

// ============================================
// Lower aprons (shelf support)
// ============================================
(apron_lower_front:2x2 =APRON_FRONT_BACK)
(apron_lower_back:2x2 =APRON_FRONT_BACK)
(apron_lower_left:2x2 =APRON_SIDE)
(apron_lower_right:2x2 =APRON_SIDE)

// ============================================
// Top surface (1x4, depth direction)
// 4 boards: 4*89 = 356mm, 3 gaps of 14.67mm
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)

// ============================================
// Shelf surface (1x4, depth direction)
// 3 boards: 3*89 = 267mm, 4 gaps of 14.25mm
// ============================================
(shelf_1:1x4 =DEPTH)
(shelf_2:1x4 =DEPTH)
(shelf_3:1x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the top, dowels)
// ============================================

// Front upper apron
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front

// Back upper apron
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Left upper apron
leg_fl -[BR<UPPER_SIDE_OFFSET TB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE_OFFSET DB<0 D(:8x30)]- apron_upper_left

// Right upper apron
leg_fr -[BL<UPPER_SIDE_OFFSET TF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE_OFFSET DF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (shelf support, dowels)
// Front/back measured down from the top of the leg
// Sides measured up from the bottom of the leg
// ============================================

// Front lower apron
leg_fl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front

// Back lower apron
leg_bl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

// Left lower apron
leg_fl -[BR<LOWER_SIDE_OFFSET TB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_SIDE_OFFSET DB<0 D(:8x30)]- apron_lower_left

// Right lower apron
leg_fr -[BL<LOWER_SIDE_OFFSET TF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_SIDE_OFFSET DF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface connections (screwed down through the 1x4 boards)
// Outer boards sit on the legs, inner boards on the upper front apron
// ============================================
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_1
apron_upper_front -[RF<TOP_OFFSET_2 BT<0 S(Slim:3.3x45)]- top_2
apron_upper_front -[RF<TOP_OFFSET_3 BT<0 S(Slim:3.3x45)]- top_3
leg_fl -[TF>0 BD>0 S(Slim:3.3x45)]- top_4

// ============================================
// Shelf connections (screwed to the lower front apron)
// Boards sit between the legs, one gap + one board apart
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf_3

// ============================================
// Assembly: side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3
  "Top":         top_1, top_2, top_3, top_4
}
