// Side Table
// Dimensions: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4 throughout, top boards run in the depth direction
// Joint: Dowel 8x30

WIDTH = 500
DEPTH = 400
HEIGHT = 600

// ============================================
// Legs (4x) - height minus the 38mm-thick top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =HEIGHT - 38)
(leg_fr:2x4 =HEIGHT - 38)
(leg_bl:2x4 =HEIGHT - 38)
(leg_br:2x4 =HEIGHT - 38)

// ============================================
// Aprons - flush with the leg tops
// Front/back run between the legs' 89mm sides: WIDTH - 2x89
// Left/right run between the legs' 38mm sides: DEPTH - 2x38
// ============================================
(apron_front:2x4 =WIDTH - 2 * 89)
(apron_back:2x4 =WIDTH - 2 * 89)
(apron_left:2x4 =DEPTH - 2 * 38)
(apron_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Top boards (2x4), running in the depth direction
// 5 boards: 5*89 = 445mm, leaving 4 gaps of (WIDTH - 445) / 4
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left apron to legs (flush with top)
// ============================================
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left

// ============================================
// Right apron to legs
// ============================================
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// Outer boards sit on the front/back legs, inner boards on apron_front
// Gap: (WIDTH - 5*89) / 4 = 13.75; offsets 13.75, 116.5, 219.25
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<13.75 BT<0 D(:8x30)]- top_2
apron_front -[RF<116.5 BT<0 D(:8x30)]- top_3
apron_front -[RF<219.25 BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: left/right side frames, joined by front/back aprons, then the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
