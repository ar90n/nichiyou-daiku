// Plant Stand (花台)
// Dimensions: 400mm (W) x 300mm (D) x 700mm (H)
// Frame: 2x2, dowel 8x30 / Top & shelf boards: 1x4, screw Slim:3.3x45
// Shelf: 1 tier, top surface 200mm above the floor

// ============================================
// Overall size
// ============================================
WIDTH = 400
DEPTH = 300
HEIGHT = 700
LEG_SIZE = 38          // 2x2
TOP_THICKNESS = 19     // 1x4
BOARD_WIDTH = 89       // 1x4
SHELF_HEIGHT = 200      // shelf top surface above the floor

LEG_LEN = HEIGHT - TOP_THICKNESS

// Left/right aprons sit this much lower than front/back aprons at each leg,
// so their dowel holes don't cross the front/back dowel holes inside the leg
STAGGER = 10

// Front/back and left/right aprons run between the legs' 38mm faces
APRON_FB = WIDTH - 2 * LEG_SIZE
APRON_LR = DEPTH - 2 * LEG_SIZE

// Top boards (4 x 89mm across the 400mm width), outer boards on the legs,
// inner boards screwed to apron_front (whose own edge starts LEG_SIZE in from
// the stand's outer edge, so that offset must be subtracted out below)
GAP_TOP = (WIDTH - 4 * BOARD_WIDTH) / 3
BOARD_STEP_TOP = BOARD_WIDTH + GAP_TOP
TOP_OFF2 = BOARD_STEP_TOP - LEG_SIZE
TOP_OFF3 = 2 * BOARD_STEP_TOP - LEG_SIZE

// Lower aprons positioned so the shelf's top surface sits at SHELF_HEIGHT
SHELF_BOTTOM = SHELF_HEIGHT - TOP_THICKNESS
LOWER_APRON_BOTTOM = SHELF_BOTTOM - LEG_SIZE
LOWER_LEG_OFFSET = LEG_LEN - LOWER_APRON_BOTTOM - LEG_SIZE
LOWER_LEG_OFFSET_LR = LOWER_LEG_OFFSET + STAGGER

// Shelf boards (3 x 89mm between the legs, resting on lower_front only)
GAP_SHELF = (APRON_FB - 3 * BOARD_WIDTH) / 4
SHELF_OFF1 = GAP_SHELF
SHELF_OFF2 = BOARD_WIDTH + 2 * GAP_SHELF
SHELF_OFF3 = 2 * BOARD_WIDTH + 3 * GAP_SHELF

// ============================================
// Legs (4x)
// ============================================
(leg_fl:2x2 =LEG_LEN)
(leg_fr:2x2 =LEG_LEN)
(leg_bl:2x2 =LEG_LEN)
(leg_br:2x2 =LEG_LEN)

// ============================================
// Upper aprons (flush with the top)
// ============================================
(apron_front:2x2 =APRON_FB)
(apron_back:2x2 =APRON_FB)
(apron_left:2x2 =APRON_LR)
(apron_right:2x2 =APRON_LR)

// ============================================
// Lower aprons (support the shelf)
// ============================================
(lower_front:2x2 =APRON_FB)
(lower_back:2x2 =APRON_FB)
(lower_left:2x2 =APRON_LR)
(lower_right:2x2 =APRON_LR)

// ============================================
// Top boards (1x4, run front to back)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)

// ============================================
// Shelf boards (1x4, run front to back)
// ============================================
(shelf_1:1x4 =DEPTH)
(shelf_2:1x4 =DEPTH)
(shelf_3:1x4 =DEPTH)

// ============================================
// Upper aprons to legs (flush with top)
// ============================================
leg_fl -[LB>0 DB>0 D(:6x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:6x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:6x30)]- apron_back
leg_br -[RF>0 TF>0 D(:6x30)]- apron_back

leg_fl -[BR>STAGGER DB>0 D(:6x30)]- apron_left
leg_bl -[FR>STAGGER TB>0 D(:6x30)]- apron_left
leg_fr -[BL>STAGGER DF>0 D(:6x30)]- apron_right
leg_br -[FL>STAGGER TF>0 D(:6x30)]- apron_right

// ============================================
// Lower aprons to legs (shelf support)
// ============================================
leg_fl -[LB>LOWER_LEG_OFFSET DB>0 D(:6x30)]- lower_front
leg_fr -[RF>LOWER_LEG_OFFSET TF>0 D(:6x30)]- lower_front
leg_bl -[LB>LOWER_LEG_OFFSET DB>0 D(:6x30)]- lower_back
leg_br -[RF>LOWER_LEG_OFFSET TF>0 D(:6x30)]- lower_back

leg_fl -[BR>LOWER_LEG_OFFSET_LR DB>0 D(:6x30)]- lower_left
leg_bl -[FR>LOWER_LEG_OFFSET_LR TB>0 D(:6x30)]- lower_left
leg_fr -[BL>LOWER_LEG_OFFSET_LR DF>0 D(:6x30)]- lower_right
leg_br -[FL>LOWER_LEG_OFFSET_LR TF>0 D(:6x30)]- lower_right

// ============================================
// Top boards to frame (outer boards flush with the legs' outer faces)
// ============================================
leg_fl -[TF>0 BD>0 S(Slim:3.3x45)]- top_1
apron_front -[RF<TOP_OFF2 BT<0 S(Slim:3.3x45)]- top_2
apron_front -[RF<TOP_OFF3 BT<0 S(Slim:3.3x45)]- top_3
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_4

// ============================================
// Shelf boards to frame (all between the legs)
// ============================================
lower_front -[RF<SHELF_OFF1 BT<0 S(Slim:3.3x45)]- shelf_1
lower_front -[RF<SHELF_OFF2 BT<0 S(Slim:3.3x45)]- shelf_2
lower_front -[RF<SHELF_OFF3 BT<0 S(Slim:3.3x45)]- shelf_3

// ============================================
// Assembly order
// ============================================
steps {
  "Left side frame":  leg_fl, leg_bl, apron_left, lower_left
  "Right side frame": leg_fr, leg_br, apron_right, lower_right
  "Join with front/back aprons": apron_front, apron_back, lower_front, lower_back
  "Top boards": top_1, top_2, top_3, top_4
  "Shelf boards": shelf_1, shelf_2, shelf_3
}
