// Side Table
// Overall size: width 500mm x depth 400mm x height 600mm
// Material: 2x4
// Joints: 8x30 dowels

WIDTH = 500
DEPTH = 400
HEIGHT = 600

WIDE = 89
THIN = 38
TOP_THICK = 38

LEG_LEN = HEIGHT - TOP_THICK
APRON_LEN_FB = WIDTH - 2 * WIDE
APRON_LEN_LR = DEPTH - 2 * THIN
APRON_TOP_OFFSET = LEG_LEN - WIDE

TOP_COUNT = 5
TOP_GAP = (WIDTH - TOP_COUNT * WIDE) / (TOP_COUNT - 1)
TOP_PITCH = WIDE + TOP_GAP

// Legs: height minus the 2x4 top boards
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// Front/back aprons: between the legs' 89mm faces
(apron_front:2x4 =APRON_LEN_FB)
(apron_back:2x4 =APRON_LEN_FB)

// Side aprons: between the legs' 38mm faces
(apron_left:2x4 =APRON_LEN_LR)
(apron_right:2x4 =APRON_LEN_LR)

// Top boards: 2x4 laid side by side in the depth direction
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// Front apron, flush with the leg tops
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// Back apron, flush with the leg tops
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Left apron, flush with the leg tops
leg_fl -[BR<APRON_TOP_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_TOP_OFFSET TB<0 D(:8x30)]- apron_left

// Right apron, flush with the leg tops
leg_fr -[BL<APRON_TOP_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_TOP_OFFSET TF<0 D(:8x30)]- apron_right

// Top boards down onto the frame
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_PITCH + TOP_GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(2 * TOP_PITCH + TOP_GAP) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
