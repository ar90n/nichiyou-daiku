// 1x8 Bookshelf
// Overall: 600mm (W) x 184mm (D) x 900mm (H)
// Material: 1x8 only
// Joints: 8x30 dowels
//
// Two 1x8 side panels, 184mm deep and 900mm high.
// Four 1x8 shelves including the top and bottom, equally spaced.
// Top shelf flush with the top; bottom shelf at the floor.

WIDTH = 600
DEPTH = 184
HEIGHT = 900
THICKNESS = 19
SHELF_COUNT = 4

// Shelves fit between the side panels: 600 - 2 x 19 = 562
SHELF_LENGTH = WIDTH - 2 * THICKNESS
// Four shelf boards leave three equal clear openings
SPACING = (HEIGHT - THICKNESS) / (SHELF_COUNT - 1)
GAP = SPACING - THICKNESS
SHELF_2_Z = SPACING
SHELF_3_Z = 2 * SPACING
SHELF_4_Z = HEIGHT - THICKNESS

// ============================================
// Side panels
// ============================================
(side_left:1x8 =HEIGHT)
(side_right:1x8 =HEIGHT)

// ============================================
// Shelves (top and bottom included)
// ============================================
(shelf_1:1x8 =SHELF_LENGTH)
(shelf_2:1x8 =SHELF_LENGTH)
(shelf_3:1x8 =SHELF_LENGTH)
(shelf_4:1x8 =SHELF_LENGTH)

// ============================================
// Shelf connections (8x30 dowels)
// The offset is the shelf underside above the floor.
// ============================================
side_left -[BL<0 DL<0 D(:8x30)]- shelf_1
side_right -[FL<0 TL<0 D(:8x30)]- shelf_1

side_left -[BL<SHELF_2_Z DL<0 D(:8x30)]- shelf_2
side_right -[FL<SHELF_2_Z TL<0 D(:8x30)]- shelf_2

side_left -[BL<SHELF_3_Z DL<0 D(:8x30)]- shelf_3
side_right -[FL<SHELF_3_Z TL<0 D(:8x30)]- shelf_3

side_left -[BL<SHELF_4_Z DL<0 D(:8x30)]- shelf_4
side_right -[FL<SHELF_4_Z TL<0 D(:8x30)]- shelf_4

steps {
  "Left side and shelves": side_left, shelf_1, shelf_2, shelf_3, shelf_4
  "Right side": side_right
}
