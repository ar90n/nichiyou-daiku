// Two-Tier Shelf
// Overall: 600mm (W) x 300mm (D) x 800mm (H)
// Frame: 2x4, top: 1x4 boards running depth, shelf: 2x4 boards on the lower apron
// Joints: 8x30 dowels

WIDTH = 600
DEPTH = 300
HEIGHT = 800

LEG_W = 89          // 2x4 wide face
LEG_T = 38          // 2x4 edge
APRON_H = 89        // 2x4 wide face, apron height
TOP_T = 19          // 1x4 thickness
BOARD_W = 89        // board width (1x4 and 2x4)
LOWER_H = 150       // lower apron bottom above the floor

// Legs: 800 - 19 (top boards) = 781
LEG_LEN = HEIGHT - TOP_T

// Aprons: front/back run between the legs' 89mm faces, sides between the 38mm faces
APRON_FB_LEN = WIDTH - 2 * LEG_W
APRON_LR_LEN = DEPTH - 2 * LEG_T

// Lower apron: 781 - 150 - 89 = 542 measured down from the leg top
LOWER_FB_OFF = LEG_LEN - LOWER_H - APRON_H
// Upper side aprons sit flush with the top: 781 - 89 = 692 up from the floor
UPPER_LR_OFF = LEG_LEN - APRON_H

// Top boards (1x4, depth direction): 6 x 89 = 534, gap (600 - 534) / 5 = 13.2
TOP_COUNT = 6
TOP_GAP = (WIDTH - TOP_COUNT * BOARD_W) / (TOP_COUNT - 1)
TOP_OFF_2 = TOP_GAP
TOP_OFF_3 = TOP_GAP + (BOARD_W + TOP_GAP)
TOP_OFF_4 = TOP_GAP + 2 * (BOARD_W + TOP_GAP)
TOP_OFF_5 = TOP_GAP + 3 * (BOARD_W + TOP_GAP)

// Shelf boards (2x4, depth direction) between the legs: 4 x 89 = 356
SHELF_COUNT = 4
SHELF_GAP = (APRON_FB_LEN - SHELF_COUNT * BOARD_W) / (SHELF_COUNT + 1)
SHELF_OFF_1 = SHELF_GAP
SHELF_OFF_2 = SHELF_GAP + (BOARD_W + SHELF_GAP)
SHELF_OFF_3 = SHELF_GAP + 2 * (BOARD_W + SHELF_GAP)
SHELF_OFF_4 = SHELF_GAP + 3 * (BOARD_W + SHELF_GAP)

// ============================================
// Legs (4x) - 781mm
// leg_1: front-left, leg_2: front-right, leg_3: back-left, leg_4: back-right
// ============================================
(leg_1:2x4 =LEG_LEN)
(leg_2:2x4 =LEG_LEN)
(leg_3:2x4 =LEG_LEN)
(leg_4:2x4 =LEG_LEN)

// ============================================
// Upper aprons (flush with the leg tops)
// ============================================
(apron_upper_front:2x4 =APRON_FB_LEN)
(apron_upper_back:2x4 =APRON_FB_LEN)
(apron_upper_left:2x4 =APRON_LR_LEN)
(apron_upper_right:2x4 =APRON_LR_LEN)

// ============================================
// Lower aprons (bottom 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB_LEN)
(apron_lower_back:2x4 =APRON_FB_LEN)
(apron_lower_left:2x4 =APRON_LR_LEN)
(apron_lower_right:2x4 =APRON_LR_LEN)

// ============================================
// Top surface (1x4, depth direction)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Shelf boards (2x4, depth direction) on the lower front apron
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the top)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_1 -[BR<UPPER_LR_OFF DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<UPPER_LR_OFF TB<0 D(:8x30)]- apron_upper_left
leg_2 -[BL<UPPER_LR_OFF DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<UPPER_LR_OFF TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (bottom 150mm above the floor)
// ============================================
leg_1 -[LB>LOWER_FB_OFF DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_FB_OFF TF>0 D(:8x30)]- apron_lower_front
leg_3 -[LB>LOWER_FB_OFF DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_FB_OFF TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<LOWER_H DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_H TB<0 D(:8x30)]- apron_lower_left
leg_2 -[BL<LOWER_H DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_H TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface connections: outer boards on the legs, inner on the front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<TOP_OFF_2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_OFF_3 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_OFF_4 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<TOP_OFF_5 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Shelf connections: all boards on the lower front apron
// ============================================
apron_lower_front -[RF<SHELF_OFF_1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_OFF_2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_OFF_3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_OFF_4 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: side frames, then the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
