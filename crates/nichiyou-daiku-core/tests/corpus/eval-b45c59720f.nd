// Slat Bench
// Overall: 900mm (W) x 300mm (D) x 420mm (H)
// Frame: 2x4 with 8x30 dowels, 1x4 seat slats screwed with Slim 3.3x45
// Seat slats run along the width (long direction), 3 boards across the depth.

// ============================================
// Overall dimensions and derived sizes
// ============================================
WIDTH = 900
DEPTH = 300
HEIGHT = 420
BOARD_T = 19
BOARD_W = 89
LEG_W = 89
LEG_T = 38
APRON_H = 89

LEG_LEN = HEIGHT - BOARD_T             // 401
FRONT_APRON_LEN = WIDTH - 2 * LEG_W    // 722
SIDE_APRON_LEN = DEPTH - 2 * LEG_T     // 224
SIDE_APRON_OFFSET = LEG_LEN - APRON_H  // 312: side apron flush with leg top

// Seat: 3 boards, gaps split evenly between the boards
SEAT_GAP = (DEPTH - 3 * BOARD_W) / 2   // 16.5
SEAT_PITCH = BOARD_W + SEAT_GAP        // 105.5
// 1x4 board 900 long, anchored at mid-width; offsets measured
// from the side aprons' down (front) end toward the back.
SEAT_OFFSET_1 = DEPTH - LEG_T - BOARD_W / 2                 // 217.5
SEAT_OFFSET_2 = SEAT_OFFSET_1 - SEAT_PITCH                  // 112
SEAT_OFFSET_3 = SEAT_OFFSET_2 - SEAT_PITCH                  // 6.5

// ============================================
// Legs (4x, 2x4)
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Frame aprons (2x4)
// ============================================
(apron_front:2x4 =FRONT_APRON_LEN)
(apron_back:2x4 =FRONT_APRON_LEN)
(apron_left:2x4 =SIDE_APRON_LEN)
(apron_right:2x4 =SIDE_APRON_LEN)

// ============================================
// Seat slats (3x, 1x4, running along the width)
// ============================================
(seat_1:1x4 =WIDTH)
(seat_2:1x4 =WIDTH)
(seat_3:1x4 =WIDTH)

// ============================================
// Front/back aprons: ends into the legs' narrow faces,
// flush with the legs' front faces
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons: ends into the legs' wide faces,
// flush with the legs' outer sides and tops
// ============================================
leg_fl -[BR<SIDE_APRON_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<SIDE_APRON_OFFSET TB<0 D(:8x30)]- apron_left
leg_fr -[BL<SIDE_APRON_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<SIDE_APRON_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Seat slats: screwed down to both side aprons,
// ends flush with the outer sides
// ============================================
apron_left -[RB<SEAT_OFFSET_1 BT<(BOARD_W / 2) S(Slim:3.3x35)]- seat_1
apron_right -[RF<SEAT_OFFSET_1 BD<(BOARD_W / 2) S(Slim:3.3x35)]- seat_1
apron_left -[RB<SEAT_OFFSET_2 BT<(BOARD_W / 2) S(Slim:3.3x35)]- seat_2
apron_right -[RF<SEAT_OFFSET_2 BD<(BOARD_W / 2) S(Slim:3.3x35)]- seat_2
apron_left -[RB<SEAT_OFFSET_3 BT<(BOARD_W / 2) S(Slim:3.3x35)]- seat_3
apron_right -[RF<SEAT_OFFSET_3 BD<(BOARD_W / 2) S(Slim:3.3x35)]- seat_3

// Assembly: side frames, apron join, then the seat
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join frame":  apron_front, apron_back
  "Seat":        seat_1, seat_2, seat_3
}
