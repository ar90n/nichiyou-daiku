// Bench
// Overall: 900mm (W) x 300mm (D) x 420mm (H)
// Legs: 4x 2x4, seat: 3x 1x4 running along the width
// Frame: 8x30 dowels, seat boards: Slim 3.3x45 screws

WIDTH = 900
DEPTH = 300
HEIGHT = 420
TOP_THICK = 19
LEG_W = 89
LEG_T = 38
BOARD_W = 89
LEG = HEIGHT - TOP_THICK
SEAT_GAP = (DEPTH - 3 * BOARD_W) / 2
SEAT_MID_FRONT = 2 * BOARD_W + SEAT_GAP
MID_SCREW_OFFSET = (DEPTH - LEG_T) - SEAT_MID_FRONT
SCREW_SETBACK = 18
FRONT_SCREW_OFFSET = LEG_T - SCREW_SETBACK

// ============================================
// Legs (4x)
// ============================================
(leg_fl:2x4 =LEG)
(leg_fr:2x4 =LEG)
(leg_bl:2x4 =LEG)
(leg_br:2x4 =LEG)

// ============================================
// Aprons, flush with the leg tops
// Front/back run between the legs' 89mm sides
// Left/right run between the legs' 38mm sides
// ============================================
(apron_front:2x4 =WIDTH - 2 * LEG_W)
(apron_back:2x4 =WIDTH - 2 * LEG_W)
(apron_left:2x4 =DEPTH - 2 * LEG_T)
(apron_right:2x4 =DEPTH - 2 * LEG_T)

// ============================================
// Seat boards, 3 x 1x4 along the width
// 3 * 89 = 267mm, gaps (300 - 267) / 2 = 16.5mm
// ============================================
(seat_front:1x4 =WIDTH)
(seat_mid:1x4 =WIDTH)
(seat_back:1x4 =WIDTH)

// ============================================
// Frame joints (dowels)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Seat boards: outer boards into the front/back legs,
// middle board into the side aprons
// ============================================
leg_fl -[TR<SCREW_SETBACK BD<FRONT_SCREW_OFFSET S(Slim:3.3x45)]- seat_front
leg_fr -[TL<SCREW_SETBACK BT<FRONT_SCREW_OFFSET S(Slim:3.3x45)]- seat_front

apron_left -[RB<MID_SCREW_OFFSET BD<0 S(Slim:3.3x45)]- seat_mid
apron_right -[RF<MID_SCREW_OFFSET BT<0 S(Slim:3.3x45)]- seat_mid

leg_bl -[TR<SCREW_SETBACK BD>SCREW_SETBACK S(Slim:3.3x45)]- seat_back
leg_br -[TL<SCREW_SETBACK BT>SCREW_SETBACK S(Slim:3.3x45)]- seat_back

steps {
  "Front frame": leg_fl, leg_fr, apron_front
  "Back frame":  leg_bl, leg_br, apron_back
  "Join with side aprons": apron_left, apron_right
  "Seat boards": seat_back, seat_mid, seat_front
}
