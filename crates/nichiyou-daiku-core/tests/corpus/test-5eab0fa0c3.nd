
        (beam1:2x4 =1000)
        (beam2:2x4 =800)
        (beam3:2x4 =600)
        (beam4:2x4 =500)

        // Vanilla connection (default)
        beam1 -[TF>80 BD<50]- beam2

        // Dowel connection
        beam2 -[LT<0 RT<0 D(5.0,25.0)]- beam3

        // Screw connection
        beam3 -[FT<0 BT<0 S(3.5,50.0)]- beam4
        