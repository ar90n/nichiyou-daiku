// Workbench
// Overall size: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 lumber throughout
// Joints: 8x30 dowels for the leg-and-apron frame, screws for the top and shelf boards
//
// Structure:
// - 4 corner legs, 89mm across the width and 38mm across the depth
// - Upper aprons flush with the leg tops
// - Lower aprons carrying a lower shelf whose top surface is 150mm above the floor
// - 2x4 top boards running front to back, screwed down
// - 2x4 shelf boards running front to back, screwed to the lower front apron

// ============================================
// Overall sizes
// ============================================
WIDTH = 1200
DEPTH = 600
HEIGHT = 850

LEG_WIDTH = 89
LEG_THICKNESS = 38
APRON_HEIGHT = 89
BOARD_THICKNESS = 38

// Legs: 850 - 38mm top boards
LEG_LENGTH = HEIGHT - BOARD_THICKNESS

// Aprons between the legs: 1200 - 2x89, 600 - 2x38
FRONT_APRON_LENGTH = WIDTH - 2 * LEG_WIDTH
SIDE_APRON_LENGTH = DEPTH - 2 * LEG_THICKNESS

// Upper side aprons flush with the leg tops
UPPER_SIDE_OFFSET = LEG_LENGTH - APRON_HEIGHT

// Lower shelf: top surface 150mm above the floor
SHELF_HEIGHT = 150
SHELF_THICKNESS = 38
SHELF_BOTTOM = SHELF_HEIGHT - SHELF_THICKNESS
LOWER_APRON_BOTTOM = SHELF_BOTTOM - APRON_HEIGHT
LOWER_FRONT_OFFSET = LEG_LENGTH - LOWER_APRON_BOTTOM - APRON_HEIGHT

// Top boards: 13 x 89 = 1157, 12 gaps of (1200 - 1157) / 12
TOP_COUNT = 13
TOP_GAP = (WIDTH - TOP_COUNT * LEG_WIDTH) / (TOP_COUNT - 1)
TOP_PITCH = LEG_WIDTH + TOP_GAP

// Shelf boards: 11 x 89 = 979, 12 gaps of (1022 - 979) / 12
SHELF_COUNT = 11
SHELF_GAP = (FRONT_APRON_LENGTH - SHELF_COUNT * LEG_WIDTH) / (SHELF_COUNT + 1)
SHELF_PITCH = LEG_WIDTH + SHELF_GAP

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons, flush with the leg tops
// ============================================
(apron_front:2x4 =FRONT_APRON_LENGTH)
(apron_back:2x4 =FRONT_APRON_LENGTH)
(apron_left:2x4 =SIDE_APRON_LENGTH)
(apron_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Lower aprons, supporting the lower shelf
// ============================================
(apron_lower_front:2x4 =FRONT_APRON_LENGTH)
(apron_lower_back:2x4 =FRONT_APRON_LENGTH)
(apron_lower_left:2x4 =SIDE_APRON_LENGTH)
(apron_lower_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Top boards (2x4, depth direction)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Lower shelf boards (2x4, depth direction)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper apron connections (8x30 dowels)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

leg_fl -[BR<UPPER_SIDE_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<UPPER_SIDE_OFFSET TB<0 D(:8x30)]- apron_left
leg_fr -[BL<UPPER_SIDE_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<UPPER_SIDE_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Lower apron connections (8x30 dowels)
// Front/back offset measured down from the leg top;
// side offsets measured up from the floor.
// ============================================
leg_fl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_APRON_BOTTOM DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_APRON_BOTTOM TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<LOWER_APRON_BOTTOM DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_APRON_BOTTOM TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards, screwed down to the legs and to apron_front
// Offsets step one board plus one gap from the apron's left end
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_front -[RF<(TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_2
apron_front -[RF<(2 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_3
apron_front -[RF<(3 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_4
apron_front -[RF<(4 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_5
apron_front -[RF<(5 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_6
apron_front -[RF<(6 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_7
apron_front -[RF<(7 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_8
apron_front -[RF<(8 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_9
apron_front -[RF<(9 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_10
apron_front -[RF<(10 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_11
apron_front -[RF<(11 * TOP_PITCH - LEG_WIDTH) BT<0 S(Slim:3.8x65)]- top_12
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Shelf boards, screwed to the lower front apron
// Offsets step one board plus one gap, starting one gap in
// ============================================
apron_lower_front -[RF<SHELF_GAP BT<0 S(Slim:3.8x65)]- shelf_1
apron_lower_front -[RF<(SHELF_GAP + SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_2
apron_lower_front -[RF<(SHELF_GAP + 2 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_3
apron_lower_front -[RF<(SHELF_GAP + 3 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_4
apron_lower_front -[RF<(SHELF_GAP + 4 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_5
apron_lower_front -[RF<(SHELF_GAP + 5 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_6
apron_lower_front -[RF<(SHELF_GAP + 6 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_7
apron_lower_front -[RF<(SHELF_GAP + 7 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_8
apron_lower_front -[RF<(SHELF_GAP + 8 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_9
apron_lower_front -[RF<(SHELF_GAP + 9 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_10
apron_lower_front -[RF<(SHELF_GAP + 10 * SHELF_PITCH) BT<0 S(Slim:3.8x65)]- shelf_11

// ============================================
// Assembly: side frames, aprons joining them, shelf, top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_right, apron_lower_right
  "Join frames": apron_front, apron_back, apron_lower_front, apron_lower_back
  "Lower shelf": shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
