// Side Table
// Dimensions: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4 (W=89, T=38)
// Joint: dowel 8x30
// Legs: 4, apron flush with the top, top boards run front to back (depth)

WIDTH = 500
DEPTH = 400
HEIGHT = 600

BOARD_WIDTH = 89
BOARD_THICKNESS = 38
TOP_THICKNESS = 38

N_TOP = 5
TOP_GAP = (WIDTH - N_TOP * BOARD_WIDTH) / (N_TOP - 1)
STEP = BOARD_WIDTH + TOP_GAP

// ============================================
// Legs (4x) - 600mm height minus the 38mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =HEIGHT - TOP_THICKNESS)
(leg_fr:2x4 =HEIGHT - TOP_THICKNESS)
(leg_bl:2x4 =HEIGHT - TOP_THICKNESS)
(leg_br:2x4 =HEIGHT - TOP_THICKNESS)

// ============================================
// Aprons - flush with the leg tops
// Front/back run between the legs' 89mm sides
// Left/right run between the legs' 38mm sides
// ============================================
(apron_front:2x4 =WIDTH - 2 * BOARD_WIDTH)
(apron_back:2x4 =WIDTH - 2 * BOARD_WIDTH)
(apron_left:2x4 =DEPTH - 2 * BOARD_THICKNESS)
(apron_right:2x4 =DEPTH - 2 * BOARD_THICKNESS)

// ============================================
// Top boards - DEPTH long, laid across the width
// 5 x 89 = 445mm, leaving 4 gaps of (500 - 445) / 4 = 13.75mm
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with the top)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// Back apron to legs
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Left apron to legs (flush with the top: 562 - 89 = 473mm up the leg)
leg_fl -[BR<473 DB<0 D(:8x30)]- apron_left
leg_bl -[FR<473 TB<0 D(:8x30)]- apron_left

// Right apron to legs
leg_fr -[BL<473 DF<0 D(:8x30)]- apron_right
leg_br -[FL<473 TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to the frame
// End boards sit on the front legs; middle boards on apron_front,
// offsets STEP - 89, 2*STEP - 89, 3*STEP - 89 from the leg_fl end
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<(STEP - BOARD_WIDTH) BT<0 D(:8x30)]- top_2
apron_front -[RF<(2 * STEP - BOARD_WIDTH) BT<0 D(:8x30)]- top_3
apron_front -[RF<(3 * STEP - BOARD_WIDTH) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, then the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
