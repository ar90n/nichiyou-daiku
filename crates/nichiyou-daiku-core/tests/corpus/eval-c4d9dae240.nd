// Side Table
// Overall: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4
// Joint: 8x30 dowels
// Legs show 89mm to the front, 38mm to the sides; aprons flush with the leg tops;
// top boards (2x4) run front to back.

WIDTH = 500
DEPTH = 400
HEIGHT = 600
TOP_THICKNESS = 38
BOARD_WIDTH = 89
LEG_SIDE = 38

BOARDS = 5
GAP = (WIDTH - BOARDS * BOARD_WIDTH) / (BOARDS - 1)
STEP = BOARD_WIDTH + GAP
OFF_2 = STEP - BOARD_WIDTH
OFF_3 = 2 * STEP - BOARD_WIDTH
OFF_4 = 3 * STEP - BOARD_WIDTH

// ============================================
// Legs (4x): height minus the 2x4 top boards
// ============================================
(leg_fl:2x4 =HEIGHT - TOP_THICKNESS)
(leg_fr:2x4 =HEIGHT - TOP_THICKNESS)
(leg_bl:2x4 =HEIGHT - TOP_THICKNESS)
(leg_br:2x4 =HEIGHT - TOP_THICKNESS)

// ============================================
// Aprons: front/back between the legs' 89mm sides, sides between the 38mm sides
// ============================================
(apron_front:2x4 =WIDTH - 2 * BOARD_WIDTH)
(apron_back:2x4 =WIDTH - 2 * BOARD_WIDTH)
(apron_left:2x4 =DEPTH - 2 * LEG_SIDE)
(apron_right:2x4 =DEPTH - 2 * LEG_SIDE)

// ============================================
// Top boards (2x4, running front to back)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons to legs (flush with the leg tops)
// ============================================
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Top boards on the frame: outer boards on the front legs,
// inner boards on the front apron, one board + one gap apart
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<OFF_2 BT<0 D(:8x30)]- top_2
apron_front -[RF<OFF_3 BT<0 D(:8x30)]- top_3
apron_front -[RF<OFF_4 BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, then the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
