// Plant Stand
// Dimensions: 400mm (W) x 300mm (D) x 700mm (H)
// Material: 2x2 frame, 1x4 top and shelf boards
// Joints: 8x30 dowels for the frame, Slim 3.3x45 screws for the boards
// Shelf: one shelf, surface 200mm above the floor

// ============================================
// Overall sizes
// ============================================
WIDTH = 400
DEPTH = 300
HEIGHT = 700
BOARD_THICKNESS = 19
LEG_SIZE = 38
LEG_LENGTH = HEIGHT - BOARD_THICKNESS
SHELF_HEIGHT = 200
SHELF_SUPPORT_TOP = SHELF_HEIGHT - BOARD_THICKNESS
LOWER_APRON_BOTTOM = SHELF_SUPPORT_TOP - LEG_SIZE
UPPER_SIDE_OFFSET = LEG_LENGTH - LEG_SIZE
LOWER_FRONT_OFFSET = LEG_LENGTH - LOWER_APRON_BOTTOM - LEG_SIZE

// ============================================
// Legs (4x) - height minus the 19mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x2 =LEG_LENGTH)
(leg_fr:2x2 =LEG_LENGTH)
(leg_bl:2x2 =LEG_LENGTH)
(leg_br:2x2 =LEG_LENGTH)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back run between the legs: WIDTH - 2*38 = 324mm
// Left/right run between the legs: DEPTH - 2*38 = 224mm
// ============================================
(apron_front:2x2 =WIDTH - 2 * LEG_SIZE)
(apron_back:2x2 =WIDTH - 2 * LEG_SIZE)
(apron_left:2x2 =DEPTH - 2 * LEG_SIZE)
(apron_right:2x2 =DEPTH - 2 * LEG_SIZE)

// ============================================
// Lower aprons (support the shelf boards)
// Top edge at SHELF_SUPPORT_TOP = 181mm, bottom at 143mm
// ============================================
(apron_lower_front:2x2 =WIDTH - 2 * LEG_SIZE)
(apron_lower_back:2x2 =WIDTH - 2 * LEG_SIZE)
(apron_lower_left:2x2 =DEPTH - 2 * LEG_SIZE)
(apron_lower_right:2x2 =DEPTH - 2 * LEG_SIZE)

// ============================================
// Top boards (1x4, running front to back)
// 4 boards: 4*89 = 356mm, gaps (400 - 356) / 3 = 14.67mm
// Offsets are measured from the front apron end at leg_fl
// ============================================
TOP_GAP = (WIDTH - 4 * 89) / 3
TOP_OFFSET_2 = (2 - 1) * (89 + TOP_GAP) - LEG_SIZE
TOP_OFFSET_3 = (3 - 1) * (89 + TOP_GAP) - LEG_SIZE

(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)

// ============================================
// Shelf boards (1x4, running front to back)
// 3 boards between the legs: 3*89 = 267mm,
// gaps (324 - 267) / 4 = 14.25mm
// ============================================
SHELF_GAP = (WIDTH - 2 * LEG_SIZE - 3 * 89) / 4
SHELF_OFFSET_1 = SHELF_GAP
SHELF_OFFSET_2 = SHELF_GAP + (89 + SHELF_GAP)
SHELF_OFFSET_3 = SHELF_GAP + 2 * (89 + SHELF_GAP)

(shelf_1:1x4 =DEPTH)
(shelf_2:1x4 =DEPTH)
(shelf_3:1x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Lower apron connections
// Front/back: offset from the leg top = LEG_LENGTH - 181 - 38 = 500mm
// Left/right: offset from the leg bottom = 143mm
// ============================================
leg_fl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR>500 DB>0 D(:8x30)]- apron_lower_left
leg_bl -[FR>500 TB>0 D(:8x30)]- apron_lower_left
leg_fr -[BL>500 DF>0 D(:8x30)]- apron_lower_right
leg_br -[FL>500 TF>0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards (screwed down through the boards)
// ============================================
leg_fl -[TF<0 BD>0 S(Slim:3.3x45)]- top_1
apron_front -[RF<TOP_OFFSET_2 BT<0 S(Slim:3.3x45)]- top_2
apron_front -[RF<TOP_OFFSET_3 BT<0 S(Slim:3.3x45)]- top_3
leg_fr -[TF<0 BD<0 S(Slim:3.3x45)]- top_4

// ============================================
// Shelf boards (screwed down onto the lower front apron)
// ============================================
apron_lower_front -[RF<SHELF_OFFSET_1 BT<0 S(Slim:3.3x45)]- shelf_1
apron_lower_front -[RF<SHELF_OFFSET_2 BT<0 S(Slim:3.3x45)]- shelf_2
apron_lower_front -[RF<SHELF_OFFSET_3 BT<0 S(Slim:3.3x45)]- shelf_3

// ============================================
// Assembly: side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_right, apron_lower_right
  "Join":        apron_front, apron_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3
  "Top":         top_1, top_2, top_3, top_4
}
