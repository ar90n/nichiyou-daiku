// Slatted Bench
// Dimensions: 900mm (W) x 300mm (D) x 420mm (H)
// Material: 2x4 (legs + aprons), 1x4 (seat boards)
// Joints: 8x30 dowels for the frame, Slim 3.3x45 screws for the seat boards
//
// Structure:
// - 4 legs at the corners, 2x4, showing 89mm to the front and 38mm to the sides
// - Front/back and left/right aprons, 2x4, flush with the leg tops
// - Seat boards (1x4), one board 300mm long running front to back,
//   lined up along the 900mm length: 10 boards, gap (900 - 10*89) / 9

WIDTH = 900
DEPTH = 300
HEIGHT = 420

TOP_THICKNESS = 19
LEG_LENGTH = HEIGHT - TOP_THICKNESS        // 401

APRON_FB = WIDTH - 2 * 89                  // 722
APRON_LR = DEPTH - 2 * 38                  // 224
APRON_TOP_OFFSET = LEG_LENGTH - 89         // side aprons flush with the leg tops

BOARDS = 10
BOARD_WIDTH = 89
GAP = (WIDTH - BOARDS * BOARD_WIDTH) / (BOARDS - 1)
PITCH = BOARD_WIDTH + GAP

// Inner board k (k = 2..9) sits PITCH apart; first inner offset from the leg
OFFSET_2 = 1 * PITCH - BOARD_WIDTH
OFFSET_3 = 2 * PITCH - BOARD_WIDTH
OFFSET_4 = 3 * PITCH - BOARD_WIDTH
OFFSET_5 = 4 * PITCH - BOARD_WIDTH
OFFSET_6 = 5 * PITCH - BOARD_WIDTH
OFFSET_7 = 6 * PITCH - BOARD_WIDTH
OFFSET_8 = 7 * PITCH - BOARD_WIDTH
OFFSET_9 = 8 * PITCH - BOARD_WIDTH

// ============================================
// Legs (4x) - 420mm height minus the 19mm seat boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons (2x4), flush with the top
// Front/back run between the legs' 89mm sides: 900 - 2*89 = 722
// Left/right run between the legs' 38mm sides: 300 - 2*38 = 224
// ============================================
(apron_front:2x4 =APRON_FB)
(apron_back:2x4 =APRON_FB)
(apron_left:2x4 =APRON_LR)
(apron_right:2x4 =APRON_LR)

// ============================================
// Seat boards (1x4, front to back), 10 boards of 300mm
// laid along the 900mm length
// ============================================
(seat_1:1x4 =DEPTH)
(seat_2:1x4 =DEPTH)
(seat_3:1x4 =DEPTH)
(seat_4:1x4 =DEPTH)
(seat_5:1x4 =DEPTH)
(seat_6:1x4 =DEPTH)
(seat_7:1x4 =DEPTH)
(seat_8:1x4 =DEPTH)
(seat_9:1x4 =DEPTH)
(seat_10:1x4 =DEPTH)

// ============================================
// Frame connections (8x30 dowels)
// ============================================

// Front apron
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// Back apron
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Left apron (flush with the leg tops)
leg_fl -[BR<APRON_TOP_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<APRON_TOP_OFFSET TB<0 D(:8x30)]- apron_left

// Right apron
leg_fr -[BL<APRON_TOP_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<APRON_TOP_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Seat connections
// End boards are doweled to the front legs; inner boards are screwed
// down through the board into the front apron
// ============================================
seat_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<OFFSET_2 BT<0 S(Slim:3.3x45)]- seat_2
apron_front -[RF<OFFSET_3 BT<0 S(Slim:3.3x45)]- seat_3
apron_front -[RF<OFFSET_4 BT<0 S(Slim:3.3x45)]- seat_4
apron_front -[RF<OFFSET_5 BT<0 S(Slim:3.3x45)]- seat_5
apron_front -[RF<OFFSET_6 BT<0 S(Slim:3.3x45)]- seat_6
apron_front -[RF<OFFSET_7 BT<0 S(Slim:3.3x45)]- seat_7
apron_front -[RF<OFFSET_8 BT<0 S(Slim:3.3x45)]- seat_8
apron_front -[RF<OFFSET_9 BT<0 S(Slim:3.3x45)]- seat_9
seat_10 -[BD<0 TF<0 D(:8x30)]- leg_fr

// ============================================
// Assembly: the side frames, the aprons joining them, the seat
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Seat":        seat_1, seat_2, seat_3, seat_4, seat_5, seat_6, seat_7, seat_8, seat_9, seat_10
}
