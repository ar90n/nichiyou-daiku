// Two-Tier Shelf
// Overall: 600mm (W) x 300mm (D) x 800mm (H)
// Frame: 2x4  /  Top: 1x4 boards running in the depth direction
// Lower shelf: 2x4 boards resting on the lower aprons
// Joints: 8x30 dowels

WIDTH = 600
DEPTH = 300
HEIGHT = 800
TOP_N = 6                        // 1x4 top boards: largest n with n*89 <= WIDTH
SHELF_N = 4                      // 2x4 shelf boards between the legs

LEG_W = 89                       // 2x4 width  (legs show 89mm to the front)
LEG_T = 38                       // 2x4 thickness (legs show 38mm to the sides)
BOARD_W = 89
APRON_H = 89                     // apron height (2x4 on edge)
TOP_THICK = 19                   // 1x4 top board thickness
SHELF_H = 150                    // lower apron / shelf underside above the floor

LEG_LEN = HEIGHT - TOP_THICK                    // 800 - 19 = 781
APRON_FB = WIDTH - 2 * LEG_W                    // 600 - 178 = 422
APRON_LR = DEPTH - 2 * LEG_T                    // 300 - 76 = 224
UPPER_OFF = LEG_LEN - APRON_H                   // side upper apron: 781 - 89 = 692
LOWER_OFF = LEG_LEN - SHELF_H - APRON_H         // front/back lower apron: 781-150-89 = 542

TOP_GAP = (WIDTH - TOP_N * BOARD_W) / (TOP_N - 1)   // (600-534)/5 = 13.2
TOP_O2 = 1 * (BOARD_W + TOP_GAP) - BOARD_W
TOP_O3 = 2 * (BOARD_W + TOP_GAP) - BOARD_W
TOP_O4 = 3 * (BOARD_W + TOP_GAP) - BOARD_W
TOP_O5 = 4 * (BOARD_W + TOP_GAP) - BOARD_W

SHELF_GAP = (APRON_FB - SHELF_N * BOARD_W) / (SHELF_N + 1)  // (422-356)/5 = 13.2
SHELF_O1 = SHELF_GAP
SHELF_O2 = SHELF_GAP + 1 * (BOARD_W + SHELF_GAP)
SHELF_O3 = SHELF_GAP + 2 * (BOARD_W + SHELF_GAP)
SHELF_O4 = SHELF_GAP + 3 * (BOARD_W + SHELF_GAP)

// ============================================
// Legs (4x) - height minus the 1x4 top boards
// leg_1: front-left, leg_2: front-right
// leg_3: back-left,  leg_4: back-right
// ============================================
(leg_1:2x4 =LEG_LEN)
(leg_2:2x4 =LEG_LEN)
(leg_3:2x4 =LEG_LEN)
(leg_4:2x4 =LEG_LEN)

// ============================================
// Upper Aprons (flush with the leg tops)
// Front/back between the legs' 89mm faces, left/right between the 38mm faces
// ============================================
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)

// ============================================
// Lower Aprons (underside 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top Surface (1x4, depth direction, length = DEPTH)
// ============================================
(top_1:1x4 =DEPTH)
(top_2:1x4 =DEPTH)
(top_3:1x4 =DEPTH)
(top_4:1x4 =DEPTH)
(top_5:1x4 =DEPTH)
(top_6:1x4 =DEPTH)

// ============================================
// Shelf boards (2x4, depth direction, on the lower aprons)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops, offset >0)
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front

leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_1 -[BR<UPPER_OFF DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<UPPER_OFF TB<0 D(:8x30)]- apron_upper_left

leg_2 -[BL<UPPER_OFF DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<UPPER_OFF TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (underside 150mm above the floor)
// ============================================
leg_1 -[LB>LOWER_OFF DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_OFF TF>0 D(:8x30)]- apron_lower_front

leg_3 -[LB>LOWER_OFF DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_OFF TF>0 D(:8x30)]- apron_lower_back

leg_1 -[BR<SHELF_H DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<SHELF_H TB<0 D(:8x30)]- apron_lower_left

leg_2 -[BL<SHELF_H DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<SHELF_H TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top surface: the end boards rest on the front legs,
// the inner boards on the upper front apron
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_1
apron_upper_front -[RF<TOP_O2 BT<0 D(:8x30)]- top_2
apron_upper_front -[RF<TOP_O3 BT<0 D(:8x30)]- top_3
apron_upper_front -[RF<TOP_O4 BT<0 D(:8x30)]- top_4
apron_upper_front -[RF<TOP_O5 BT<0 D(:8x30)]- top_5
top_6 -[BD<0 TF<0 D(:8x30)]- leg_2

// ============================================
// Shelf: all boards rest on the lower front apron
// ============================================
apron_lower_front -[RF<SHELF_O1 BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<SHELF_O2 BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<SHELF_O3 BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<SHELF_O4 BT<0 D(:8x30)]- shelf_4

// ============================================
// Assembly: side frames, then the aprons that join them,
// the shelf boards, and the top boards last
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6
}
