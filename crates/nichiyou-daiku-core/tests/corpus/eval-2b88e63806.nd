// Side Table
// Overall size: 500mm (W) x 400mm (D) x 600mm (H)
// All 2x4 lumber; joints: 8x30 dowels
// 4 corner legs (wide face to the front), aprons flush with the leg tops,
// top boards running in the depth direction

// ============================================
// Dimensions
// ============================================
WIDTH = 500
DEPTH = 400
HEIGHT = 600

BOARD_W = 89          // 2x4 wide side
BOARD_T = 38          // 2x4 narrow side
LEG_LEN = HEIGHT - BOARD_T              // top boards lie flat on the leg tops
SIDE_FLUSH = LEG_LEN - BOARD_W          // point 89mm below the leg top -> apron hangs flush

// ============================================
// Legs: leg_fl front-left, leg_fr front-right,
//       leg_bl back-left, leg_br back-right
// ============================================
(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Aprons: flush with the tops of the legs
// Front/back run between the legs' wide faces: WIDTH - 2 x 89
// Side aprons run between the legs' narrow faces: DEPTH - 2 x 38
// ============================================
(apron_front:2x4 =WIDTH - 2*BOARD_W)
(apron_back:2x4 =WIDTH - 2*BOARD_W)
(apron_left:2x4 =DEPTH - 2*BOARD_T)
(apron_right:2x4 =DEPTH - 2*BOARD_T)

// ============================================
// Top boards: DEPTH long, 5 boards of 89 across the width,
// 4 gaps of TOP_GAP = (500 - 445) / 4 = 13.75
// ============================================
TOP_GAP = (WIDTH - 5*BOARD_W) / 4
O2 = TOP_GAP
O3 = O2 + BOARD_W + TOP_GAP
O4 = O3 + BOARD_W + TOP_GAP
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front/back aprons: end into the legs' narrow faces, flush with the tops
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons: end into the legs' wide faces, flush with the tops
// ============================================
leg_fl -[BR<SIDE_FLUSH DB<0 D(:8x30)]- apron_left
leg_bl -[FR<SIDE_FLUSH TB<0 D(:8x30)]- apron_left
leg_fr -[BL<SIDE_FLUSH DF<0 D(:8x30)]- apron_right
leg_br -[FL<SIDE_FLUSH TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards: the outer boards sit on the legs, the inner ones on
// the front apron, one gap + one board apart (offsets 13.75, 116.5, 219.25)
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<O2 BT<0 D(:8x30)]- top_2
apron_front -[RF<O3 BT<0 D(:8x30)]- top_3
apron_front -[RF<O4 BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
