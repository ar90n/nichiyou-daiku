// Workbench
// Overall size: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 throughout
// Frame: 8x30 dowels, top and lower shelf boards: screws
// Lower shelf: underside 150mm above the floor

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
BOARD_WIDTH = 89
BOARD_THICKNESS = 38

// Legs: overall height minus the 2x4 top boards
TOP_THICKNESS = 38
LEG_LENGTH = HEIGHT - TOP_THICKNESS

// Front/back aprons run between the legs' 89mm faces
FRONT_APRON_LENGTH = WIDTH - 2 * BOARD_WIDTH
// Side aprons run between the legs' 38mm faces
SIDE_APRON_LENGTH = DEPTH - 2 * BOARD_THICKNESS

// Lower shelf: underside 150 above the floor; aprons hang below the boards
SHELF_HEIGHT = 150
LOWER_APRON_TOP = SHELF_HEIGHT
LOWER_APRON_BOTTOM = SHELF_HEIGHT - BOARD_WIDTH
LOWER_FRONT_OFFSET = LEG_LENGTH - LOWER_APRON_TOP
LOWER_SIDE_OFFSET = LOWER_APRON_BOTTOM
UPPER_SIDE_OFFSET = LEG_LENGTH - BOARD_WIDTH

// Top: 13 boards x 89 = 1157, gap (1200 - 1157) / 12 = 3.583
N_TOP = 13
TOP_GAP = (WIDTH - N_TOP * BOARD_WIDTH) / (N_TOP - 1)

// Lower shelf: 11 boards x 89 = 979 inside 1022, gap 43 / 12 = 3.583
N_SHELF = 11
SHELF_GAP = (FRONT_APRON_LENGTH - N_SHELF * BOARD_WIDTH) / (N_SHELF + 1)

// ============================================
// Legs (4x)
// ============================================
(leg_1:2x4 =LEG_LENGTH)
(leg_2:2x4 =LEG_LENGTH)
(leg_3:2x4 =LEG_LENGTH)
(leg_4:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons, flush with the leg tops
// ============================================
(apron_upper_front:2x4 =FRONT_APRON_LENGTH)
(apron_upper_back:2x4 =FRONT_APRON_LENGTH)
(apron_upper_left:2x4 =SIDE_APRON_LENGTH)
(apron_upper_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Lower aprons, supporting the lower shelf
// ============================================
(apron_lower_front:2x4 =FRONT_APRON_LENGTH)
(apron_lower_back:2x4 =FRONT_APRON_LENGTH)
(apron_lower_left:2x4 =SIDE_APRON_LENGTH)
(apron_lower_right:2x4 =SIDE_APRON_LENGTH)

// ============================================
// Top boards (2x4, depth direction)
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Lower shelf boards (2x4, depth direction)
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper frame: front/back aprons doweled into the legs' narrow faces
// ============================================
leg_1 -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_2 -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_3 -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_4 -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Upper side aprons doweled into the legs' wide faces
leg_1 -[BR<UPPER_SIDE_OFFSET DB<0 D(:8x30)]- apron_upper_left
leg_3 -[FR<UPPER_SIDE_OFFSET TB<0 D(:8x30)]- apron_upper_left
leg_2 -[BL<UPPER_SIDE_OFFSET DF<0 D(:8x30)]- apron_upper_right
leg_4 -[FL<UPPER_SIDE_OFFSET TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower frame: front/back aprons doweled into the legs' narrow faces
// ============================================
leg_1 -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_front
leg_2 -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_front
leg_3 -[LB>LOWER_FRONT_OFFSET DB>0 D(:8x30)]- apron_lower_back
leg_4 -[RF>LOWER_FRONT_OFFSET TF>0 D(:8x30)]- apron_lower_back

// Lower side aprons, level with the lower front/back aprons
leg_1 -[BR<LOWER_SIDE_OFFSET DB<0 D(:8x30)]- apron_lower_left
leg_3 -[FR<LOWER_SIDE_OFFSET TB<0 D(:8x30)]- apron_lower_left
leg_2 -[BL<LOWER_SIDE_OFFSET DF<0 D(:8x30)]- apron_lower_right
leg_4 -[FL<LOWER_SIDE_OFFSET TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Lower shelf boards screwed to the lower front apron
// Board k starts at SHELF_GAP + (k - 1) * (BOARD_WIDTH + SHELF_GAP)
// ============================================
apron_lower_front -[RF<(SHELF_GAP + (1 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_1
apron_lower_front -[RF<(SHELF_GAP + (2 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_2
apron_lower_front -[RF<(SHELF_GAP + (3 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_3
apron_lower_front -[RF<(SHELF_GAP + (4 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_4
apron_lower_front -[RF<(SHELF_GAP + (5 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_5
apron_lower_front -[RF<(SHELF_GAP + (6 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_6
apron_lower_front -[RF<(SHELF_GAP + (7 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_7
apron_lower_front -[RF<(SHELF_GAP + (8 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_8
apron_lower_front -[RF<(SHELF_GAP + (9 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_9
apron_lower_front -[RF<(SHELF_GAP + (10 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_10
apron_lower_front -[RF<(SHELF_GAP + (11 - 1) * (BOARD_WIDTH + SHELF_GAP)) BT<0 S(Slim:3.8x65)]- shelf_11

// ============================================
// Top boards screwed down through the board
// Outer boards sit on the legs; inner boards on the upper front apron
// Board k starts at (k - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH
// from the apron end
// ============================================
leg_1 -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<((2 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<((3 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_3
apron_upper_front -[RF<((4 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_4
apron_upper_front -[RF<((5 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_5
apron_upper_front -[RF<((6 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_6
apron_upper_front -[RF<((7 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_7
apron_upper_front -[RF<((8 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_8
apron_upper_front -[RF<((9 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_9
apron_upper_front -[RF<((10 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_10
apron_upper_front -[RF<((11 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_11
apron_upper_front -[RF<((12 - 1) * (BOARD_WIDTH + TOP_GAP) - BOARD_WIDTH) BT<0 S(Slim:3.8x65)]- top_12
leg_2 -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Assembly: side frames, front/back aprons, shelf, top
// ============================================
steps {
  "Left frame":  leg_1, leg_3, apron_upper_left, apron_lower_left
  "Right frame": leg_2, leg_4, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
