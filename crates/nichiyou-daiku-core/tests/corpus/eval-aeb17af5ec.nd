// Display Shelf (飾り棚)
// Dimensions: 450mm (W) x 140mm (D) x 600mm (H)
// Material: 1x6 only (sides, bottom/middle/top shelves)
// Joints: Slim 3.3x40 screws
//
// Structure:
// - 2 upright sides (1x6, standing on its 140mm face toward the front)
// - 3 shelf boards (bottom, middle, top) spanning between the sides,
//   evenly spaced: equal 271.5mm gaps, bottom flush with the floor,
//   top flush with the sides' tops

WIDTH = 450
DEPTH = 140
HEIGHT = 600
THICKNESS = 19   // 1x6 thickness

// ============================================
// Sides (2x) - full height, depth = 1x6 width (140mm)
// ============================================
(side_l:1x6 =HEIGHT)
(side_r:1x6 =HEIGHT)

// ============================================
// Shelves (3x): bottom, middle, top
// Length = WIDTH - 2 x THICKNESS = 450 - 38 = 412mm
// ============================================
SHELF_LENGTH = WIDTH - 2 * THICKNESS
(shelf_bottom:1x6 =SHELF_LENGTH)
(shelf_middle:1x6 =SHELF_LENGTH)
(shelf_top:1x6 =SHELF_LENGTH)

// Even spacing: gap = (600 - 3x19) / 2 = 271.5mm
// bottom: 0..19, middle: 290.5..309.5, top: 581..600
GAP = (HEIGHT - 3 * THICKNESS) / 2
MID_OFFSET = THICKNESS + GAP

// ============================================
// Bottom shelf: underside flush with the floor
// ============================================
shelf_bottom -[DL<0 BL<0 S(Slim:3.3x40)]- side_l
shelf_bottom -[TL<0 FL<0 S(Slim:3.3x40)]- side_r

// ============================================
// Middle shelf: underside at MID_OFFSET above the floor
// ============================================
shelf_middle -[DL<0 BL<MID_OFFSET S(Slim:3.3x40)]- side_l
shelf_middle -[TL<0 FL<MID_OFFSET S(Slim:3.3x40)]- side_r

// ============================================
// Top shelf: underside flush with the sides' tops
// ============================================
shelf_top -[DL<0 BL>THICKNESS S(Slim:3.3x40)]- side_l
shelf_top -[TL<0 FL>THICKNESS S(Slim:3.3x40)]- side_r

// ============================================
// Assembly order
// ============================================
steps {
  "Bottom shelf on the left side": side_l, shelf_bottom
  "Right side": side_r
  "Middle shelf": shelf_middle
  "Top shelf": shelf_top
}
