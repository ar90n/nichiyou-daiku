// Children's Step Stool
// Overall: 400mm (W) x 300mm (D) x 300mm (H)
// Material: 2x4 throughout (legs, aprons, top boards)
// Joints: 8x30 dowels in the frame, top boards screwed down
//
// Structure:
// - 4 legs with their wide (89mm) face to the front
// - Upper aprons flush with the leg tops
// - Lower aprons 80mm above the floor (stops the stool racking)
// - 2x4 top boards (38mm) running front to back

// ============================================
// Overall sizes
// ============================================
WIDTH  = 400
DEPTH  = 300
HEIGHT = 300
TOP_THICK = 38
LOWER_H   = 80

// ============================================
// Legs (4x) - height minus the 38mm top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left,  leg_br: back-right
// ============================================
LEG = HEIGHT - TOP_THICK
(leg_fl:2x4 =LEG)
(leg_fr:2x4 =LEG)
(leg_bl:2x4 =LEG)
(leg_br:2x4 =LEG)

// ============================================
// Aprons
// Front/back run between the legs' 89mm sides: WIDTH - 2*89
// Side aprons run between the legs' 38mm sides: DEPTH - 2*38
// ============================================
APRON_FB = WIDTH - 2 * 89
APRON_LR = DEPTH - 2 * 38
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4  =APRON_FB)
(apron_upper_left:2x4  =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4  =APRON_FB)
(apron_lower_left:2x4  =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, depth direction)
// 4 boards: 4*89 = 356, gaps (WIDTH - 356) / 3
// ============================================
TOP_GAP     = (WIDTH - 4 * 89) / 3
TOP_INNER_1 = TOP_GAP
TOP_INNER_2 = 2 * (89 + TOP_GAP) - 89
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Side aprons: bottom edge 89mm below the leg top
UPPER_SIDE_FROM_BOTTOM = LEG - 89
leg_fl -[BR<UPPER_SIDE_FROM_BOTTOM DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<UPPER_SIDE_FROM_BOTTOM TB<0 D(:8x30)]- apron_upper_left
leg_fr -[BL<UPPER_SIDE_FROM_BOTTOM DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<UPPER_SIDE_FROM_BOTTOM TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (bottom edge 80mm above the floor)
// ============================================
LOWER_FB_FROM_TOP = LEG - LOWER_H - 89
leg_fl -[LB>LOWER_FB_FROM_TOP DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER_FB_FROM_TOP TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>LOWER_FB_FROM_TOP DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER_FB_FROM_TOP TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<LOWER_H DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<LOWER_H TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<LOWER_H DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<LOWER_H TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top boards: outer boards on the legs, inner boards on the front apron
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<TOP_INNER_1 BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<TOP_INNER_2 BT<0 S(Slim:3.8x65)]- top_3
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_4

// ============================================
// Assembly: the two side frames, the aprons joining them, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Top":         top_1, top_2, top_3, top_4
}
