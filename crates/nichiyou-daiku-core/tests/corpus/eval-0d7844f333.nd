// 飾り棚 (Display Shelf)
// 幅 450 × 奥行 140 × 高さ 600 mm
// 材料: 1x6 のみ（側板2枚、棚板3枚、背筋交い2枚）
// 接合: 棚板と側板は Slim 3.3x30 ビス、背筋交いは 8x30 ダボ
//
// 棚板3枚（天板・中板・地板）は等間隔。棚板中心の間隔は 290.5mm。
// 側板: 600 × 140 × 19
// 棚板: 412 × 140 × 19（幅450 - 側板厚19×2）
// 正味開口: (600 - 19×3) / 2 = 271.5mm
// 背筋交い: 各開口に1枚、左右対称に20mmずらして取付

WIDTH = 450
DEPTH = 140
HEIGHT = 600
THICK = 19

SHELF_LENGTH = WIDTH - 2 * THICK
OPENING = (HEIGHT - 3 * THICK) / 2
MIDDLE_H = THICK + OPENING
TOP_H = HEIGHT - THICK

BRACE_WIDTH = 140
BRACE_OFFSET = (SHELF_LENGTH - BRACE_WIDTH) / 2
BRACE_SHIFT = 20

// ============================================
// 背筋交い (2x) - 各開口の高さ271.5
// ============================================
(back_lower:1x6 =OPENING)
(back_upper:1x6 =OPENING)

// ============================================
// 側板 (2x) - 高さ600、奥行140
// ============================================
(side_l:1x6 =HEIGHT)
(side_r:1x6 =HEIGHT)

// ============================================
// 棚板 (3x) - 側板の内側に収まる長さ412
// 地板は床上0、中板は290.5、天板は581（天端600）
// ============================================
(shelf_bottom:1x6 =SHELF_LENGTH)
(shelf_middle:1x6 =SHELF_LENGTH)
(shelf_top:1x6 =SHELF_LENGTH)

// ============================================
// 棚板と側板（側板の外側からビス）
// BL<h> / FL<h>: 棚板下面の床上高さ h
// ============================================
shelf_bottom -[DL<0 BL<0 S(Slim:3.3x30)]- side_l
shelf_bottom -[TL<0 FL<0 S(Slim:3.3x30)]- side_r

shelf_middle -[DL<0 BL<MIDDLE_H S(Slim:3.3x30)]- side_l
shelf_middle -[TL<0 FL<MIDDLE_H S(Slim:3.3x30)]- side_r

shelf_top -[DL<0 BL<TOP_H S(Slim:3.3x30)]- side_l
shelf_top -[TL<0 FL<TOP_H S(Slim:3.3x30)]- side_r

// ============================================
// 背筋交い（背面、8x30ダボ）
// ============================================
back_lower -[DB<0 FL<(BRACE_OFFSET - BRACE_SHIFT) D(:8x30)]- shelf_bottom
back_lower -[TB<0 BL<(BRACE_OFFSET - BRACE_SHIFT) D(:8x30)]- shelf_middle

back_upper -[DB<0 FL<(BRACE_OFFSET + BRACE_SHIFT) D(:8x30)]- shelf_middle
back_upper -[TB<0 BL<(BRACE_OFFSET + BRACE_SHIFT) D(:8x30)]- shelf_top

// ============================================
// 組立: 地板と側板 → 中板と下筋交い → 天板と上筋交い
// ============================================
steps {
  "Bottom shelf and sides": side_l, side_r, shelf_bottom
  "Middle shelf and lower brace": shelf_middle, back_lower
  "Top shelf and upper brace": shelf_top, back_upper
}
