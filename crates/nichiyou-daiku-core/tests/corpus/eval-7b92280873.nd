// 本棚 (Bookshelf) — 1x8材のみ
// 全体寸法: 幅600 × 奥行184 × 高さ900 mm
// 材料: 1x8 (184 x 19) のみ
// 構造: 側板2枚 (縦に立てる) + 棚板4枚 (天板・地板を含む)
// 棚板は寝かせて敷き、幅184mmが奥行き方向にくる (奥行=1x8の幅)
// 接合: 棚板の端部を側板の内側の広い面に当て、細ネジ (Slim 3.3x50) で側板から固定

// ============================================
// 寸法変数
// ============================================
WIDTH = 600                      // 全体幅
HEIGHT = 900                     // 全体高さ
THICK = 19                       // 1x8の厚み
SHELF_LEN = WIDTH - 2 * THICK    // 棚板の長さ = 562
GAP = (HEIGHT - THICK) / 3       // 棚板4枚を等間隔に割る (下面間隔 293.67)

// ============================================
// 部材
// ============================================
// 側板 (縦)
(side_l:1x8 =HEIGHT)   // 左側板
(side_r:1x8 =HEIGHT)   // 右側板

// 棚板 4枚 (下から上へ)
// 棚板下面の高さ: 0, GAP, 2xGAP, 3xGAP (=881) → 天板上面 = 900 = 側板天端
(shelf_1:1x8 =SHELF_LEN)   // 地板
(shelf_2:1x8 =SHELF_LEN)   // 中段1
(shelf_3:1x8 =SHELF_LEN)   // 中段2
(shelf_4:1x8 =SHELF_LEN)   // 天板

// ============================================
// 接合 (棚板の端を側板の広い面に当て、ネジ留め)
// ============================================
shelf_1 -[DL<0 BL<0 S(Slim:3.3x50)]- side_l
shelf_1 -[TL<0 FL<0 S(Slim:3.3x50)]- side_r

shelf_2 -[DL<0 BL<GAP S(Slim:3.3x50)]- side_l
shelf_2 -[TL<0 FL<GAP S(Slim:3.3x50)]- side_r

shelf_3 -[DL<0 BL<(2 * GAP) S(Slim:3.3x50)]- side_l
shelf_3 -[TL<0 FL<(2 * GAP) S(Slim:3.3x50)]- side_r

shelf_4 -[DL<0 BL<(3 * GAP) S(Slim:3.3x50)]- side_l
shelf_4 -[TL<0 FL<(3 * GAP) S(Slim:3.3x50)]- side_r

// ============================================
// 組立順序
// ============================================
steps {
  "左側板と地板": side_l, shelf_1
  "右側板":       side_r
  "中段の棚板":   shelf_2, shelf_3
  "天板":         shelf_4
}
