// Workbench
// Dimensions: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 frame, 2x4 top and shelf boards
// Joints: frame = Dowel 8x30, top and shelf = screws (Coarse 3.8x57)
// Lower shelf: underside 150mm above the floor

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
SHELF_HEIGHT = 150
TOP_THICKNESS = 38          // 2x4 top boards

LEG_LENGTH = HEIGHT - TOP_THICKNESS          // 850 - 38 = 812
FRONT_APRON = WIDTH - 2 * 89                 // 1200 - 178 = 1022
SIDE_APRON = DEPTH - 2 * 38                  // 600 - 76 = 524

// Lower apron hangs 89mm below the point on the leg (see Lower Aprons pattern)
LOWER_OFFSET = LEG_LENGTH - SHELF_HEIGHT - 89 // 812 - 150 - 89 = 573

// Top boards: 13 boards (13*89 = 1157 <= 1200); 2 sit on the front legs,
// 11 sit on apron_front, evenly spaced with gap = (1200 - 1157) / 12
GAP_TOP = (WIDTH - 13 * 89) / 12
TOP_PITCH = 89 + GAP_TOP
TOP_OFF_2 = 1 * TOP_PITCH - 89
TOP_OFF_3 = 2 * TOP_PITCH - 89
TOP_OFF_4 = 3 * TOP_PITCH - 89
TOP_OFF_5 = 4 * TOP_PITCH - 89
TOP_OFF_6 = 5 * TOP_PITCH - 89
TOP_OFF_7 = 6 * TOP_PITCH - 89
TOP_OFF_8 = 7 * TOP_PITCH - 89
TOP_OFF_9 = 8 * TOP_PITCH - 89
TOP_OFF_10 = 9 * TOP_PITCH - 89
TOP_OFF_11 = 10 * TOP_PITCH - 89
TOP_OFF_12 = 11 * TOP_PITCH - 89

// Shelf boards: the legs continue above the shelf, so all 11 boards
// (11*89 = 979 <= 1022 = FRONT_APRON) sit between the legs on lower_front
GAP_SHELF = (FRONT_APRON - 11 * 89) / 12
SHELF_PITCH = 89 + GAP_SHELF
SHELF_OFF_1 = GAP_SHELF
SHELF_OFF_2 = GAP_SHELF + 1 * SHELF_PITCH
SHELF_OFF_3 = GAP_SHELF + 2 * SHELF_PITCH
SHELF_OFF_4 = GAP_SHELF + 3 * SHELF_PITCH
SHELF_OFF_5 = GAP_SHELF + 4 * SHELF_PITCH
SHELF_OFF_6 = GAP_SHELF + 5 * SHELF_PITCH
SHELF_OFF_7 = GAP_SHELF + 6 * SHELF_PITCH
SHELF_OFF_8 = GAP_SHELF + 7 * SHELF_PITCH
SHELF_OFF_9 = GAP_SHELF + 8 * SHELF_PITCH
SHELF_OFF_10 = GAP_SHELF + 9 * SHELF_PITCH
SHELF_OFF_11 = GAP_SHELF + 10 * SHELF_PITCH

// ============================================
// Legs (4x): leg_fl front-left, leg_fr front-right, leg_bl back-left, leg_br back-right
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Upper aprons (flush with the top)
// ============================================
(apron_front:2x4 =FRONT_APRON)
(apron_back:2x4 =FRONT_APRON)
(apron_left:2x4 =SIDE_APRON)
(apron_right:2x4 =SIDE_APRON)

// ============================================
// Lower aprons (shelf support, underside 150mm above the floor)
// ============================================
(lower_front:2x4 =FRONT_APRON)
(lower_back:2x4 =FRONT_APRON)
(lower_left:2x4 =SIDE_APRON)
(lower_right:2x4 =SIDE_APRON)

// ============================================
// Shelf boards (11x), running front to back, resting on lower_front
// ============================================
(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Top boards (13x), running front to back; the two outer boards sit on the
// front legs, the rest on apron_front
// ============================================
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Upper frame: front/back aprons end into the legs' narrow faces,
// flush with the legs' front faces
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// Upper frame: side aprons end into the legs' wide faces, flush with the legs' outer sides
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Lower frame: same joints as the upper frame, offset down the legs
// ============================================
leg_fl -[LB>LOWER_OFFSET DB>0 D(:8x30)]- lower_front
leg_fr -[RF>LOWER_OFFSET TF>0 D(:8x30)]- lower_front
leg_bl -[LB>LOWER_OFFSET DB>0 D(:8x30)]- lower_back
leg_br -[RF>LOWER_OFFSET TF>0 D(:8x30)]- lower_back

leg_fl -[BR>LOWER_OFFSET DB>0 D(:8x30)]- lower_left
leg_bl -[FR>LOWER_OFFSET TB>0 D(:8x30)]- lower_left
leg_fr -[BL>LOWER_OFFSET DF>0 D(:8x30)]- lower_right
leg_br -[FL>LOWER_OFFSET TF>0 D(:8x30)]- lower_right

// ============================================
// Shelf boards screwed down onto lower_front
// ============================================
lower_front -[RF<SHELF_OFF_1 BT<0 S(Coarse:3.8x57)]- shelf_1
lower_front -[RF<SHELF_OFF_2 BT<0 S(Coarse:3.8x57)]- shelf_2
lower_front -[RF<SHELF_OFF_3 BT<0 S(Coarse:3.8x57)]- shelf_3
lower_front -[RF<SHELF_OFF_4 BT<0 S(Coarse:3.8x57)]- shelf_4
lower_front -[RF<SHELF_OFF_5 BT<0 S(Coarse:3.8x57)]- shelf_5
lower_front -[RF<SHELF_OFF_6 BT<0 S(Coarse:3.8x57)]- shelf_6
lower_front -[RF<SHELF_OFF_7 BT<0 S(Coarse:3.8x57)]- shelf_7
lower_front -[RF<SHELF_OFF_8 BT<0 S(Coarse:3.8x57)]- shelf_8
lower_front -[RF<SHELF_OFF_9 BT<0 S(Coarse:3.8x57)]- shelf_9
lower_front -[RF<SHELF_OFF_10 BT<0 S(Coarse:3.8x57)]- shelf_10
lower_front -[RF<SHELF_OFF_11 BT<0 S(Coarse:3.8x57)]- shelf_11

// ============================================
// Top boards screwed down: outer boards onto the front legs, inner boards onto apron_front
// ============================================
leg_fl -[TF<0 BD<0 S(Coarse:3.8x57)]- top_1
apron_front -[RF<TOP_OFF_2 BT<0 S(Coarse:3.8x57)]- top_2
apron_front -[RF<TOP_OFF_3 BT<0 S(Coarse:3.8x57)]- top_3
apron_front -[RF<TOP_OFF_4 BT<0 S(Coarse:3.8x57)]- top_4
apron_front -[RF<TOP_OFF_5 BT<0 S(Coarse:3.8x57)]- top_5
apron_front -[RF<TOP_OFF_6 BT<0 S(Coarse:3.8x57)]- top_6
apron_front -[RF<TOP_OFF_7 BT<0 S(Coarse:3.8x57)]- top_7
apron_front -[RF<TOP_OFF_8 BT<0 S(Coarse:3.8x57)]- top_8
apron_front -[RF<TOP_OFF_9 BT<0 S(Coarse:3.8x57)]- top_9
apron_front -[RF<TOP_OFF_10 BT<0 S(Coarse:3.8x57)]- top_10
apron_front -[RF<TOP_OFF_11 BT<0 S(Coarse:3.8x57)]- top_11
apron_front -[RF<TOP_OFF_12 BT<0 S(Coarse:3.8x57)]- top_12
leg_fr -[TF<0 BD<0 S(Coarse:3.8x57)]- top_13

steps {
  "Left frame": leg_fl, leg_bl, apron_left, lower_left
  "Right frame": leg_fr, leg_br, apron_right, lower_right
  "Join the frames": apron_front, apron_back, lower_front, lower_back
  "Shelf": shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top": top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
