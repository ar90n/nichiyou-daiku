// 2x4 / 1x4 Bench
// Overall: 900mm (W) x 300mm (D) x 420mm (H)
// Frame: 2x4 legs and aprons with 8x30 dowels
// Seat: 1x4 boards running along the length, screwed down with Slim 3.3x45

WIDTH = 900
DEPTH = 300
HEIGHT = 420
TOP_THICKNESS = 19
BOARD_WIDTH = 89
LEG_LENGTH = HEIGHT - TOP_THICKNESS
SEAT_GAP = (DEPTH - 3 * BOARD_WIDTH) / 2

// ============================================
// Legs (4x) - 420mm height minus the 19mm seat boards
// ============================================
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons (flush with the leg tops)
// Front/back run between the legs' 89mm faces: 900 - 2x89 = 722
// Left/right run between the legs' 38mm faces: 300 - 2x38 = 224
// ============================================
(apron_front:2x4 =WIDTH - 2 * 89)
(apron_back:2x4 =WIDTH - 2 * 89)
(apron_left:2x4 =DEPTH - 2 * 38)
(apron_right:2x4 =DEPTH - 2 * 38)

// ============================================
// Seat boards (1x4, running along the length)
// 3 boards: 3 x 89 = 267, two gaps of (300 - 267) / 2 = 16.5
// The outer boards sit on the leg tops, the middle one on the side aprons
// ============================================
(seat_back:1x4 =WIDTH)
(seat_mid:1x4 =WIDTH)
(seat_front:1x4 =WIDTH)

// ============================================
// Front/back aprons into the legs' narrow faces
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Side aprons into the legs' wide faces
// ============================================
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_left
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_right

// ============================================
// Seat boards screwed down through the board
// Outer boards: points 19mm in from the leg back/front faces
// Middle board: into both side aprons at mid depth
// ============================================
leg_fl -[TR<19 BT<70 S(Slim:3.3x45)]- seat_front
leg_fr -[TL<19 BD<70 S(Slim:3.3x45)]- seat_front
leg_bl -[TR<19 BT<19 S(Slim:3.3x45)]- seat_back
leg_br -[TL<19 BD<19 S(Slim:3.3x45)]- seat_back

apron_right -[RF<112 BD<44.5 S(Slim:3.3x45)]- seat_mid
apron_left -[RB<112 BT<44.5 S(Slim:3.3x45)]- seat_mid

// ============================================
// Assembly: side frames, front/back aprons, seat
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Seat":        seat_back, seat_mid, seat_front
}
