// Workbench
// Dimensions: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 (legs, aprons, top, shelf)
// Joints: frame dowelled 8x30; top fixed with screws (Coarse 3.8x57)
//
// Structure:
// - 4 legs at corners
// - Upper aprons flush with the leg tops
// - Lower aprons with their underside 150mm above the floor (shelf height)
// - Top surface boards (2x4) on the legs and upper front apron, screwed down
// - Shelf boards (2x4) on the lower front apron, between the legs, dowelled

WIDTH = 1200
DEPTH = 600
HEIGHT = 850
SHELF_HEIGHT = 150          // underside of the lower shelf, above the floor
TOP_THICKNESS = 38          // 2x4 top boards, standing on edge

// ============================================
// Legs (4x) - height minus the top boards' thickness
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
LEG_LEN = HEIGHT - TOP_THICKNESS   // 812

(leg_fl:2x4 =LEG_LEN)
(leg_fr:2x4 =LEG_LEN)
(leg_bl:2x4 =LEG_LEN)
(leg_br:2x4 =LEG_LEN)

// ============================================
// Upper aprons (flush with the leg tops)
// Front/back run between the legs' 89mm sides: WIDTH - 2*89
// Left/right run between the legs' 38mm sides: DEPTH - 2*38
// ============================================
APRON_FB_LEN = WIDTH - 2 * 89   // 1022
APRON_LR_LEN = DEPTH - 2 * 38   // 524

(apron_upper_front:2x4 =APRON_FB_LEN)
(apron_upper_back:2x4 =APRON_FB_LEN)
(apron_upper_left:2x4 =APRON_LR_LEN)
(apron_upper_right:2x4 =APRON_LR_LEN)

// ============================================
// Lower aprons (underside SHELF_HEIGHT above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB_LEN)
(apron_lower_back:2x4 =APRON_FB_LEN)
(apron_lower_left:2x4 =APRON_LR_LEN)
(apron_lower_right:2x4 =APRON_LR_LEN)

// ============================================
// Top boards (2x4, depth direction), screwed down
// 13 boards x 89 = 1157, leaving a total gap of WIDTH - 1157 = 43
// across 12 gaps: TOP_GAP = 43 / 12
// ============================================
TOP_GAP = (WIDTH - 13 * 89) / 12

(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)
(top_6:2x4 =DEPTH)
(top_7:2x4 =DEPTH)
(top_8:2x4 =DEPTH)
(top_9:2x4 =DEPTH)
(top_10:2x4 =DEPTH)
(top_11:2x4 =DEPTH)
(top_12:2x4 =DEPTH)
(top_13:2x4 =DEPTH)

// ============================================
// Shelf boards (2x4, depth direction, on the lower front apron)
// They fit between the legs: APRON_FB_LEN (1022mm) inside
// 11 boards x 89 = 979, leaving a total gap of 1022 - 979 = 43
// across 12 gaps: SHELF_GAP = 43 / 12
// ============================================
SHELF_GAP = (APRON_FB_LEN - 11 * 89) / 12

(shelf_1:2x4 =DEPTH)
(shelf_2:2x4 =DEPTH)
(shelf_3:2x4 =DEPTH)
(shelf_4:2x4 =DEPTH)
(shelf_5:2x4 =DEPTH)
(shelf_6:2x4 =DEPTH)
(shelf_7:2x4 =DEPTH)
(shelf_8:2x4 =DEPTH)
(shelf_9:2x4 =DEPTH)
(shelf_10:2x4 =DEPTH)
(shelf_11:2x4 =DEPTH)

// ============================================
// Upper apron connections (flush with the leg tops), dowelled
// ============================================
UPPER_SIDE_OFFSET = LEG_LEN - 89   // 723: up the leg, flush with the top

leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

leg_fl -[BR<(UPPER_SIDE_OFFSET) DB<0 D(:8x30)]- apron_upper_left
leg_bl -[FR<(UPPER_SIDE_OFFSET) TB<0 D(:8x30)]- apron_upper_left
leg_fr -[BL<(UPPER_SIDE_OFFSET) DF<0 D(:8x30)]- apron_upper_right
leg_br -[FL<(UPPER_SIDE_OFFSET) TF<0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (underside SHELF_HEIGHT above the floor), dowelled
// Front/back measured down from the leg top: LEG_LEN - SHELF_HEIGHT - 89
// Left/right measured up from the leg bottom: SHELF_HEIGHT
// ============================================
LOWER_FB_OFFSET = LEG_LEN - SHELF_HEIGHT - 89   // 573
LOWER_LR_OFFSET = SHELF_HEIGHT                  // 150

leg_fl -[LB>(LOWER_FB_OFFSET) DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>(LOWER_FB_OFFSET) TF>0 D(:8x30)]- apron_lower_front
leg_bl -[LB>(LOWER_FB_OFFSET) DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>(LOWER_FB_OFFSET) TF>0 D(:8x30)]- apron_lower_back

leg_fl -[BR<(LOWER_LR_OFFSET) DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<(LOWER_LR_OFFSET) TB<0 D(:8x30)]- apron_lower_left
leg_fr -[BL<(LOWER_LR_OFFSET) DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<(LOWER_LR_OFFSET) TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top board connections, screwed down (Coarse 3.8x57: through the
// 38mm-thick top board into the leg/apron below)
// End boards sit on the front legs; inner boards sit on the upper
// front apron, one gap + one board apart.
// ============================================
leg_fl -[TF<0 BD<0 S(Coarse:3.8x57)]- top_1
apron_upper_front -[RF<(TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_2
apron_upper_front -[RF<(89 + 2 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_3
apron_upper_front -[RF<(2 * 89 + 3 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_4
apron_upper_front -[RF<(3 * 89 + 4 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_5
apron_upper_front -[RF<(4 * 89 + 5 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_6
apron_upper_front -[RF<(5 * 89 + 6 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_7
apron_upper_front -[RF<(6 * 89 + 7 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_8
apron_upper_front -[RF<(7 * 89 + 8 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_9
apron_upper_front -[RF<(8 * 89 + 9 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_10
apron_upper_front -[RF<(9 * 89 + 10 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_11
apron_upper_front -[RF<(10 * 89 + 11 * TOP_GAP) BT<0 S(Coarse:3.8x57)]- top_12
leg_fr -[TF<0 BD<0 S(Coarse:3.8x57)]- top_13

// ============================================
// Shelf board connections, dowelled (part of the frame)
// All boards sit on the lower front apron, one gap + one board apart.
// ============================================
apron_lower_front -[RF<(SHELF_GAP) BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<(89 + 2 * SHELF_GAP) BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<(2 * 89 + 3 * SHELF_GAP) BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<(3 * 89 + 4 * SHELF_GAP) BT<0 D(:8x30)]- shelf_4
apron_lower_front -[RF<(4 * 89 + 5 * SHELF_GAP) BT<0 D(:8x30)]- shelf_5
apron_lower_front -[RF<(5 * 89 + 6 * SHELF_GAP) BT<0 D(:8x30)]- shelf_6
apron_lower_front -[RF<(6 * 89 + 7 * SHELF_GAP) BT<0 D(:8x30)]- shelf_7
apron_lower_front -[RF<(7 * 89 + 8 * SHELF_GAP) BT<0 D(:8x30)]- shelf_8
apron_lower_front -[RF<(8 * 89 + 9 * SHELF_GAP) BT<0 D(:8x30)]- shelf_9
apron_lower_front -[RF<(9 * 89 + 10 * SHELF_GAP) BT<0 D(:8x30)]- shelf_10
apron_lower_front -[RF<(10 * 89 + 11 * SHELF_GAP) BT<0 D(:8x30)]- shelf_11

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
