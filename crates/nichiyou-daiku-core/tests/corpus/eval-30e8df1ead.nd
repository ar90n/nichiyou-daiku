// Workbench
// Dimensions: 1200mm (W) x 600mm (D) x 850mm (H)
// Material: 2x4 throughout
// Joints: Dowel 8x30 for the frame and shelf, screws Slim 3.8x65 for the top
//
// Structure:
// - 4 legs at the corners, wide faces to the front
// - Upper aprons flush with the leg tops
// - Lower aprons low on the legs so the shelf underside is 150mm above the floor
// - Top boards (2x4) running front to back, screwed down
// - Shelf boards (2x4) on the lower front apron, between the legs

W = 1200                          // overall width
DPT = 600                         // overall depth
HGT = 850                         // overall height
LEG = HGT - 38                    // legs: height minus the 38mm top boards
APRON_FB = W - 2 * 89             // front/back aprons between the legs' 89mm faces
APRON_LR = DPT - 2 * 38           // side aprons between the legs' 38mm faces
GAP_TOP = (W - 13 * 89) / 12      // top: 13 boards x 89 = 1157, 12 gaps
GAP_SHELF = (APRON_FB - 11 * 89) / 12  // shelf: 11 boards x 89 = 979, 12 gaps
UPPER = LEG - 89                  // upper aprons flush with the leg tops
LOWER = LEG - (150 - 89) - 89     // lower aprons lowered so the shelf boards'
                                  // underside is 150mm above the floor

// ============================================
// Legs (4x)
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
(leg_fl:2x4 =LEG)
(leg_fr:2x4 =LEG)
(leg_bl:2x4 =LEG)
(leg_br:2x4 =LEG)

// ============================================
// Upper aprons (flush with the leg tops)
// ============================================
(apron_upper_front:2x4 =APRON_FB)
(apron_upper_back:2x4 =APRON_FB)
(apron_upper_left:2x4 =APRON_LR)
(apron_upper_right:2x4 =APRON_LR)

// ============================================
// Lower aprons (bottom edge 150mm above the floor)
// ============================================
(apron_lower_front:2x4 =APRON_FB)
(apron_lower_back:2x4 =APRON_FB)
(apron_lower_left:2x4 =APRON_LR)
(apron_lower_right:2x4 =APRON_LR)

// ============================================
// Top boards (2x4, front to back, length = DPT)
// ============================================
(top_1:2x4 =DPT)
(top_2:2x4 =DPT)
(top_3:2x4 =DPT)
(top_4:2x4 =DPT)
(top_5:2x4 =DPT)
(top_6:2x4 =DPT)
(top_7:2x4 =DPT)
(top_8:2x4 =DPT)
(top_9:2x4 =DPT)
(top_10:2x4 =DPT)
(top_11:2x4 =DPT)
(top_12:2x4 =DPT)
(top_13:2x4 =DPT)

// ============================================
// Shelf boards (2x4, front to back, length = DPT)
// ============================================
(shelf_1:2x4 =DPT)
(shelf_2:2x4 =DPT)
(shelf_3:2x4 =DPT)
(shelf_4:2x4 =DPT)
(shelf_5:2x4 =DPT)
(shelf_6:2x4 =DPT)
(shelf_7:2x4 =DPT)
(shelf_8:2x4 =DPT)
(shelf_9:2x4 =DPT)
(shelf_10:2x4 =DPT)
(shelf_11:2x4 =DPT)

// ============================================
// Upper apron connections (flush with the leg tops, offset >0)
// ============================================

// Front upper apron
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_upper_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_upper_front

// Back upper apron
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_upper_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_upper_back

// Left upper apron
leg_fl -[BR>0 DB>0 D(:8x30)]- apron_upper_left
leg_bl -[FR>0 TB>0 D(:8x30)]- apron_upper_left

// Right upper apron
leg_fr -[BL>0 DF>0 D(:8x30)]- apron_upper_right
leg_br -[FL>0 TF>0 D(:8x30)]- apron_upper_right

// ============================================
// Lower apron connections (shelf underside 150mm above the floor:
// apron bottom edge at 61mm, offset from the leg top: LEG - 61 - 89 = LOWER)
// Front/back measure from the leg top; side aprons measure from the
// leg bottom: 61mm
// ============================================

// Front lower apron
leg_fl -[LB>LOWER DB>0 D(:8x30)]- apron_lower_front
leg_fr -[RF>LOWER TF>0 D(:8x30)]- apron_lower_front

// Back lower apron
leg_bl -[LB>LOWER DB>0 D(:8x30)]- apron_lower_back
leg_br -[RF>LOWER TF>0 D(:8x30)]- apron_lower_back

// Left lower apron
leg_fl -[BR<61 DB<0 D(:8x30)]- apron_lower_left
leg_bl -[FR<61 TB<0 D(:8x30)]- apron_lower_left

// Right lower apron
leg_fr -[BL<61 DF<0 D(:8x30)]- apron_lower_right
leg_br -[FL<61 TF<0 D(:8x30)]- apron_lower_right

// ============================================
// Top connections (screwed down)
// End boards sit on the leg tops. The inner boards sit on the upper
// front apron, one gap + one board apart:
// offset of board k = (k-2)*89 + (k-1)*GAP_TOP
// ============================================
leg_fl -[TF<0 BD<0 S(Slim:3.8x65)]- top_1
apron_upper_front -[RF<GAP_TOP BT<0 S(Slim:3.8x65)]- top_2
apron_upper_front -[RF<(89 + 2 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_3
apron_upper_front -[RF<(2 * 89 + 3 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_4
apron_upper_front -[RF<(3 * 89 + 4 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_5
apron_upper_front -[RF<(4 * 89 + 5 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_6
apron_upper_front -[RF<(5 * 89 + 6 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_7
apron_upper_front -[RF<(6 * 89 + 7 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_8
apron_upper_front -[RF<(7 * 89 + 8 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_9
apron_upper_front -[RF<(8 * 89 + 9 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_10
apron_upper_front -[RF<(9 * 89 + 10 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_11
apron_upper_front -[RF<(10 * 89 + 11 * GAP_TOP) BT<0 S(Slim:3.8x65)]- top_12
leg_fr -[TF<0 BD<0 S(Slim:3.8x65)]- top_13

// ============================================
// Shelf connections (doweled to the lower front apron)
// All boards sit between the legs, one gap + one board apart:
// offset of board k = (k-1)*89 + k*GAP_SHELF
// ============================================
apron_lower_front -[RF<GAP_SHELF BT<0 D(:8x30)]- shelf_1
apron_lower_front -[RF<(89 + 2 * GAP_SHELF) BT<0 D(:8x30)]- shelf_2
apron_lower_front -[RF<(2 * 89 + 3 * GAP_SHELF) BT<0 D(:8x30)]- shelf_3
apron_lower_front -[RF<(3 * 89 + 4 * GAP_SHELF) BT<0 D(:8x30)]- shelf_4
apron_lower_front -[RF<(4 * 89 + 5 * GAP_SHELF) BT<0 D(:8x30)]- shelf_5
apron_lower_front -[RF<(5 * 89 + 6 * GAP_SHELF) BT<0 D(:8x30)]- shelf_6
apron_lower_front -[RF<(6 * 89 + 7 * GAP_SHELF) BT<0 D(:8x30)]- shelf_7
apron_lower_front -[RF<(7 * 89 + 8 * GAP_SHELF) BT<0 D(:8x30)]- shelf_8
apron_lower_front -[RF<(8 * 89 + 9 * GAP_SHELF) BT<0 D(:8x30)]- shelf_9
apron_lower_front -[RF<(9 * 89 + 10 * GAP_SHELF) BT<0 D(:8x30)]- shelf_10
apron_lower_front -[RF<(10 * 89 + 11 * GAP_SHELF) BT<0 D(:8x30)]- shelf_11

// ============================================
// Assembly: the side frames, the aprons joining them, the shelf, the top
// ============================================
steps {
  "Left frame":  leg_fl, leg_bl, apron_upper_left, apron_lower_left
  "Right frame": leg_fr, leg_br, apron_upper_right, apron_lower_right
  "Join":        apron_upper_front, apron_upper_back, apron_lower_front, apron_lower_back
  "Shelf":       shelf_1, shelf_2, shelf_3, shelf_4, shelf_5, shelf_6, shelf_7, shelf_8, shelf_9, shelf_10, shelf_11
  "Top":         top_1, top_2, top_3, top_4, top_5, top_6, top_7, top_8, top_9, top_10, top_11, top_12, top_13
}
