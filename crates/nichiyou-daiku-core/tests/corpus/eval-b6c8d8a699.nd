// Side Table
// Dimensions: 500mm (W) x 400mm (D) x 600mm (H)
// Material: 2x4 frame, dowel 8x30 joints
// Legs: 4, corner inset. Aprons: flush with the leg tops.
// Top: 2x4 boards running in the depth direction.

WIDTH = 500
DEPTH = 400
HEIGHT = 600

// ============================================
// Legs (4x) - height minus the 38mm-thick top boards
// leg_fl: front-left, leg_fr: front-right
// leg_bl: back-left, leg_br: back-right
// ============================================
LEG_LENGTH = HEIGHT - 38
(leg_fl:2x4 =LEG_LENGTH)
(leg_fr:2x4 =LEG_LENGTH)
(leg_bl:2x4 =LEG_LENGTH)
(leg_br:2x4 =LEG_LENGTH)

// ============================================
// Aprons
// Front/back run between the legs' 89mm sides: WIDTH - 2*89
// Left/right run between the legs' 38mm sides: DEPTH - 2*38
// ============================================
APRON_FB_LENGTH = WIDTH - 2 * 89
APRON_LR_LENGTH = DEPTH - 2 * 38
(apron_front:2x4 =APRON_FB_LENGTH)
(apron_back:2x4 =APRON_FB_LENGTH)
(apron_left:2x4 =APRON_LR_LENGTH)
(apron_right:2x4 =APRON_LR_LENGTH)

// ============================================
// Top boards - length runs in the depth direction (DEPTH)
// 5 boards of 89mm cover WIDTH: 5*89 = 445mm, leaving 4 gaps of
// (WIDTH - 5*89) / 4 = 13.75mm
// ============================================
TOP_GAP = (WIDTH - 5 * 89) / 4
(top_1:2x4 =DEPTH)
(top_2:2x4 =DEPTH)
(top_3:2x4 =DEPTH)
(top_4:2x4 =DEPTH)
(top_5:2x4 =DEPTH)

// ============================================
// Front apron to legs (flush with the leg tops)
// ============================================
leg_fl -[LB>0 DB>0 D(:8x30)]- apron_front
leg_fr -[RF>0 TF>0 D(:8x30)]- apron_front

// ============================================
// Back apron to legs
// ============================================
leg_bl -[LB>0 DB>0 D(:8x30)]- apron_back
leg_br -[RF>0 TF>0 D(:8x30)]- apron_back

// ============================================
// Left apron to legs (flush with the leg tops: LEG_LENGTH - 89 up the leg)
// Side aprons connect to the legs' front/back faces
// ============================================
SIDE_APRON_OFFSET = LEG_LENGTH - 89
leg_fl -[BR<SIDE_APRON_OFFSET DB<0 D(:8x30)]- apron_left
leg_bl -[FR<SIDE_APRON_OFFSET TB<0 D(:8x30)]- apron_left

// ============================================
// Right apron to legs
// ============================================
leg_fr -[BL<SIDE_APRON_OFFSET DF<0 D(:8x30)]- apron_right
leg_br -[FL<SIDE_APRON_OFFSET TF<0 D(:8x30)]- apron_right

// ============================================
// Top boards to frame
// End boards sit on the front/back legs
// Middle boards sit on the front apron, one gap + one board apart:
// offsets TOP_GAP, TOP_GAP + 89 + TOP_GAP, TOP_GAP + 2*(89 + TOP_GAP)
// ============================================
top_1 -[BD<0 TF<0 D(:8x30)]- leg_fl
apron_front -[RF<TOP_GAP BT<0 D(:8x30)]- top_2
apron_front -[RF<(TOP_GAP + 89 + TOP_GAP) BT<0 D(:8x30)]- top_3
apron_front -[RF<(TOP_GAP + 2 * (89 + TOP_GAP)) BT<0 D(:8x30)]- top_4
top_5 -[BD<0 TF<0 D(:8x30)]- leg_fr

// Assembly: the side frames, the aprons joining them, the top
steps {
  "Left frame":  leg_fl, leg_bl, apron_left
  "Right frame": leg_fr, leg_br, apron_right
  "Join":        apron_front, apron_back
  "Top":         top_1, top_2, top_3, top_4, top_5
}
