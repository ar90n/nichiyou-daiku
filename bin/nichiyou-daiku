#!/bin/sh
# The nichiyou-daiku CLI for the Claude Code plugin: an installed CLI if
# there is one, else this version's prebuilt CLI, downloaded once from the
# GitHub release into the cache, else one built from this plugin's source
# when cargo is there
set -eu

# Follow symlinks so a link to this script still finds the plugin root
real_path() {
  target=$1
  while [ -L "$target" ]; do
    link=$(readlink -- "$target")
    case $link in
      /*) target=$link ;;
      *) target=$(dirname -- "$target")/$link ;;
    esac
  done
  printf '%s/%s\n' "$(CDPATH='' cd -P -- "$(dirname -- "$target")" && pwd -P)" "$(basename -- "$target")"
}

self=$(real_path "$0")
root=$(dirname -- "$(dirname -- "$self")")

# Another copy of this script (a second plugin version on PATH) hands over
# with the flag set, so the copies never exec each other in a loop
if [ -z "${NICHIYOU_DAIKU_WRAPPED:-}" ]; then
  export NICHIYOU_DAIKU_WRAPPED=1
  set -f
  saved_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    # An empty entry means the current directory; never run a file from there
    [ -n "$dir" ] || continue
    candidate=$dir/nichiyou-daiku
    if [ -f "$candidate" ] && [ -x "$candidate" ] && [ "$(real_path "$candidate")" != "$self" ]; then
      IFS=$saved_ifs
      exec "$candidate" "$@"
    fi
  done
  IFS=$saved_ifs
  set +f
fi

releases_page=https://github.com/ar90n/nichiyou-daiku/releases

version=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version *= *"\(.*\)"/\1/p' "$root/Cargo.toml" | head -n 1)
if [ -z "$version" ]; then
  printf 'nichiyou-daiku: cannot read the version from %s; reinstall the plugin.\n' "$root/Cargo.toml" >&2
  exit 127
fi

system=$(uname -s)
machine=$(uname -m)
exe=
ext=tar.gz
case $system in
  Linux) os=unknown-linux-musl ;;
  Darwin) os=apple-darwin ;;
  MINGW* | MSYS* | CYGWIN*) os=pc-windows-msvc exe=.exe ext=zip ;;
  *) os= ;;
esac
case $machine in
  x86_64 | amd64) arch=x86_64 ;;
  aarch64 | arm64) arch=aarch64 ;;
  *) arch= ;;
esac

cache=${XDG_CACHE_HOME:-$HOME/.cache}/nichiyou-daiku/$version
binary=$cache/nichiyou-daiku$exe
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

fetch() {
  if command -v curl >/dev/null 2>&1; then
    # Quiet: the reason we give says what failed
    curl -fsL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    reason="neither curl nor wget is installed"
    return 1
  fi
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    return 1
  fi
}

# Moves a CLI into the cache whole: a run stopped halfway leaves no binary
place() {
  mkdir -p "$cache" &&
    cp "$1" "$binary.part.$$" &&
    chmod +x "$binary.part.$$" &&
    mv -f "$binary.part.$$" "$binary"
}

download() {
  if [ -z "$os" ] || [ -z "$arch" ]; then
    reason="no prebuilt nichiyou-daiku for $system $machine"
    return 1
  fi
  name=nichiyou-daiku-$version-$target.$ext
  base=${NICHIYOU_DAIKU_RELEASES:-$releases_page/download}/v$version
  reason="cannot fetch $base/$name"
  fetch "$base/$name" "$work/$name" || return 1
  reason="cannot fetch $base/SHA256SUMS"
  fetch "$base/SHA256SUMS" "$work/SHA256SUMS" || return 1
  want=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' "$work/SHA256SUMS")
  if ! got=$(sha256 "$work/$name"); then
    reason="neither sha256sum nor shasum is installed to check it"
    return 1
  fi
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    reason="its checksum does not match SHA256SUMS"
    return 1
  fi
  mkdir "$work/out"
  # set -e does not reach into a function called as an if's condition
  case $ext in
    zip) unzip -q "$work/$name" -d "$work/out" ;;
    *) tar -xzf "$work/$name" -C "$work/out" ;;
  esac || { reason="cannot unpack $name"; return 1; }
  place "$work/out/nichiyou-daiku$exe" || { reason="cannot put it in $cache"; return 1; }
  printf 'nichiyou-daiku: downloaded v%s for %s\n' "$version" "$target" >&2
}

target=$arch-$os
reason=
work=$(mktemp -d)
# exec skips the EXIT trap: the folder is removed before each exec too
trap 'rm -rf "$work"' EXIT
if download; then
  rm -rf "$work"
  exec "$binary" "$@"
fi
rm -rf "$work"
what="v$version for $target"
if [ -z "$os" ] || [ -z "$arch" ]; then
  what="v$version"
fi

if command -v cargo >/dev/null 2>&1; then
  printf 'nichiyou-daiku: could not download %s (%s); building it from source, which takes a few minutes\n' "$what" "$reason" >&2
  CARGO_TARGET_DIR=$cache/build cargo build --release --quiet -p nichiyou-daiku-cli --manifest-path "$root/Cargo.toml" >&2
  place "$cache/build/release/nichiyou-daiku$exe"
  exec "$binary" "$@"
fi

printf '%s\n' \
  "nichiyou-daiku: could not download $what ($reason), and cargo is not installed to build it." \
  "Download the CLI for your system from $releases_page/tag/v$version and put it on PATH," \
  "or install Rust (https://rustup.rs) and run the command again." >&2
exit 127
